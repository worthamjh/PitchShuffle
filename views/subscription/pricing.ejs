<%- layout('layouts/boilerplate') %>

<%
    const sub      = user.subscription || {};
    const status   = sub.status || 'none';
    const isActive = user.isActive();

    const trialEnd    = sub.trialEndsAt       ? new Date(sub.trialEndsAt)       : null;
    const periodEnd   = sub.currentPeriodEnds ? new Date(sub.currentPeriodEnds) : null;
    const seasonEnd   = sub.seasonEndsAt      ? new Date(sub.seasonEndsAt)      : null;
    const onSeason    = seasonEnd && seasonEnd > new Date();

    const daysLeft = trialEnd
        ? Math.max(0, Math.ceil((trialEnd - new Date()) / (1000 * 60 * 60 * 24)))
        : null;

    const seasonDaysLeft = seasonEnd
        ? Math.max(0, Math.ceil((seasonEnd - new Date()) / (1000 * 60 * 60 * 24)))
        : null;
%>

<div class="container py-4" style="max-width: 520px;">

    <div class="text-center mb-4">
        <div style="font-size:2.5rem;">⚾</div>
        <h1 class="fw-bold mt-2">PitchShuffle</h1>
        <p class="text-muted">Call pitches fast. Keep your catcher in sync.</p>
    </div>

    <!-- Status banner -->
    <% if (onSeason) { %>
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-calendar-check-fill fs-5 flex-shrink-0"></i>
            <div>
                <strong>Season Pass active</strong> —
                <%= seasonDaysLeft %> day<%= seasonDaysLeft !== 1 ? 's' : '' %> remaining
                <span class="text-muted small">(expires <%= seasonEnd.toLocaleDateString() %>)</span>
            </div>
        </div>
    <% } else if (status === 'trialing' && isActive) { %>
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-hourglass-split fs-5 flex-shrink-0"></i>
            <div>
                <strong>Free trial active</strong> —
                <%= daysLeft %> day<%= daysLeft !== 1 ? 's' : '' %> remaining
                <% if (trialEnd) { %><span class="text-muted small">(ends <%= trialEnd.toLocaleDateString() %>)</span><% } %>
            </div>
        </div>
    <% } else if (status === 'active') { %>
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
            <div>
                <strong>Subscription active</strong>
                <% if (periodEnd) { %>— renews <%= periodEnd.toLocaleDateString() %><% } %>
            </div>
        </div>
    <% } else if (status === 'past_due') { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <div><strong>Payment failed</strong> — update your payment method to keep access.</div>
        </div>
    <% } else if (status === 'cancelled') { %>
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-x-circle-fill fs-5 flex-shrink-0"></i>
            <div>
                <strong>Subscription cancelled</strong>
                <% if (periodEnd && periodEnd > new Date()) { %>
                    — access continues until <%= periodEnd.toLocaleDateString() %>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- Features list -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Everything included in every plan</h5>
            <ul class="list-unstyled mb-0">
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Up to 5 teams &amp; full rosters</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>4 strike zone layouts</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Voice pitch calls via Bluetooth earpiece</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Shuffle — randomized pitch calling</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Team color themes</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Baseball &amp; softball support</li>
            </ul>
        </div>
    </div>

    <!-- ===================================================================
         WEB-ONLY PRICING / CHECKOUT BLOCK (Stripe)
         Hidden on iOS (Capacitor native) and replaced with the native
         In-App Purchase block below (#ps-native-iap-pricing), per Apple
         Guideline 3.1.1 — paid content/subscriptions offered in the app
         must be purchasable via In-App Purchase, not an external payment
         flow like Stripe Checkout. The portal / "Manage Subscription"
         buttons further down stay visible on iOS since they don't
         initiate a new purchase (they just open Stripe's customer portal
         for users who originally subscribed on the web).
         =================================================================== -->
    <div id="ps-web-only-pricing">

    <!-- Pricing tiers -->
    <% if (true) { %>

        <!-- Monthly -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h5 class="fw-bold mb-0">Monthly</h5>
                    <span class="fs-4 fw-bold">$7.99<span class="text-muted fs-6 fw-normal">/mo</span></span>
                </div>
                <p class="text-muted small mb-3">Includes 7-day free trial. Cancel anytime.</p>
                <% if (!isActive || status === 'cancelled' || status === 'past_due') { %>
                <form action="/subscription/checkout" method="POST" class="js-stripe-form">
                    <input type="hidden" name="plan" value="monthly">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-play-fill me-1"></i>
                        <span class="btn-label"><%= status === 'none' ? 'Start Free Trial' : 'Subscribe Monthly' %></span>
                    </button>
                </form>
                <% } else { %>
                <button class="btn btn-outline-secondary w-100 fw-bold" disabled>
                    <i class="bi bi-check-circle me-1"></i> Current or Available Plan
                </button>
                <% } %>
            </div>
        </div>

        <!-- Season Pass -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div>
                        <h5 class="fw-bold mb-0">Season Pass</h5>
                        <span class="badge bg-info text-dark">90 days</span>
                    </div>
                    <span class="fs-4 fw-bold">$14.99<span class="text-muted fs-6 fw-normal"> once</span></span>
                </div>
                <p class="text-muted small mb-3">One-time payment. Perfect for a single season.</p>
                <% if (!isActive || status === 'cancelled' || status === 'past_due') { %>
                <form action="/subscription/checkout" method="POST" class="js-stripe-form">
                    <input type="hidden" name="plan" value="season">
                    <button type="submit" class="btn btn-outline-primary w-100 fw-bold">
                        <i class="bi bi-calendar-check me-1"></i> <span class="btn-label">Get Season Pass</span>
                    </button>
                </form>
                <% } else { %>
                <button class="btn btn-outline-secondary w-100 fw-bold" disabled>
                    <i class="bi bi-check-circle me-1"></i> Currently Available
                </button>
                <% } %>
            </div>
        </div>

        <!-- Annual -->
        <div class="card border-2 shadow-sm mb-4" style="border-color: var(--ps-navy) !important;">
            <div class="card-header fw-bold text-center py-1" style="background: var(--ps-navy); color: var(--accent-text);">
                Best Value — Save over 45%
            </div>
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h5 class="fw-bold mb-0">Annual</h5>
                    <span class="fs-4 fw-bold">$49.99<span class="text-muted fs-6 fw-normal">/yr</span></span>
                </div>
                <p class="text-muted small mb-3">Includes 7-day free trial. Only $4.17/month.</p>
                <% if (!isActive || status === 'cancelled' || status === 'past_due') { %>
                <form action="/subscription/checkout" method="POST" class="js-stripe-form">
                    <input type="hidden" name="plan" value="annual">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-play-fill me-1"></i>
                        <span class="btn-label"><%= status === 'none' ? 'Start Free Trial' : 'Subscribe Annually' %></span>
                    </button>
                </form>
                <% } else { %>
                <button class="btn btn-outline-secondary w-100 fw-bold" disabled>
                    <i class="bi bi-check-circle me-1"></i> Currently Available
                </button>
                <% } %>
            </div>
        </div>

    <% } else if (status === 'trialing' && isActive) { %>
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-1">Add Payment Method</h5>
                <p class="text-muted small mb-3">Add a card now so your access continues after your trial ends.</p>
                <form action="/subscription/checkout" method="POST" class="js-stripe-form">
                    <input type="hidden" name="plan" value="monthly">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-credit-card me-1"></i> <span class="btn-label">Add Payment Method</span>
                    </button>
                </form>
            </div>
        </div>
    <% } %>

    </div>
    <!-- ============== END WEB-ONLY PRICING / CHECKOUT BLOCK ============== -->

    <!-- ===================================================================
         NATIVE IN-APP PURCHASE BLOCK (RevenueCat / StoreKit)
         Hidden on web, shown on iOS in place of the Stripe block above.
         Prices are intentionally NOT hardcoded here — they're filled in
         from the actual StoreKit product data returned by
         Purchases.getOfferings(), since Apple requires displaying the
         real, localized App Store price rather than an assumed USD
         figure. Package identifiers are expected to be "monthly",
         "annual", and "season" in the RevenueCat "default" offering,
         matching the plan names used by the Stripe side above.
         =================================================================== -->
    <div class="d-none" id="ps-native-iap-pricing">

        <div class="text-center text-muted small mb-3 d-none" id="ps-iap-loading">
            <div class="spinner-border spinner-border-sm me-1" role="status"></div>
            Loading plans…
        </div>

        <div class="alert alert-warning d-none" id="ps-iap-load-error">
            Couldn't load plans right now. Please check your connection and try again.
        </div>

        <div id="ps-iap-plans"></div>

        <div class="d-grid mb-4">
            <button type="button" class="btn btn-outline-secondary" id="ps-iap-restore">
                <i class="bi bi-arrow-clockwise me-1"></i> Restore Purchases
            </button>
        </div>

        <p class="text-center text-muted small">
            Payment will be charged to your Apple ID account. Subscriptions renew
            automatically unless cancelled at least 24 hours before the end of the
            current period. Manage or cancel anytime in your device's
            Settings &gt; Apple ID &gt; Subscriptions.
        </p>
    </div>

    <!-- Manage / Portal actions — these don't start a new purchase, so they
         stay visible on iOS for users who already have an active or trialing
         subscription. -->
    <% if (status === 'trialing' && isActive) { %>
        <form action="/subscription/portal" method="POST" class="js-stripe-form">
            <button type="submit" class="btn btn-outline-secondary w-100 py-2 fw-bold mb-4">
                <i class="bi bi-gear me-1"></i> <span class="btn-label">Manage Subscription</span>
            </button>
        </form>

    <% } else if (status === 'active') { %>
        <form action="/subscription/portal" method="POST" class="js-stripe-form">
            <button type="submit" class="btn btn-outline-secondary w-100 py-2 fw-bold mb-4">
                <i class="bi bi-gear me-1"></i> <span class="btn-label">Manage Subscription</span>
            </button>
        </form>

    <% } else if (status === 'past_due') { %>
        <form action="/subscription/portal" method="POST" class="js-stripe-form">
            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold mb-4">
                <i class="bi bi-credit-card me-1"></i> <span class="btn-label">Update Payment Method</span>
            </button>
        </form>
    <% } %>

    <p class="text-center text-muted small" id="ps-secured-by-stripe">
        <i class="bi bi-lock-fill me-1"></i> Secured by <strong>Stripe</strong>. We never store your card details.
    </p>

</div>

<script>
    // Capacitor automatically injects a global `Capacitor` object on native
    // platforms (iOS/Android) — no import or bundler needed. On the regular
    // website this object simply won't exist, and we fall back to normal
    // navigation. Capacitor.Plugins.Browser requires @capacitor/browser to
    // be installed (npm install @capacitor/browser) and synced into the iOS
    // project (npx cap sync ios) before this will work natively.
    var isNative         = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
    var CapacitorBrowser = (isNative && window.Capacitor.Plugins && window.Capacitor.Plugins.Browser) ? window.Capacitor.Plugins.Browser : null;

    // Apple Guideline 3.1.1: paid content in the app must be purchasable
    // via In-App Purchase. Hide the Stripe pricing/checkout block and its
    // footer, and show the native RevenueCat/StoreKit purchase block
    // instead. Portal/manage buttons (further below) are left alone —
    // they don't start a new purchase.
    if (isNative) {
        var pricingBlock  = document.getElementById('ps-web-only-pricing');
        var stripeFooter  = document.getElementById('ps-secured-by-stripe');
        var iapBlock      = document.getElementById('ps-native-iap-pricing');

        if (pricingBlock) pricingBlock.remove();
        if (stripeFooter) stripeFooter.remove();
        if (iapBlock) iapBlock.classList.remove('d-none');

        initNativeIAP();
    }

    // ── Native In-App Purchase (RevenueCat) ─────────────────────────────
    function initNativeIAP() {
        var Purchases = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Purchases;
        var plansEl    = document.getElementById('ps-iap-plans');
        var loadingEl  = document.getElementById('ps-iap-loading');
        var errorEl    = document.getElementById('ps-iap-load-error');
        var restoreBtn = document.getElementById('ps-iap-restore');

        // Display copy only — the actual price shown to the user comes
        // from StoreKit via the offering package below, never from here.
        var PLAN_META = {
            monthly: { title: 'Monthly',     badge: null,      note: 'Includes 7-day free trial. Cancel anytime.',            suffix: '/mo' },
            season:  { title: 'Season Pass', badge: '90 days', note: 'One-time payment. Perfect for a single season.',        suffix: ' once' },
            annual:  { title: 'Annual',      badge: null,      note: 'Includes 7-day free trial. Best value.',                suffix: '/yr' },
        };
        var PLAN_ORDER = ['monthly', 'season', 'annual'];

        function renderError() {
            if (loadingEl) loadingEl.classList.add('d-none');
            if (errorEl) errorEl.classList.remove('d-none');
        }

        function renderPlans(packagesById) {
            if (loadingEl) loadingEl.classList.add('d-none');
            if (!plansEl) return;
            plansEl.innerHTML = '';

            PLAN_ORDER.forEach(function (planId) {
                var pkg  = packagesById[planId];
                var meta = PLAN_META[planId];
                if (!pkg || !meta) return; // skip plans not configured in RevenueCat yet

                var price = pkg.product && pkg.product.priceString ? pkg.product.priceString : '—';

                var card = document.createElement('div');
                card.className = 'card border-0 shadow-sm mb-3';
                card.innerHTML =
                    '<div class="card-body p-4">' +
                        '<div class="d-flex justify-content-between align-items-center mb-1">' +
                            '<div>' +
                                '<h5 class="fw-bold mb-0">' + meta.title + '</h5>' +
                                (meta.badge ? '<span class="badge bg-info text-dark">' + meta.badge + '</span>' : '') +
                            '</div>' +
                            '<span class="fs-4 fw-bold">' + price + '<span class="text-muted fs-6 fw-normal">' + meta.suffix + '</span></span>' +
                        '</div>' +
                        '<p class="text-muted small mb-3">' + meta.note + '</p>' +
                        '<button type="button" class="btn btn-primary w-100 fw-bold js-iap-buy" data-plan="' + planId + '">' +
                            '<i class="bi bi-play-fill me-1"></i> <span class="btn-label">Subscribe</span>' +
                        '</button>' +
                    '</div>';
                plansEl.appendChild(card);

                card.querySelector('.js-iap-buy').addEventListener('click', function () {
                    buyPackage(pkg, this);
                });
            });
        }

        function buyPackage(pkg, btn) {
            var labelEl = btn.querySelector('.btn-label');
            var originalLabel = labelEl ? labelEl.textContent : null;
            btn.disabled = true;
            if (labelEl) labelEl.textContent = 'Processing…';

            Purchases.purchasePackage({ aPackage: pkg })
                .then(function () {
                    // Authoritative access state is synced server-side via
                    // the RevenueCat webhook, which normally arrives within
                    // a second or two. Reload so the page picks up the
                    // updated subscription status once it lands.
                    if (labelEl) labelEl.textContent = 'Success!';
                    setTimeout(function () { window.location.reload(); }, 1500);
                })
                .catch(function (err) {
                    btn.disabled = false;
                    if (labelEl && originalLabel) labelEl.textContent = originalLabel;
                    // RevenueCat reports user-initiated cancellation as an
                    // error too — don't show a scary alert for that case.
                    if (!err || !err.userCancelled) {
                        alert((err && err.message) || 'Purchase failed. Please try again.');
                    }
                });
        }

        if (restoreBtn) {
            restoreBtn.addEventListener('click', function () {
                var labelText = restoreBtn.textContent;
                restoreBtn.disabled = true;
                restoreBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Restoring…';
                Purchases.restorePurchases()
                    .then(function () { window.location.reload(); })
                    .catch(function (err) {
                        restoreBtn.disabled = false;
                        restoreBtn.textContent = labelText;
                        alert((err && err.message) || 'Restore failed. Please try again.');
                    });
            });
        }

        if (!Purchases) {
            renderError();
            return;
        }

        if (loadingEl) loadingEl.classList.remove('d-none');

        // The layout kicks off Purchases.configure() earlier on this same
        // page load, but that's an async native bridge call -- calling
        // getOfferings() before it resolves can silently return an empty
        // offering instead of throwing. Wait for the layout's readiness
        // promise (if present) before asking for offerings.
        var ready = window.__psRevenueCatReady || Promise.resolve();

        ready
            .then(function () { return Purchases.getOfferings(); })
            .then(function (result) {
                // This SDK version resolves getOfferings() to { all, current }
                // directly -- not wrapped in an "offerings" property like some
                // versions/docs suggest. Support both shapes defensively, and
                // fall back to all.default if current isn't populated (it's
                // correctly configured as the account's current offering in
                // the RevenueCat dashboard, so this should always have data).
                var offerings = (result && result.offerings) || result;
                var current = (offerings && offerings.current)
                    || (offerings && offerings.all && offerings.all['default'])
                    || null;
                var available = (current && current.availablePackages) || [];
                var packagesById = {};
                available.forEach(function (pkg) {
                    if (pkg && pkg.identifier) packagesById[pkg.identifier] = pkg;
                });
                renderPlans(packagesById);
            })
            .catch(function (err) {
                console.error('RevenueCat getOfferings failed:', err);
                renderError();
            });
    }

    document.querySelectorAll('.js-stripe-form').forEach(function (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const btn      = form.querySelector('button[type="submit"]');
            const labelEl   = btn.querySelector('.btn-label');
            const originalLabel = labelEl ? labelEl.textContent : null;

            btn.disabled = true;
            if (labelEl) labelEl.textContent = 'Loading…';

            try {
                const formData = new FormData(form);
                const body = new URLSearchParams();
                for (const [key, value] of formData.entries()) body.append(key, value);

                const res = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    alert(err.error || 'Something went wrong. Please try again.');
                    btn.disabled = false;
                    if (labelEl && originalLabel) labelEl.textContent = originalLabel;
                    return;
                }

                const data = await res.json();
                if (!data.url) throw new Error('No checkout URL returned.');

                if (isNative && CapacitorBrowser) {
                    await CapacitorBrowser.open({ url: data.url });
                    // Re-enable the button once the in-app browser closes,
                    // in case the user comes back without completing checkout.
                    btn.disabled = false;
                    if (labelEl && originalLabel) labelEl.textContent = originalLabel;
                } else {
                    // Regular website (or Capacitor plugin unavailable) — normal navigation.
                    window.location.href = data.url;
                }
            } catch (err) {
                console.error('Stripe checkout error:', err);
                alert('Something went wrong. Please try again.');
                btn.disabled = false;
                if (labelEl && originalLabel) labelEl.textContent = originalLabel;
            }
        });
    });
</script>
