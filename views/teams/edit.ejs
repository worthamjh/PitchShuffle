<%- layout('layouts/boilerplate') %>

<div class="page-header">
    <h1><i class="bi bi-pencil"></i> Edit Team</h1>
</div>

<div class="card">
    <div class="card-body p-4">
        <form action="/teams/<%= team._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

            <div class="mb-4">
                <label for="name" class="form-label fw-bold">Team Name</label>
                <input type="text" class="form-control form-control-lg" id="name" name="team[name]"
                    value="<%= team.name %>" required>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Sport</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="team[sport]" id="sportBaseball"
                            value="baseball" <%= (!team.sport || team.sport === 'baseball') ? 'checked' : '' %>>
                        <label class="form-check-label" for="sportBaseball">
                            ⚾ Baseball
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="team[sport]" id="sportSoftball"
                            value="softball" <%= team.sport === 'softball' ? 'checked' : '' %>>
                        <label class="form-check-label" for="sportSoftball">
                            🥎 Softball
                        </label>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Team Logo</label>
                <% if (team.logo) { %>
                    <div class="mb-2 d-flex align-items-center gap-3">
                        <img src="<%= team.logo %>" alt="Current logo"
                             style="width:60px;height:60px;border-radius:10px;object-fit:cover;border:2px solid var(--ps-navy);">
                        <div>
                            <div class="text-muted small mb-1">Current logo — upload a new one to replace it</div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="removeLogo" name="team[removeLogo]" value="true">
                                <label class="form-check-label text-danger small" for="removeLogo">
                                    <i class="bi bi-trash"></i> Remove logo
                                </label>
                            </div>
                        </div>
                    </div>
                <% } %>
                <input type="file" class="form-control" id="logo" name="logo" accept="image/*">
                <div class="form-text">Max 5MB. Leave blank to keep the current logo.</div>
            </div>

            <!-- Team Colors -->
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                    <label class="form-label fw-bold mb-0">Team Colors</label>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="restoreDefaultColors">
                        <i class="bi bi-arrow-counterclockwise"></i> Restore Defaults
                    </button>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label for="primaryColor" class="form-label">Primary Color</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" class="form-control form-control-color" id="primaryColor"
                                   name="team[primaryColor]"
                                   value="<%= team.primaryColor || '#1a2e4a' %>">
                            <small class="text-muted">Navbar, headers, buttons</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label for="secondaryColor" class="form-label">Secondary Color</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" class="form-control form-control-color" id="secondaryColor"
                                   name="team[secondaryColor]"
                                   value="<%= team.secondaryColor || '#4a7fa5' %>">
                            <small class="text-muted">Pitcher badge circles</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label for="strikeColor" class="form-label">Strike Zone Color</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" class="form-control form-control-color" id="strikeColor"
                                   name="team[strikeColor]"
                                   value="<%= team.strikeColor || '#c8ecd4' %>">
                            <small class="text-muted">Strike zone cells</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label for="chaseColor" class="form-label">Chase Zone Color</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" class="form-control form-control-color" id="chaseColor"
                                   name="team[chaseColor]"
                                   value="<%= team.chaseColor || '#fef3cd' %>">
                            <small class="text-muted">Chase zone cells</small>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ── Shuffle Defaults ───────────────────────────────────── -->
            <div class="mb-4 mt-2">
                <hr>
                <h5 class="fw-bold mb-1"><i class="bi bi-shuffle"></i> Shuffle Defaults for This Team</h5>
                <p class="text-muted small mb-3">Bulk-update shuffle settings for all pitchers on this team.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#shuffleBulkModal">
                        <i class="bi bi-sliders"></i> Set Strike % for All Pitchers
                    </button>
                    <form action="/teams/<%= team._id %>/shuffle-reset" method="POST" style="margin:0;">
                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                onclick="return confirm('Reset all pitchers on this team to equal pitch type weights?')">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset Pitch Weights for All Pitchers
                        </button>
                    </form>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check-circle"></i> Save Changes
                </button>
                <a href="/teams/<%= team._id %>" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>

        </form>
        <script>
            const primaryColor   = document.getElementById('primaryColor');
            const secondaryColor = document.getElementById('secondaryColor');
            const strikeColor    = document.getElementById('strikeColor');
            const chaseColor     = document.getElementById('chaseColor');

            const DEFAULTS = {
                primary:   '#1a2e4a',
                secondary: '#4a7fa5',
                strike:    '#c8ecd4',
                chase:     '#fef3cd'
            };

            document.getElementById('restoreDefaultColors').addEventListener('click', () => {
                primaryColor.value   = DEFAULTS.primary;
                secondaryColor.value = DEFAULTS.secondary;
                strikeColor.value    = DEFAULTS.strike;
                chaseColor.value     = DEFAULTS.chase;
                checkColors();
            });

            const removeLogoCheckbox = document.getElementById('removeLogo');
            const logoInput          = document.getElementById('logo');
            if (removeLogoCheckbox) {
                removeLogoCheckbox.addEventListener('change', () => {
                    logoInput.disabled = removeLogoCheckbox.checked;
                    if (removeLogoCheckbox.checked) logoInput.value = '';
                });
            }

            const navWarning = document.createElement('div');
            navWarning.className = 'alert alert-warning py-2 px-3 mt-2 mb-0 small';
            navWarning.style.display = 'none';
            navWarning.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Primary and secondary colors are the same — pitcher badges won\'t be visible.';
            secondaryColor.closest('.col-sm-6').appendChild(navWarning);

            const zoneWarning = document.createElement('div');
            zoneWarning.className = 'alert alert-warning py-2 px-3 mt-2 mb-0 small';
            zoneWarning.style.display = 'none';
            zoneWarning.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Strike and chase zone colors are the same — they won\'t be distinguishable.';
            chaseColor.closest('.col-sm-6').appendChild(zoneWarning);

            function checkColors() {
                navWarning.style.display  = primaryColor.value === secondaryColor.value ? '' : 'none';
                zoneWarning.style.display = strikeColor.value  === chaseColor.value     ? '' : 'none';
            }

            [primaryColor, secondaryColor, strikeColor, chaseColor].forEach(el =>
                el.addEventListener('input', checkColors)
            );

            checkColors();
        </script>
    </div>
    <!-- Shuffle Bulk Strike % Modal -->
<div class="modal fade" id="shuffleBulkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-shuffle me-2"></i>Set Strike % for All Pitchers</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="text-muted small mb-3">This will override the strike/chase split for every pitcher on this team.</p>
                <form action="/teams/<%= team._id %>/shuffle-strike" method="POST" id="shuffleBulkForm">
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-success fw-bold" style="min-width:80px;">Strike: <span id="bulkStrikeLbl"><%= currentUser && currentUser.preferences && currentUser.preferences.strikeChancePct != null ? currentUser.preferences.strikeChancePct : 70 %></span>%</span>
                        <input type="range" class="form-range flex-grow-1" min="0" max="100" step="5"
                               id="bulkStrikeSlider" name="strikeChancePct" value="<%= currentUser && currentUser.preferences && currentUser.preferences.strikeChancePct != null ? currentUser.preferences.strikeChancePct : 70 %>">
                        <span class="text-warning fw-bold" style="min-width:80px;">Chase: <span id="bulkChaseLbl"><%= 100 - (currentUser && currentUser.preferences && currentUser.preferences.strikeChancePct != null ? currentUser.preferences.strikeChancePct : 70) %></span>%</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="bulkStrikeSubmit">
                    <i class="bi bi-check-circle me-1"></i> Apply to All Pitchers
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('bulkStrikeSlider').addEventListener('input', function () {
    document.getElementById('bulkStrikeLbl').textContent = this.value;
    document.getElementById('bulkChaseLbl').textContent  = 100 - this.value;
});
document.getElementById('bulkStrikeSubmit').addEventListener('click', () => {
    document.getElementById('shuffleBulkForm').submit();
});
</script>
</div>
