<%- layout('layouts/boilerplate') %>

<style>
    .team-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: #fff;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        user-select: none;
    }
    .team-card:hover {
        border-color: #8fa8c8;
        box-shadow: 0 0 0 3px rgba(26,46,74,0.08);
        background: #f8fafc;
        color: inherit;
        text-decoration: none;
    }
    .team-icon {
        width: 52px; height: 52px; border-radius: 10px;
        background: #f0f0f0; color: #8fa8c8; font-size: 1.3rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; overflow: hidden;
    }
    .team-icon img { width: 52px; height: 52px; object-fit: contain; }
    .team-info { flex: 1; }
    .team-name { font-size: 1.05rem; font-weight: 700; color: #1a2e4a; margin-bottom: 2px; }
    .team-meta { font-size: 0.82rem; color: #6c757d; }
    .team-chevron { color: #adb5bd; font-size: 1.1rem; }
    .sort-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .sort-bar span { font-size: 0.8rem; color: #6c757d; font-weight: 600; }
    .sort-btn {
        font-size: 0.78rem;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.15s;
        font-weight: 600;
    }
    .sort-btn:hover  { border-color: #8fa8c8; color: #1a2e4a; }
    .sort-btn.active { background: var(--ps-navy, #1a2e4a); border-color: var(--ps-navy, #1a2e4a); color: #fff; }
</style>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-people-fill"></i> My Teams</h1>
    <% if (teams.length < teamLimit) { %>
        <a href="/teams/new" class="btn btn-outline-light">
            <i class="bi bi-plus-circle"></i> New Team
        </a>
    <% } else { %>
        <span class="btn btn-outline-light disabled opacity-50" title="Maximum of <%= teamLimit %> teams reached">
            <i class="bi bi-slash-circle"></i> Team limit reached
        </span>
    <% } %>
</div>

<% if (teams.length >= teamLimit) { %>
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
        <span>You've reached the maximum of <%= teamLimit %> teams. Delete a team to create a new one.</span>
    </div>
<% } %>

<% if (teams.length === 0) { %>
    <div class="card">
        <div class="card-body text-center p-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No teams yet</h4>
            <p class="text-muted">Get started by creating your first team</p>
            <a href="/teams/new" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create a Team
            </a>
        </div>
    </div>
<% } else { %>

    <!-- Sort bar -->
    <div class="sort-bar">
        <span>Sort:</span>
        <button class="sort-btn" data-sort="name">A–Z</button>
        <button class="sort-btn" data-sort="newest">Newest</button>
        <button class="sort-btn" data-sort="oldest">Oldest</button>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-3" id="teamGrid">
        <% for (let team of teams) { %>
            <div class="col team-col"
                 data-name="<%= team.name.toLowerCase() %>"
                 data-created="<%= team._id.getTimestamp().getTime() %>">
                <a href="/teams/<%= team._id %>" class="team-card">
                    <div class="team-icon">
                        <% if (team.logo) { %>
                            <img src="<%= team.logo %>" alt="<%= team.name %>">
                        <% } else { %>
                            <i class="bi bi-shield-fill"></i>
                        <% } %>
                    </div>
                    <div class="team-info">
                        <div class="team-name"><%= team.name %></div>
                        <div class="team-meta">
                            <%= team.sport === 'softball' ? '🥎' : '⚾' %>
                            <%= team.sport === 'softball' ? 'Softball' : 'Baseball' %>
                            &middot;
                            <i class="bi bi-person-fill"></i>
                            <%= team.pitchers.length %> pitcher<%= team.pitchers.length !== 1 ? 's' : '' %>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right team-chevron"></i>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
(function () {
    const SORT_KEY = 'ps_team_sort';
    const grid     = document.getElementById('teamGrid');
    const btns     = document.querySelectorAll('.sort-btn');
    if (!grid) return;

    function applySort(mode) {
        localStorage.setItem(SORT_KEY, mode);
        btns.forEach(b => b.classList.toggle('active', b.dataset.sort === mode));
        const cols = [...grid.querySelectorAll('.team-col')];
        cols.sort((a, b) => {
            if (mode === 'name')   return a.dataset.name.localeCompare(b.dataset.name);
            if (mode === 'newest') return Number(b.dataset.created) - Number(a.dataset.created);
            if (mode === 'oldest') return Number(a.dataset.created) - Number(b.dataset.created);
        });
        cols.forEach(col => grid.appendChild(col));
    }

    btns.forEach(btn => btn.addEventListener('click', () => applySort(btn.dataset.sort)));
    applySort(localStorage.getItem(SORT_KEY) || 'newest');
}());
</script>
