<%- layout('layouts/boilerplate') %>

<style>
    .pitcher-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: #fff;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        user-select: none;
    }
    .pitcher-card:hover {
        border-color: #8fa8c8;
        box-shadow: 0 0 0 3px rgba(26,46,74,0.08);
        background: #f8fafc;
        color: inherit;
        text-decoration: none;
    }
    .pitcher-number {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--ps-secondary, #1a2e4a);
        color: var(--ps-secondary-text, #fff);
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .pitcher-info { flex: 1; }
    .pitcher-name { font-size: 1.05rem; font-weight: 700; color: #1a2e4a; margin-bottom: 2px; }
    .pitcher-meta { font-size: 0.82rem; color: #6c757d; }
    .pitcher-chevron { color: #adb5bd; font-size: 1.1rem; }

    .team-logo-header {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        object-fit: contain;
        background: rgba(255,255,255,0.15);
        padding: 2px;
        flex-shrink: 0;
    }
    .sort-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .sort-bar span {
        font-size: 0.8rem;
        color: #6c757d;
        font-weight: 600;
    }
    .sort-btn {
        font-size: 0.78rem;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.15s;
        font-weight: 600;
    }
    .sort-btn:hover { border-color: #8fa8c8; color: #1a2e4a; }
    .sort-btn.active { background: var(--ps-navy, #1a2e4a); border-color: var(--ps-navy, #1a2e4a); color: #fff; }

    /* Column-major (top→bottom) two-column layout */
    .pitcher-col-list { column-count: 1; column-gap: 0.75rem; }
    @media (min-width: 540px) { .pitcher-col-list { column-count: 2; } }
    .pitcher-col { break-inside: avoid; display: inline-block; width: 100%; margin-bottom: 0.75rem; }
</style>

<div class="page-header">
    <h1 class="d-flex align-items-center gap-2 mb-2">
        <% if (team.logo) { %>
            <img src="<%= team.logo %>" alt="" class="team-logo-header">
        <% } else { %>
            <i class="bi bi-shield-fill"></i>
        <% } %>
        <%= team.name %>
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/teams/<%= team._id %>/edit" class="btn btn-outline-light btn-sm">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <% if (team.pitchers.length >= 20) { %>
            <button class="btn btn-outline-light btn-sm" disabled title="Maximum 20 pitchers reached">
                <i class="bi bi-slash-circle"></i> Roster Full
            </button>
        <% } else { %>
            <a href="/teams/<%= team._id %>/pitchers/new" class="btn btn-outline-light btn-sm">
                <i class="bi bi-plus-circle"></i> Add Pitcher
            </a>
        <% } %>
        <button type="button" class="btn btn-delete-adaptive btn-sm" data-bs-toggle="modal" data-bs-target="#deleteTeamModal">
            <i class="bi bi-trash"></i> Delete
        </button>
    </div>
</div>

<div class="modal fade" id="deleteTeamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:var(--ps-navy);color:var(--accent-text,#fff);border:none;">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Team
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Are you sure you want to delete <strong><%= team.name %></strong>?</p>
                <p class="text-muted small mb-0">This will permanently remove the team and all <%= team.pitchers.length %> pitcher<%= team.pitchers.length !== 1 ? 's' : '' %> on it. This cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form action="/teams/<%= team._id %>?_method=DELETE" method="POST" style="margin:0;">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Yes, Delete Team
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<% if (team.pitchers.length === 0) { %>
    <div class="card">
        <div class="card-body text-center p-5">
            <i class="bi bi-person-fill display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No pitchers yet</h4>
            <p class="text-muted">Add your first pitcher to get started</p>
            <% if (team.pitchers.length < 20) { %>
                <a href="/teams/<%= team._id %>/pitchers/new" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add Pitcher
                </a>
            <% } %>
        </div>
    </div>
<% } else { %>
    <!-- Sort bar -->
    <div class="sort-bar">
        <span>Sort:</span>
        <button class="sort-btn" data-sort="lastName">Last Name</button>
        <button class="sort-btn" data-sort="firstName">First Name</button>
        <button class="sort-btn" data-sort="number">Number</button>
        <span class="ms-auto text-muted" style="font-size:0.78rem;"><%= team.pitchers.length %>/20 pitchers</span>
    </div>

    <div class="pitcher-col-list" id="pitcherGrid">
        <% for (let pitcher of team.pitchers) { %>
            <div class="pitcher-col"
                 data-lastname="<%= (pitcher.lastName || '').toLowerCase() %>"
                 data-firstname="<%= (pitcher.firstName || '').toLowerCase() %>"
                 data-number="<%= pitcher.number || 0 %>"
                 data-pitcherid="<%= pitcher._id %>">
                <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>" class="pitcher-card">
                    <div class="pitcher-number">#<%= pitcher.number %></div>
                    <div class="pitcher-info">
                        <div class="pitcher-name">
                            <%= pitcher.firstName ? pitcher.firstName + ' ' + pitcher.lastName : (pitcher.lastName || pitcher.name) %>
                        </div>
                        <div class="pitcher-meta">
                            <%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %>
                            &middot;
                            <%= pitcher.pitchTypes.length %> pitch type<%= pitcher.pitchTypes.length !== 1 ? 's' : '' %>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right pitcher-chevron"></i>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
(function () {
    const SORT_KEY = 'ps_pitcher_sort';
    const grid     = document.getElementById('pitcherGrid');
    const btns     = document.querySelectorAll('.sort-btn');
    if (!grid) return;

    function getSort() {
        return localStorage.getItem(SORT_KEY) || 'lastName';
    }

    function applySort(mode) {
        localStorage.setItem(SORT_KEY, mode);
        btns.forEach(b => b.classList.toggle('active', b.dataset.sort === mode));

        const cols = [...grid.querySelectorAll('.pitcher-col')];
        cols.sort((a, b) => {
            if (mode === 'number') {
                return Number(a.dataset.number) - Number(b.dataset.number);
            }
            const aVal = mode === 'lastName' ? a.dataset.lastname : a.dataset.firstname;
            const bVal = mode === 'lastName' ? b.dataset.lastname : b.dataset.firstname;
            return aVal.localeCompare(bVal);
        });

        // Re-append in sorted order
        cols.forEach(col => grid.appendChild(col));
    }

    btns.forEach(btn => {
        btn.addEventListener('click', () => applySort(btn.dataset.sort));
    });

    // Apply saved sort on load
    applySort(getSort());
}());
</script>