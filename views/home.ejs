<%- layout('layouts/boilerplate') %>

<div class="home-hero">
    <div class="app-icon"><img src="/images/pitchshuffle-logo-navy.svg" alt="PitchShuffle logo" style="width:72px;height:auto;"></div>
    <h1>PitchShuffle</h1>
    <p>Call pitches fast. Keep your catcher in sync.</p>

    <% if (!currentUser || !currentUser.preferences || currentUser.preferences.showQuickGame !== false) { %>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a href="/quick-game" class="btn-quick-game">
                <i class="bi bi-lightning-fill"></i> ⚾ Baseball
            </a>
            <a href="/quick-game?sport=softball" class="btn-quick-game">
                <i class="bi bi-lightning-fill"></i> 🥎 Softball
            </a>
        </div>
        <p class="quick-game-hint">Quick Game — jump straight in, no setup needed</p>
        <div class="or-divider">or</div>
    <% } %>

    <a href="/game" class="btn-new-game">
        <i class="bi bi-play-fill"></i> New Game
    </a>

    <div class="quick-links">
        <a href="/teams" class="quick-link-card">
            <i class="bi bi-people-fill"></i>
            My Teams
        </a>
        <a href="/profile" class="quick-link-card">
            <% if (currentUser && currentUser.avatar) { %>
                <img src="<%= currentUser.avatar %>" alt="Profile" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
            <% } else { %>
                <i class="bi bi-person-circle"></i>
            <% } %>
            Profile
        </a>
    </div>
</div>
