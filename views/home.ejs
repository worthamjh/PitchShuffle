<%- layout('layouts/boilerplate') %>

<style>
    .home-hero {
        text-align: center;
        padding: 2.5rem 1rem 2rem;
    }
    .home-hero .app-icon {
        font-size: 3.5rem;
        color: #1a2e4a;
        margin-bottom: 0.75rem;
    }
    .home-hero h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #1a2e4a;
        margin-bottom: 0.25rem;
    }
    .home-hero p {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 2rem;
    }
    .btn-new-game {
        background: #1a2e4a;
        color: #fff;
        font-size: 1.15rem;
        font-weight: 700;
        padding: 0.85rem 2.5rem;
        border-radius: 12px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        transition: background 0.15s, transform 0.1s;
        box-shadow: 0 4px 14px rgba(26,46,74,0.25);
    }
    .btn-new-game:hover {
        background: #243d5e;
        color: #fff;
        transform: translateY(-1px);
    }
    .btn-new-game i { font-size: 1.3rem; }

    .quick-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2.5rem;
    }
    .quick-link-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 1.25rem 0.75rem;
        background: #fff;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        text-decoration: none;
        color: #1a2e4a;
        font-weight: 600;
        font-size: 0.85rem;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .quick-link-card:hover {
        border-color: #1a2e4a;
        box-shadow: 0 0 0 3px rgba(26,46,74,0.1);
        color: #1a2e4a;
    }
    .quick-link-card i {
        font-size: 1.6rem;
        color: #1a2e4a;
    }
</style>

<div class="home-hero">
    <div class="app-icon"><i class="bi bi-bullseye"></i></div>
    <h1>PitchShuffle</h1>
    <p>Call pitches fast. Keep your catcher in sync.</p>
    <a href="/game" class="btn-new-game">
        <i class="bi bi-play-fill"></i> New Game
    </a>

    <div class="quick-links">
        <a href="/teams" class="quick-link-card">
            <i class="bi bi-people-fill"></i>
            My Teams
        </a>
        <a href="/profile" class="quick-link-card">
            <i class="bi bi-person-circle"></i>
            Profile
        </a>
    </div>
</div>
