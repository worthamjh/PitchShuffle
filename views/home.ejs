<%- layout('layouts/boilerplate') %>

<style>
    .home-hero {
        text-align: center;
        padding: 2.5rem 1rem 2rem;
    }
    .home-hero .app-icon {
        font-size: 3.5rem;
        color: #1a2e4a;
        margin-bottom: 0.75rem;
    }
    .home-hero h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #1a2e4a;
        margin-bottom: 0.25rem;
    }
    .home-hero p {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    /* Quick Game — primary CTA */
    .btn-quick-game {
        background: #1a2e4a;
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        padding: 1rem 2.5rem;
        border-radius: 14px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        transition: background 0.15s, transform 0.1s;
        box-shadow: 0 4px 16px rgba(26,46,74,0.28);
        width: 100%;
        justify-content: center;
    }
    .btn-quick-game:hover {
        background: #243d5e;
        color: #fff;
        transform: translateY(-1px);
        text-decoration: none;
    }
    .btn-quick-game i { font-size: 1.4rem; }

    .quick-game-hint {
        font-size: 0.8rem;
        color: #6c757d;
        margin-top: 0.5rem;
    }

    /* Divider */
    .or-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.75rem 0 1.5rem;
        color: #adb5bd;
        font-size: 0.85rem;
    }
    .or-divider::before,
    .or-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #dee2e6;
    }

    /* New Game — secondary */
    .btn-new-game {
        background: #fff;
        color: #1a2e4a;
        font-size: 1rem;
        font-weight: 700;
        padding: 0.8rem 2rem;
        border-radius: 12px;
        border: 2px solid #1a2e4a;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
        width: 100%;
        justify-content: center;
    }
    .btn-new-game:hover {
        background: #1a2e4a;
        color: #fff;
        text-decoration: none;
    }

    .quick-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 1.25rem;
    }
    .quick-link-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 1.25rem 0.75rem;
        background: #fff;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        text-decoration: none;
        color: #1a2e4a;
        font-weight: 600;
        font-size: 0.85rem;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .quick-link-card:hover {
        border-color: #1a2e4a;
        box-shadow: 0 0 0 3px rgba(26,46,74,0.1);
        color: #1a2e4a;
        text-decoration: none;
    }
    .quick-link-card i {
        font-size: 1.6rem;
        color: #1a2e4a;
    }
</style>

<div class="home-hero">
    <div class="app-icon"><i class="bi bi-bullseye"></i></div>
    <h1>PitchShuffle</h1>
    <p>Call pitches fast. Keep your catcher in sync.</p>

    <!-- Quick Game — jump straight in -->
    <a href="/quick-game" class="btn-quick-game">
        <i class="bi bi-lightning-fill"></i> Quick Game
    </a>
    <p class="quick-game-hint">Fastball, Curveball, Changeup, Slider — ready to go</p>

    <div class="or-divider">or</div>

    <!-- New Game — full team setup -->
    <a href="/game" class="btn-new-game">
        <i class="bi bi-play-fill"></i> New Game
    </a>

    <div class="quick-links">
        <a href="/teams" class="quick-link-card">
            <i class="bi bi-people-fill"></i>
            My Teams
        </a>
        <a href="/profile" class="quick-link-card">
            <i class="bi bi-person-circle"></i>
            Profile
        </a>
    </div>
</div>
