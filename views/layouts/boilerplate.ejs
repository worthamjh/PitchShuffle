<!DOCTYPE html>
<html lang="en" data-theme="<%= (currentUser && currentUser.preferences && currentUser.preferences.theme) ? currentUser.preferences.theme : 'light' %>">

<head>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/images/pitchshuffle-logo.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/pitchshuffle-logo-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/pitchshuffle-logo-16.png">
    <link rel="apple-touch-icon" href="/images/pitchshuffle-logo-192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/pitchshuffle-logo-180.png">
    <link rel="apple-touch-icon" sizes="167x167" href="/images/pitchshuffle-logo-167.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/pitchshuffle-logo-152.png">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="PitchShuffle">
    <meta name="theme-color" content="#1a2e4a">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>PitchShuffle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <% if (currentUser) { %>
    <%
        const p           = currentUser.preferences || {};
        const isDark      = p.theme === 'dark';
        const fontSizeMap = { sm: '0.65rem', md: '0.75rem', lg: '0.88rem' };
        const gameFont    = fontSizeMap[p.gameFontSize] || '0.75rem';

        function luminance(hex) {
            const h = hex.replace('#', '');
            const toLinear = c => {
                const v = parseInt(h.substring(c, c + 2), 16) / 255;
                return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
            };
            return 0.2126 * toLinear(0) + 0.7152 * toLinear(2) + 0.0722 * toLinear(4);
        }

        function contrastText(hex) {
            const L = luminance(hex);
            return (1.05 / (L + 0.05)) >= ((L + 0.05) / 0.05) ? '#ffffff' : '#000000';
        }

        function shift(hex, amount) {
            const h = hex.replace('#', '');
            const lighten = luminance(hex) < 0.18;
            const channels = [0, 2, 4].map(i => {
                const v = parseInt(h.substring(i, i + 2), 16);
                return lighten
                    ? Math.min(255, Math.round(v + (255 - v) * amount))
                    : Math.max(0,   Math.round(v * (1 - amount)));
            });
            return '#' + channels.map(v => v.toString(16).padStart(2, '0')).join('');
        }

        // When a team is in context, use team colors.
        // Otherwise fall back to brand navy and user strike/chase prefs.
        const navyHex       = (typeof teamColor !== 'undefined' && teamColor)
                                ? teamColor : '#1a2e4a';
        const secondaryHex  = (typeof teamSecondaryColor !== 'undefined' && teamSecondaryColor)
                                ? teamSecondaryColor : navyHex;
        const strikeHex     = (typeof teamStrikeColor !== 'undefined' && teamStrikeColor)
                                ? teamStrikeColor : (p.strikeColor || '#c8ecd4');
        const chaseHex      = (typeof teamChaseColor !== 'undefined' && teamChaseColor)
                                ? teamChaseColor  : (p.chaseColor  || '#fef3cd');

        const navyText      = contrastText(navyHex);
        const secondaryText = contrastText(secondaryHex);
        const strikeText    = contrastText(strikeHex);
        const chaseText     = contrastText(chaseHex);

        const strikeBorder = shift(strikeHex, 0.30);
        const strikeHover  = shift(strikeHex, 0.12);
        const chaseBorder  = shift(chaseHex,  0.30);
        const chaseHover   = shift(chaseHex,  0.12);
    %>
    <style>
        /* ── iOS safe area insets (notch / Dynamic Island) ── */
        .navbar {
            padding-top: max(0.5rem, env(safe-area-inset-top));
        }
        body {
            padding-bottom: env(safe-area-inset-bottom);
        }

        :root {
            --ps-navy:        <%= navyHex %>;
            --ps-navy-dark:   <%= shift(navyHex, 0.20) %>;
            --ps-navy-hover:  <%= shift(navyHex, 0.10) %>;
            --ps-navy-muted:  <%= shift(navyHex, 0.35) %>;
            --accent-text:    <%= navyText %>;

            --ps-secondary:      <%= secondaryHex %>;
            --ps-secondary-text: <%= secondaryText %>;

            --strike-bg:      <%= strikeHex %>;
            --strike-border:  <%= strikeBorder %>;
            --strike-text:    <%= strikeText %>;
            --strike-hover:   <%= strikeHover %>;

            --chase-bg:       <%= chaseHex %>;
            --chase-border:   <%= chaseBorder %>;
            --chase-text:     <%= chaseText %>;
            --chase-hover:    <%= chaseHover %>;
            --chase-hover-border: <%= shift(chaseHex, 0.4) %>;

            --game-font-size: <%= gameFont %>;
            <% if (isDark) { %>
            --ps-bg:      #0f1923;
            --ps-card-bg: #1a2535;
            --ps-text:    #e8edf2;
            --ps-muted:   #8fa8c8;
            <% } %>
        }

        .card-header,
        .btn-primary,
        .btn-primary:hover,
        .page-header,
        .page-header h1 {
            color: <%= navyText %> !important;
        }

        .navbar-brand,
        .nav-link,
        .nav-link:hover {
            color: <%= navyText %> !important;
        }
        .navbar .nav-link:hover {
            background-color: <%= shift(navyHex, 0.15) %>;
            border-radius: 6px;
        }

        <% if (isDark) { %>
        body { color-scheme: dark; }
        .card { border: 1px solid #2a3f5a; }
        .form-control, .form-select { background-color: #1a2535; border-color: #2a3f5a; color: #e8edf2; }
        .form-control:focus, .form-select:focus { background-color: #1a2535; color: #e8edf2; }
        .btn-outline-secondary { color: #8fa8c8; border-color: #2a3f5a; }
        .btn-outline-secondary:hover { background: #2a3f5a; color: #e8edf2; }
        .text-muted { color: #8fa8c8 !important; }
        .modal-content { background-color: #1a2535; color: #e8edf2; }
        .modal-footer, .modal-header { border-color: #2a3f5a; }
        <% } %>
        <%
            // Detect if team color is red-ish (hue between 340-360 or 0-20)
            function isRedish(hex) {
                const h = hex.replace('#', '');
                const r = parseInt(h.substring(0,2), 16) / 255;
                const g = parseInt(h.substring(2,4), 16) / 255;
                const b = parseInt(h.substring(4,6), 16) / 255;
                const max = Math.max(r,g,b), min = Math.min(r,g,b);
                if (max === min) return false;
                let hue;
                if (max === r) hue = ((g - b) / (max - min)) % 6;
                else if (max === g) hue = (b - r) / (max - min) + 2;
                else hue = (r - g) / (max - min) + 4;
                hue = Math.round(hue * 60);
                if (hue < 0) hue += 360;
                return (hue >= 340 || hue <= 20) && (max - min) > 0.3;
            }
            const deleteStyle = isRedish(navyHex)
                ? 'color:#fff;border-color:#fff;background:transparent;'          // white outline on red
                : 'color:#dc3545;border-color:#dc3545;background:transparent;';   // normal red danger
        %>
        .btn-delete-adaptive { <%= deleteStyle %> }
        .btn-delete-adaptive:hover {
            <%= isRedish(navyHex)
                ? 'background:#fff;color:var(--ps-navy);'
                : 'background:#dc3545;color:#fff;border-color:#dc3545;' %>
        }
    </style>
    <% } %>
    <% if (currentUser) { %>
    <meta name="ps-voice-uri" content="<%= (currentUser.preferences && currentUser.preferences.voiceURI) || '' %>">
    <script>
        window.PS_VOICE_URI = document.querySelector('meta[name="ps-voice-uri"]').content;
    </script>
    <% } %>
    <% if (currentUser && locals.gameUrls && gameUrls.length) { %>
    <script>
        window.PS_GAME_URLS = <%- JSON.stringify(gameUrls) %>;
    </script>
    <% } %>
    <script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.12/dist/turbo.es2017.umd.js"></script>
</head>

<body>
    <div id="offlineBanner" class="d-none text-center py-2 small fw-semibold" 
     style="background:#c0392b; color:white; position:sticky; top:56px; z-index:999;">
    📵 You're offline — using saved data
</div>
<script>
    // Guard: only register window-level listeners once — they survive Turbo body swaps
    if (!window.__psGlobalListenersReady) {
        window.__psGlobalListenersReady = true;
 
        window.__psUpdateOnlineStatus = function () {
            var b = document.getElementById('offlineBanner');
            if (b) b.classList.toggle('d-none', navigator.onLine);
        };
        window.addEventListener('online',  window.__psUpdateOnlineStatus);
        window.addEventListener('offline', window.__psUpdateOnlineStatus);
 
        // Image size validation — document persists across Turbo swaps, so guard here too
        document.addEventListener('change', function (e) {
            var input = e.target;
            if (input.type !== 'file' || !input.accept || !input.accept.includes('image')) return;
            var file = input.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                alert('Image must be under 5MB. Please choose a smaller file.');
                input.value = '';
            }
        });
    }
    // Run on every Turbo navigation (banner element is re-rendered each time)
    window.__psUpdateOnlineStatus();
</script>
    <nav class="navbar navbar-expand-md navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/images/pitchshuffle-logo.svg" alt="PitchShuffle logo" style="height:32px;width:auto;vertical-align:middle;margin-right:6px;"> PitchShuffle
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <% if (currentUser) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/game">
                                <i class="bi bi-play-fill"></i> New Game
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/teams">
                                <i class="bi bi-people-fill"></i> My Teams
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" href="/profile">
                                <% if (currentUser.avatar) { %>
                                    <img src="<%= currentUser.avatar %>" alt="avatar"
                                         style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.4);">
                                <% } else { %>
                                    <i class="bi bi-person-circle"></i>
                                <% } %>
                                Profile
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/profile#help">
                                <i class="bi bi-question-circle"></i> Help
                            </a>
                        </li>
                        <li class="nav-item">
                            <form action="/logout" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item" id="ps-nav-register">
                            <a class="nav-link" href="/register">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
     </nav>
    <script>
    (function () {
        var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
        if (isNative) {
            var el = document.getElementById('ps-nav-register');
            if (el) el.style.display = 'none';
        }
    })();
    </script>
 
    <div class="container mt-3">
        <% if (success && success.length) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (error && error.length) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (warning && warning.length) { %>
            <% for (let msg of warning) { %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>
        <% } %>
    </div>

    <main>
        <%- body %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .then(reg => {
                        // Pre-cache all game pages while online
                        if (navigator.onLine && typeof window.PS_GAME_URLS !== 'undefined' && window.PS_GAME_URLS.length) {
                            const sw = reg.active || reg.installing || reg.waiting;
                            if (sw) {
                                sw.postMessage({ type: 'PRECACHE_GAME_URLS', urls: window.PS_GAME_URLS });
                            } else {
                                navigator.serviceWorker.ready.then(r => {
                                    r.active.postMessage({ type: 'PRECACHE_GAME_URLS', urls: window.PS_GAME_URLS });
                                });
                            }
                        }
                    })
                    .catch(err => console.warn('SW registration failed:', err));
            });
        }
    </script>
    <% if (currentUser) { %>
    <script>
        // Silently sync all pitcher/team data to localStorage for offline game mode.
        // Fires in the background on every page load while online — no user action needed.
        if (navigator.onLine) {
            fetch('/api/my-data', { credentials: 'include' })
                .then(r => r.ok ? r.json() : null)
                .then(data => { if (data) localStorage.setItem('ps_offline_data', JSON.stringify(data)); })
                .catch(() => {});
        }
    </script>
    <% } %>
    <footer class="text-center py-3 mt-4">
        <a href="/terms" class="text-muted small me-3">Terms of Service</a>
        <a href="/privacy" class="text-muted small">Privacy Policy</a>
    </footer>

<!-- ════════════════════════════════════════════════════════════════
     RATING / REVIEW PROMPT

     iOS (Capacitor native): uses Apple's native SKStoreReviewController
     via @capacitor-community/in-app-review. This is Apple's expected
     pattern — no custom UI, no App Store link, no maybe-later/no-thanks
     buttons. iOS itself rate-limits how often the system dialog can
     appear (max ~3x/12mo), so no client-side delay/frequency logic is
     needed or wanted here; the OS handles it.

     Website (regular browser): keeps the original custom HTML modal,
     since SKStoreReviewController doesn't exist outside the native app
     and the App Store link is the correct fallback there.

     Install once (on the cloud Mac, before archiving):
         npm install @capacitor-community/in-app-review
         npx cap sync ios
     ════════════════════════════════════════════════════════════════ -->
<script type="module">
    (function() {
        const isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());

        const RATING_KEY = 'ps_rating_prompted';
        const FIRST_KEY  = 'ps_first_visit';
        const DELAY_MS   = 1000 * 60 * 60 * 24 * 3; // 3 days

        if (localStorage.getItem(RATING_KEY)) return;
        if (!localStorage.getItem(FIRST_KEY)) {
            localStorage.setItem(FIRST_KEY, Date.now());
            return;
        }
        const elapsed = Date.now() - parseInt(localStorage.getItem(FIRST_KEY), 10);
        if (elapsed < DELAY_MS) return;

        if (isNative) {
            // ── Native iOS: trigger Apple's system review dialog ──
            // Mark as prompted immediately — once requestReview() is
            // called, iOS owns all further display/frequency logic.
            localStorage.setItem(RATING_KEY, '1');

            try {
                const InAppReview = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.InAppReview;
                if (InAppReview) {
                    InAppReview.requestReview().catch(err => console.warn('In-app review request failed:', err));
                } else {
                    console.warn('InAppReview plugin not available on native bridge');
                }
            } catch (err) {
                console.warn('In-app review request failed:', err);
            }
            return;
        }

        // ── Website fallback: original custom modal + App Store link ──
        const modal = document.createElement('div');
        modal.innerHTML = `
            <div id="psRatingBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9000;display:flex;align-items:center;justify-content:center;padding:1rem;">
                <div style="background:var(--ps-card-bg,#fff);border-radius:16px;padding:1.5rem;max-width:320px;width:100%;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.25);">
                    <div style="font-size:2rem;margin-bottom:0.5rem;">⚾</div>
                    <h5 style="font-weight:700;margin-bottom:0.5rem;">Enjoying PitchShuffle?</h5>
                    <p style="color:#6c757d;font-size:0.9rem;margin-bottom:1.25rem;">If it's been helpful in the dugout, a quick rating goes a long way for a solo-built app.</p>
                    <div style="display:flex;flex-direction:column;gap:0.5rem;">
                        <a id="psRatingYes" href="https://apps.apple.com/app/id6781397658" target="_blank" rel="noopener"
                           style="background:var(--ps-navy,#1a2e4a);color:#fff;border:none;border-radius:10px;padding:0.65rem;font-weight:700;font-size:0.95rem;text-decoration:none;">
                            ⭐ Rate PitchShuffle
                        </a>
                        <button id="psRatingLater" style="background:transparent;border:none;color:#6c757d;font-size:0.85rem;padding:0.4rem;cursor:pointer;">
                            Maybe later
                        </button>
                        <button id="psRatingNo" style="background:transparent;border:none;color:#adb5bd;font-size:0.8rem;padding:0.2rem;cursor:pointer;">
                            No thanks
                        </button>
                    </div>
                </div>
            </div>`;
        document.body.appendChild(modal);

        function dismiss(permanent) {
            document.getElementById('psRatingBackdrop').remove();
            if (permanent) localStorage.setItem(RATING_KEY, '1');
            else localStorage.setItem(FIRST_KEY, Date.now()); // reset timer for "later"
        }

        document.getElementById('psRatingYes').addEventListener('click', () => dismiss(true));
        document.getElementById('psRatingNo').addEventListener('click',  () => dismiss(true));
        document.getElementById('psRatingLater').addEventListener('click', () => dismiss(false));
    })();
</script>
<script>
(function flushOfflineShuffleQueue() {
    let pending;
    try { pending = JSON.parse(localStorage.getItem('ps_shuffle_pending') || '{}'); }
    catch(e) { return; }

    const ids = Object.keys(pending);
    if (!ids.length) return;

    Promise.allSettled(ids.map(async pitcherId => {
        const { teamId, strikeChancePct, pitchWeights } = pending[pitcherId];
        const res = await fetch(
            `/teams/${teamId}/pitchers/${pitcherId}/shuffle-settings`,
            {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ strikeChancePct, pitchWeights }),
            }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return pitcherId;
    })).then(results => {
        // Remove successfully synced entries from the queue
        results.forEach((r, i) => {
            if (r.status === 'fulfilled') delete pending[ids[i]];
        });
        try { localStorage.setItem('ps_shuffle_pending', JSON.stringify(pending)); }
        catch(e) {}
    });
})();
</script>
</body>

</html>
