<!DOCTYPE html>
<html lang="en" data-theme="<%= (currentUser && currentUser.preferences && currentUser.preferences.theme) ? currentUser.preferences.theme : 'light' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PitchShuffle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <% if (currentUser && currentUser.preferences) { %>
    <%
        const p      = currentUser.preferences;
        const isDark = p.theme === 'dark';
        const fontSizeMap = { sm: '0.65rem', md: '0.75rem', lg: '0.88rem' };
        const gameFont = fontSizeMap[p.gameFontSize] || '0.75rem';
    %>
    <style>
        /* ── User preference overrides ── */
        :root {
            --ps-navy:        <%= p.accentColor %>;
            --ps-navy-dark:   color-mix(in srgb, <%= p.accentColor %> 80%, #000);
            --ps-navy-hover:  color-mix(in srgb, <%= p.accentColor %> 85%, #fff);
            --strike-bg:      <%= p.strikeColor %>;
            --chase-bg:       <%= p.chaseColor %>;
            <% if (isDark) { %>
            --ps-bg:          #0f1923;
            --ps-card-bg:     #1a2535;
            --ps-text:        #e8edf2;
            --ps-muted:       #8fa8c8;
            <% } %>
            --game-font-size: <%= gameFont %>;
        }
        <% if (isDark) { %>
        /* Dark mode overrides */
        body { color-scheme: dark; }
        .card  { border: 1px solid #2a3f5a; }
        .form-control, .form-select {
            background-color: #1a2535;
            border-color: #2a3f5a;
            color: #e8edf2;
        }
        .form-control:focus, .form-select:focus {
            background-color: #1a2535;
            color: #e8edf2;
        }
        .btn-outline-secondary { color: #8fa8c8; border-color: #2a3f5a; }
        .btn-outline-secondary:hover { background: #2a3f5a; color: #e8edf2; }
        .text-muted { color: #8fa8c8 !important; }
        .modal-content { background-color: #1a2535; color: #e8edf2; }
        .modal-footer, .modal-header { border-color: #2a3f5a; }
        <% } %>
    </style>
    <% } %>
</head>

<body>
    <nav class="navbar navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-bullseye"></i> PitchShuffle
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <% if (currentUser) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/game">
                                <i class="bi bi-play-fill"></i> New Game
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/teams">
                                <i class="bi bi-people-fill"></i> My Teams
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" href="/profile">
                                <% if (currentUser.avatar) { %>
                                    <img src="<%= currentUser.avatar %>" alt="avatar"
                                         style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.4);">
                                <% } else { %>
                                    <i class="bi bi-person-circle"></i>
                                <% } %>
                                Profile
                            </a>
                        </li>
                        <li class="nav-item">
                            <form action="/logout" method="POST" class="d-inline">
                                <button type="submit" class="nav-link btn btn-link p-0">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        <% if (success && success.length) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error && error.length) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
    </div>

    <main>
        <%- body %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
