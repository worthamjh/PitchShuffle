    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <% if (currentUser) { %>
    <%
        // NOTE: these use `var` (not `const`/`function`) deliberately so they
        // stay accessible later in this template at the <body> tag, where we
        // apply them as an inline style attribute. Turbo only guarantees a
        // clean swap of <body> on every navigation — its <head> merge logic
        // doesn't reliably replace per-request inline <style> blocks, which
        // previously caused stale team colors to bleed across pages after a
        // Turbo soft-visit. Setting these as CSS custom properties directly
        // on <body> sidesteps that entirely.
        var p           = currentUser.preferences || {};
        var isDark      = p.theme === 'dark';
        var fontSizeMap = { sm: '0.65rem', md: '0.75rem', lg: '0.88rem' };
        var gameFont    = fontSizeMap[p.gameFontSize] || '0.75rem';

        var luminance = function (hex) {
            var h = hex.replace('#', '');
            var toLinear = function (c) {
                var v = parseInt(h.substring(c, c + 2), 16) / 255;
                return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
            };
            return 0.2126 * toLinear(0) + 0.7152 * toLinear(2) + 0.0722 * toLinear(4);
        };

        var contrastText = function (hex) {
            var L = luminance(hex);
            return (1.05 / (L + 0.05)) >= ((L + 0.05) / 0.05) ? '#ffffff' : '#000000';
        };

        var shift = function (hex, amount) {
            var h = hex.replace('#', '');
            var lighten = luminance(hex) < 0.18;
            var channels = [0, 2, 4].map(function (i) {
                var v = parseInt(h.substring(i, i + 2), 16);
                return lighten
                    ? Math.min(255, Math.round(v + (255 - v) * amount))
                    : Math.max(0,   Math.round(v * (1 - amount)));
            });
            return '#' + channels.map(function (v) { return v.toString(16).padStart(2, '0'); }).join('');
        };

        // When a team is in context, use team colors.
        // Otherwise fall back to brand navy and user strike/chase prefs.
        var navyHex       = (typeof teamColor !== 'undefined' && teamColor)
                                ? teamColor : '#1a2e4a';
        var secondaryHex  = (typeof teamSecondaryColor !== 'undefined' && teamSecondaryColor)
                                ? teamSecondaryColor : navyHex;
        var strikeHex     = (typeof teamStrikeColor !== 'undefined' && teamStrikeColor)
                                ? teamStrikeColor : (p.strikeColor || '#c8ecd4');
        var chaseHex      = (typeof teamChaseColor !== 'undefined' && teamChaseColor)
                                ? teamChaseColor  : (p.chaseColor  || '#fef3cd');

        var navyText      = contrastText(navyHex);
        var secondaryText = contrastText(secondaryHex);
        var strikeText    = contrastText(strikeHex);
        var chaseText     = contrastText(chaseHex);

        var strikeBorder = shift(strikeHex, 0.30);
        var strikeHover  = shift(strikeHex, 0.12);
        var chaseBorder  = shift(chaseHex,  0.30);
        var chaseHover   = shift(chaseHex,  0.12);
    %>
    <style>
        /* ── iOS safe area insets (notch / Dynamic Island) ── */
        .navbar {
            padding-top: max(0.5rem, env(safe-area-inset-top));
        }
        body {
            padding-bottom: env(safe-area-inset-bottom);
        }

        /* Team/theme CSS custom properties (--ps-navy, --accent-text, etc.)
           are applied as an inline style attribute on <body> instead of a
           :root rule here — see the note above and the <body> tag below.
           This block used to also hard-code .navbar-brand/.card-header/etc.
           colors directly from <%= navyText %>, which was fully redundant
           with the var(--accent-text) rules already in style.css and was
           the cause of team colors occasionally bleeding across Turbo
           navigations; removed rather than duplicated. */

        <% if (isDark) { %>
        body { color-scheme: dark; }
        .card { border: 1px solid #2a3f5a; }
        .form-control, .form-select { background-color: #1a2535; border-color: #2a3f5a; color: #e8edf2; }
        .form-control:focus, .form-select:focus { background-color: #1a2535; color: #e8edf2; }
        .btn-outline-secondary { color: #8fa8c8; border-color: #2a3f5a; }
        .btn-outline-secondary:hover { background: #2a3f5a; color: #e8edf2; }
        .text-muted { color: #8fa8c8 !important; }
        .modal-content { background-color: #1a2535; color: #e8edf2; }
        .modal-footer, .modal-header { border-color: #2a3f5a; }
        <% } %>
        <%
            // Detect if team color is red-ish (hue between 340-360 or 0-20)
            function isRedish(hex) {
                const h = hex.replace('#', '');
                const r = parseInt(h.substring(0,2), 16) / 255;
                const g = parseInt(h.substring(2,4), 16) / 255;
                const b = parseInt(h.substring(4,6), 16) / 255;
                const max = Math.max(r,g,b), min = Math.min(r,g,b);
                if (max === min) return false;
                let hue;
                if (max === r) hue = ((g - b) / (max - min)) % 6;
                else if (max === g) hue = (b - r) / (max - min) + 2;
                else hue = (r - g) / (max - min) + 4;
                hue = Math.round(hue * 60);
                if (hue < 0) hue += 360;
                return (hue >= 340 || hue <= 20) && (max - min) > 0.3;
            }
            const deleteStyle = isRedish(navyHex)
                ? 'color:#fff;border-color:#fff;background:transparent;'          // white outline on red
                : 'color:#dc3545;border-color:#dc3545;background:transparent;';   // normal red danger
        %>
        .btn-delete-adaptive { <%= deleteStyle %> }
        .btn-delete-adaptive:hover {
            <%= isRedish(navyHex)
                ? 'background:#fff;color:var(--ps-navy);'
                : 'background:#dc3545;color:#fff;border-color:#dc3545;' %>
        }
    </style>
    <% } %>
    <% if (currentUser) { %>
    <meta name="ps-voice-uri" content="<%= (currentUser.preferences && currentUser.preferences.voiceURI) || '' %>">
    <script>
        window.PS_VOICE_URI = document.querySelector('meta[name="ps-voice-uri"]').content;
    </script>
    <% } %>
    <% if (currentUser && locals.gameUrls && gameUrls.length) { %>
    <script>
        window.PS_GAME_URLS = <%- JSON.stringify(gameUrls) %>;
    </script>
    <% } %>
    <script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.12/dist/turbo.es2017-umd.js"></script>
    <style>
        #ps-turbo-loader {
            position: fixed;
            inset: 0;
            z-index: 10000;
            background-color: var(--ps-navy, #1a2e4a);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.12s ease-out;
        }
        #ps-turbo-loader.ps-visible {
            opacity: 1;
            pointer-events: auto;
        }
        #ps-turbo-loader .spinner-border {
            width: 2.5rem;
            height: 2.5rem;
            color: rgba(255, 255, 255, 0.85);
        }
    </style>
</head>

<body<% if (currentUser) { %> style="--ps-navy:<%= navyHex %>; --ps-navy-dark:<%= shift(navyHex, 0.20) %>; --ps-navy-hover:<%= shift(navyHex, 0.10) %>; --ps-navy-muted:<%= shift(navyHex, 0.35) %>; --accent-text:<%= navyText %>; --ps-secondary:<%= secondaryHex %>; --ps-secondary-text:<%= secondaryText %>; --strike-bg:<%= strikeHex %>; --strike-border:<%= strikeBorder %>; --strike-text:<%= strikeText %>; --strike-hover:<%= strikeHover %>; --chase-bg:<%= chaseHex %>; --chase-border:<%= chaseBorder %>; --chase-text:<%= chaseText %>; --chase-hover:<%= chaseHover %>; --chase-hover-border:<%= shift(chaseHex, 0.4) %>; --game-font-size:<%= gameFont %>;<% if (isDark) { %> --ps-bg:#0f1923; --ps-card-bg:#1a2535; --ps-text:#e8edf2; --ps-muted:#8fa8c8;<% } %>"<% } %>>
    <div id="ps-turbo-loader"><div class="spinner-border" role="status"></div></div>
    <script>
        // ── Turbo navigation loading overlay (safety net) ──
        // Shows a brief spinner on slow navigations instead of a blank frame.
        // Delayed slightly so fast/cached navigations never see it flash.
        (function () {
            if (window.__psTurboLoaderReady) return;
            window.__psTurboLoaderReady = true;

            var loader = document.getElementById('ps-turbo-loader');
            var showTimer = null;

            function show() {
                showTimer = setTimeout(function () {
                    if (loader) loader.classList.add('ps-visible');
                }, 60);
            }
            function hide() {
                clearTimeout(showTimer);
                if (loader) loader.classList.remove('ps-visible');
            }

            document.addEventListener('turbo:before-visit', show);
            document.addEventListener('turbo:load', hide);
            document.addEventListener('turbo:before-cache', hide);
            window.addEventListener('pageshow', hide);
        })();
    </script>
    <script>
        // ── Native launch splash screen ──
        // capacitor.config.json sets SplashScreen.launchAutoHide=false, so the
        // native splash (logo on navy) stays up from process launch until we
        // explicitly hide it here, once this first page has actually rendered.
        // That covers the whole cold-start gap, not just the sub-second native
        // storyboard flash — no more flat color flash before login appears.
        (function () {
            if (window.__psSplashHidden) return;

            function hideSplash() {
                if (window.__psSplashHidden) return;
                window.__psSplashHidden = true;
                try {
                    var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
                    var SplashScreen = isNative && window.Capacitor.Plugins && window.Capacitor.Plugins.SplashScreen;
                    if (SplashScreen) SplashScreen.hide();
                } catch (err) {
                    console.warn('SplashScreen hide failed:', err);
                }
            }

            // turbo:load covers the normal case (Turbo processes the initial
            // document just like any other visit). window 'load' is a fallback
            // in case Turbo isn't ready yet for some reason on this page.
            document.addEventListener('turbo:load', hideSplash, { once: true });
            window.addEventListener('load', function () {
                setTimeout(hideSplash, 150);
            });
        })();
    </script>
    <div id="offlineBanner" class="d-none text-center py-2 small fw-semibold"
     style="background:#c0392b; color:white; position:sticky; top:56px; z-index:999;">
    📵 You're offline — using saved data
</div>
<script>
    // Guard: only register window-level listeners once — they survive Turbo body swaps
    if (!window.__psGlobalListenersReady) {
        window.__psGlobalListenersReady = true;
 
        window.__psUpdateOnlineStatus = function () {
            var b = document.getElementById('offlineBanner');
            if (b) b.classList.toggle('d-none', navigator.onLine);
        };
        window.addEventListener('online',  window.__psUpdateOnlineStatus);
        window.addEventListener('offline', window.__psUpdateOnlineStatus);
 
        // Image size validation — document persists across Turbo swaps, so guard here too
        document.addEventListener('change', function (e) {
            var input = e.target;
            if (input.type !== 'file' || !input.accept || !input.accept.includes('image')) return;
            var file = input.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                alert('Image must be under 5MB. Please choose a smaller file.');
                input.value = '';
            }
        });

        // Native Google/Apple sign-in return handler. login.ejs opens those
        // flows in an in-app browser sheet (Capacitor Browser plugin)
        // rather than a plain link, since the OAuth screens get handed off
        // to the system browser otherwise with no way back into the app.
        // The server's final redirect there is the pitchshuffle:// custom
        // URL scheme, which iOS routes back to us as an appUrlOpen event —
        // that's our signal to close the sheet and load the now-logged-in
        // page (cookies are shared between the sheet and this WebView).
        (function () {
            var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
            if (!isNative || !window.Capacitor.Plugins) return;
            var CapApp = window.Capacitor.Plugins.App;
            var CapacitorBrowser = window.Capacitor.Plugins.Browser;
            if (!CapApp) return;
            CapApp.addListener('appUrlOpen', function (data) {
                var url = data && data.url;
                if (!url || url.indexOf('pitchshuffle://') !== 0) return;
                if (CapacitorBrowser) CapacitorBrowser.close().catch(function () {});
                var isFailure = url.indexOf('auth-failed') !== -1;
                var dest = '/login';
                try {
                    var parsed = new URL(url.replace('pitchshuffle://', 'https://placeholder/'));
                    if (isFailure) {
                        var message = parsed.searchParams.get('message');
                        // Carry the error message along as a query param
                        // rather than relying solely on server-side session
                        // flash, in case that response's session cookie
                        // isn't reliably visible yet to this WebView's next
                        // request. login.ejs reads and displays ?oauthError=.
                        dest = '/login' + (message ? '?oauthError=' + encodeURIComponent(message) : '');
                    } else {
                        // Success: exchange the one-time token for a real
                        // login session in this WebView's own request,
                        // rather than assuming the sheet's session cookie
                        // carried over.
                        var token = parsed.searchParams.get('token');
                        var next = parsed.searchParams.get('next') || '/';
                        dest = token
                            ? '/auth/native-exchange?token=' + encodeURIComponent(token) + '&next=' + encodeURIComponent(next)
                            : next;
                    }
                } catch (e) {}
                window.location.href = dest;
            });
        })();
    }
    // Run on every Turbo navigation (banner element is re-rendered each time)
    window.__psUpdateOnlineStatus();
</script>
