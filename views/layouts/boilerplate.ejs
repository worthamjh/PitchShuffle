    <script>
        // ── Auto-dismiss flash banners (success/warning) after a few seconds ──
        // Errors are left alone since those usually need the user to actually
        // read/act on them. Re-runs on every Turbo navigation since the
        // banners are freshly rendered server-side on each page load.
        (function () {
            function autoDismiss() {
                document.querySelectorAll('.ps-auto-dismiss').forEach(function (el) {
                    setTimeout(function () {
                        if (window.bootstrap && window.bootstrap.Alert) {
                            var alert = window.bootstrap.Alert.getOrCreateInstance(el);
                            alert.close();
                        } else {
                            el.remove();
                        }
                    }, 3500);
                });
            }
            // turbo:load fires for both the initial page load and every
            // subsequent soft-navigation, so this alone covers all cases.
            document.addEventListener('turbo:load', autoDismiss);
        })();
    </script>

