<!DOCTYPE html>
<html lang="en" data-theme="<%= (currentUser && currentUser.preferences && currentUser.preferences.theme) ? currentUser.preferences.theme : 'light' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PitchShuffle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <% if (currentUser) { %>
    <%
        const p           = currentUser.preferences || {};
        const isDark      = p.theme === 'dark';
        const fontSizeMap = { sm: '0.65rem', md: '0.75rem', lg: '0.88rem' };
        const gameFont    = fontSizeMap[p.gameFontSize] || '0.75rem';

        // ── Luminance helper ──────────────────────────────────────
        // Returns relative luminance (0–1) of a hex colour.
        function luminance(hex) {
            const h = hex.replace('#', '');
            const toLinear = c => {
                const v = parseInt(h.substring(c, c + 2), 16) / 255;
                return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
            };
            return 0.2126 * toLinear(0) + 0.7152 * toLinear(2) + 0.0722 * toLinear(4);
        }

        // ── Contrast helper ───────────────────────────────────────
        // Returns '#ffffff' or '#000000' — whichever has better WCAG contrast.
        function contrastText(hex) {
            const L = luminance(hex);
            const onWhite = (1.05) / (L + 0.05);
            const onBlack = (L + 0.05) / (0.05);
            return onWhite >= onBlack ? '#ffffff' : '#000000';
        }

        // ── Shift helper ──────────────────────────────────────────
        // Shifts each RGB channel toward white (lighten) or black (darken)
        // by `amount` (0–1). Direction is chosen automatically so the result
        // always contrasts against the source — dark colours get lightened,
        // light colours get darkened. This ensures borders and hover states
        // are always visible no matter what colour the user picks.
        function shift(hex, amount) {
            const h = hex.replace('#', '');
            const L = luminance(hex);
            // For dark colours (L < 0.18), shift toward white; otherwise toward black
            const lighten = L < 0.18;
            const channels = [0, 2, 4].map(i => {
                const v = parseInt(h.substring(i, i + 2), 16);
                return lighten
                    ? Math.min(255, Math.round(v + (255 - v) * amount))
                    : Math.max(0,   Math.round(v * (1 - amount)));
            });
            return '#' + channels.map(v => v.toString(16).padStart(2, '0')).join('');
        }

        const accentHex = p.accentColor || '#1a2e4a';
        const strikeHex = p.strikeColor || '#c8ecd4';
        const chaseHex  = p.chaseColor  || '#fef3cd';

        const accentText  = contrastText(accentHex);
        const strikeText  = contrastText(strikeHex);
        const chaseText   = contrastText(chaseHex);

        const strikeBorder = shift(strikeHex, 0.30);
        const strikeHover  = shift(strikeHex, 0.12);
        const chaseBorder  = shift(chaseHex,  0.30);
        const chaseHover   = shift(chaseHex,  0.12);
    %>
    <style>
        :root {
            --ps-navy:        <%= accentHex %>;
            --ps-navy-dark:   <%= shift(accentHex, 0.20) %>;
            --ps-navy-hover:  <%= shift(accentHex, 0.10) %>;
            --accent-text:    <%= accentText %>;

            --strike-bg:      <%= strikeHex %>;
            --strike-border:  <%= strikeBorder %>;
            --strike-text:    <%= strikeText %>;
            --strike-hover:   <%= strikeHover %>;

            --chase-bg:       <%= chaseHex %>;
            --chase-border:   <%= chaseBorder %>;
            --chase-text:     <%= chaseText %>;
            --chase-hover:    <%= chaseHover %>;
            --chase-hover-border: <%= shift(chaseHex, 0.4) %>;

            --game-font-size: <%= gameFont %>;
            <% if (isDark) { %>
            --ps-bg:      #0f1923;
            --ps-card-bg: #1a2535;
            --ps-text:    #e8edf2;
            --ps-muted:   #8fa8c8;
            <% } %>
        }

        /* Accent colour text — navbar, card headers, buttons */
        .navbar-brand,
        .nav-link,
        .card-header,
        .btn-primary,
        .btn-primary:hover,
        .page-header,
        .page-header h1 {
            color: <%= accentText %> !important;
        }

        /* Nav hover: use a shifted background + same contrast text so it's
           always visible regardless of accent colour (fixes white-on-white) */
        .nav-link:hover {
            color: <%= accentText %> !important;
            background-color: <%= shift(accentHex, 0.15) %>;
            border-radius: 6px;
        }
        <% if (isDark) { %>
        body { color-scheme: dark; }
        .card { border: 1px solid #2a3f5a; }
        .form-control, .form-select { background-color: #1a2535; border-color: #2a3f5a; color: #e8edf2; }
        .form-control:focus, .form-select:focus { background-color: #1a2535; color: #e8edf2; }
        .btn-outline-secondary { color: #8fa8c8; border-color: #2a3f5a; }
        .btn-outline-secondary:hover { background: #2a3f5a; color: #e8edf2; }
        .text-muted { color: #8fa8c8 !important; }
        .modal-content { background-color: #1a2535; color: #e8edf2; }
        .modal-footer, .modal-header { border-color: #2a3f5a; }
        <% } %>
    </style>
    <% } %>
</head>

<body>
    <nav class="navbar navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-bullseye"></i> PitchShuffle
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <% if (currentUser) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/game">
                                <i class="bi bi-play-fill"></i> New Game
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/teams">
                                <i class="bi bi-people-fill"></i> My Teams
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" href="/profile">
                                <% if (currentUser.avatar) { %>
                                    <img src="<%= currentUser.avatar %>" alt="avatar"
                                         style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.4);">
                                <% } else { %>
                                    <i class="bi bi-person-circle"></i>
                                <% } %>
                                Profile
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        <% if (success && success.length) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error && error.length) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
    </div>

    <main>
        <%- body %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
