<%- layout('layouts/boilerplate') %>

    <style>
        .zone-grid {
            display: grid;
            gap: 0;
            margin: 0 auto;
            border: 2px solid #adb5bd;
        }

        .loc-box {
            width: 70px;
            height: 70px;
            border-radius: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.55rem;
            font-weight: 700;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 4px;
            box-sizing: border-box;
            border: 1px solid rgba(0,0,0,0.12);
            transition: background-color 0.15s, border-color 0.15s;
            user-select: none;
            cursor: pointer;
        }

        @media (min-width: 576px) {
            .loc-box { width: 88px; height: 88px; font-size: 0.6rem; }
        }
        @media (min-width: 992px) {
            .loc-box { width: 108px; height: 108px; font-size: 0.7rem; }
        }

        .loc-box.strike   { background: #c8ecd4; border-color: #2e7d4f; color: #155724; }
        .loc-box.chase    { background: #fef3cd; border-color: #d4a017; color: #856404; }
        .loc-box.disabled { background: #e9ecef; border-color: #ced4da; color: #adb5bd; text-decoration: line-through; }
        .loc-box.empty    { background: transparent; border-color: transparent; cursor: default; pointer-events: none; }
        .loc-box.covered  { pointer-events: none; }

        .loc-box.strike:hover   { background: #a8dbb8; border-color: #2e7d4f; }
        .loc-box.chase:hover    { background: #f5d97a; border-color: #b8860b; }
        .loc-box.disabled:hover { background: #e9ecef; }
        .loc-box.empty:hover, .loc-box.covered:hover { background: inherit; }

        /* Font size breakpoints applied to both cells and overlays at once */
        @media (min-width: 576px) { .loc-box, .chase-overlay { font-size: 0.6rem; } }
        @media (min-width: 992px) { .loc-box, .chase-overlay { font-size: 0.7rem; } }

        .chase-overlay {
            position: absolute;
            z-index: 5;
            background: #fef3cd;
            border: 1px solid #d4a017;
            color: #856404;
            font-size: 0.55rem;
            font-weight: 700;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            cursor: pointer;
            user-select: none;
            transition: background-color 0.15s, border-color 0.15s;
        }
        .chase-overlay:hover          { background: #f5d97a; border-color: #b8860b; }
        .chase-overlay.disabled       { background: #e9ecef; border-color: #ced4da; color: #adb5bd; text-decoration: line-through; }
        .chase-overlay.disabled:hover { background: #e9ecef; border-color: #ced4da; }

        .strike-zone-outline {
            position: absolute;
            pointer-events: none;
            border: 3px solid #1a2e4a;
            z-index: 10;
        }

        .zone-grid-wrapper {
            display: inline-block;
            position: relative;
        }

        .pitchers-view-label {
            text-align: center;
            font-size: 0.7rem;
            font-weight: 600;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .zone-container  { display: flex; justify-content: center; padding: 1rem 0; }
        .pitch-section   { border: 1px solid #dee2e6; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; background: #fff; }
        .pitch-section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }

        /* Zone card button — matches the label style used in new.ejs */
        .zone-image-card-btn {
            width: 100%;
            background: #fff;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            padding: 0.75rem;
            cursor: pointer;
            text-align: center;
            transition: border-color 0.15s, box-shadow 0.15s;
            display: block;
        }
        .zone-image-card-btn:hover {
            border-color: #8fa8c8;
            box-shadow: 0 0 0 3px rgba(26,46,74,0.08);
        }
        .zone-change-form { margin: 0; }

        /* Active (currently selected) zone card */
        .active-zone {
            border: 2px solid #1a2e4a !important;
            box-shadow: 0 0 0 3px rgba(26,46,74,0.15);
            background: #eef2f7;
        }
    </style>

    <div class="page-header d-flex justify-content-between align-items-center">
        <h1><i class="bi bi-pencil"></i> Edit <%= pitcher.name %> #<%= pitcher.number %></h1>
        <a href="/teams/<%= team._id %>" class="btn btn-outline-light">
            <i class="bi bi-arrow-left"></i> Back to Team
        </a>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form action="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>?_method=PUT" method="POST" id="pitcherForm">

                <!-- Basic Info -->
                <h5 class="fw-bold mb-3">Basic Info</h5>
                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label for="name" class="form-label fw-bold">Name</label>
                        <input type="text" class="form-control form-control-lg" id="name" name="pitcher[name]"
                            value="<%= pitcher.name %>" required>
                    </div>
                    <div class="col-md-3 mb-3 mb-md-0">
                        <label for="number" class="form-label fw-bold">Jersey #</label>
                        <input type="number" class="form-control form-control-lg" id="number" name="pitcher[number]"
                            value="<%= pitcher.number %>">
                    </div>
                    <div class="col-md-3">
                        <label for="throws" class="form-label fw-bold">Throws</label>
                        <select class="form-select form-select-lg" id="throws" name="pitcher[throws]">
                            <option value="R" <%= pitcher.throws === 'R' ? 'selected' : '' %>>Right</option>
                            <option value="L" <%= pitcher.throws === 'L' ? 'selected' : '' %>>Left</option>
                        </select>
                    </div>
                </div>

                <!-- Zone Selection -->
                <h5 class="fw-bold mb-3 mt-4">Strike Zone</h5>

                <!-- Revert banner — only shown when a previous zone snapshot exists -->
                <% if (pitcher.previousZone) { %>
                    <div class="alert d-flex align-items-center justify-content-between gap-2 mb-3"
                         style="background:#eef2f7;border:1px solid #c0cfe0;border-radius:10px;padding:0.75rem 1rem;">
                        <span><i class="bi bi-arrow-counterclockwise me-1"></i> Zone changed — your previous location settings are saved.</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="revertZoneBtn">Revert to Previous Zone</button>
                    </div>
                <% } %>

                <!-- Zone cards — clicking submits via JS to avoid nested forms -->
                <div class="mb-4">
                    <div class="row row-cols-1 row-cols-md-3 g-3">
                        <% for (let zone of zones) { %>
                            <% const isSelected = pitcher.zone && pitcher.zone._id.equals(zone._id); %>
                            <%
                                const _zoneImageMap = { 'A': 'zone_a.png', 'B': 'zone_b.png', 'C': 'zone_c.png' };
                                const _zoneLetter   = zone.name.match(/Zone ([A-Z])/)?.[1];
                                const _zoneImg      = _zoneImageMap[_zoneLetter] || null;
                            %>
                            <div class="col">
                                <% if (isSelected) { %>
                                    <div class="zone-image-card active-zone">
                                        <% if (_zoneImg) { %>
                                            <img src="/images/<%= _zoneImg %>" alt="<%= zone.name %>"
                                                style="width:80px;height:80px;object-fit:contain;">
                                        <% } %>
                                        <div class="zone-card-label">
                                            <%= zone.name %>
                                            <small><%= zone.availableLocations.length %> locations</small>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <button type="button" class="zone-image-card zone-image-card-btn"
                                        data-zone-id="<%= zone._id %>"
                                        data-zone-url="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/change-zone">
                                        <% if (_zoneImg) { %>
                                            <img src="/images/<%= _zoneImg %>" alt="<%= zone.name %>"
                                                style="width:80px;height:80px;object-fit:contain;">
                                        <% } %>
                                        <div class="zone-card-label">
                                            <%= zone.name %>
                                            <small><%= zone.availableLocations.length %> locations</small>
                                        </div>
                                    </button>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                    <input type="hidden" name="pitcher[zone]" value="<%= pitcher.zone ? pitcher.zone._id : '' %>">
                </div>

                <!-- Pitch Types Header + View Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                    <h5 class="fw-bold mb-0">Pitch Types & Locations</h5>
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="viewMode" id="visualMode" checked>
                        <label class="btn btn-outline-primary btn-sm" for="visualMode">
                            <i class="bi bi-grid-3x3"></i> Visual
                        </label>
                        <input type="radio" class="btn-check" name="viewMode" id="listMode">
                        <label class="btn btn-outline-primary btn-sm" for="listMode">
                            <i class="bi bi-list-check"></i> List
                        </label>
                    </div>
                </div>

                <!-- Legend -->
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:20px;height:20px;background:#c8ecd4;border:2px solid #2e7d4f;display:inline-block;"></span>
                        <small>Strike location</small>
                    </span>
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:20px;height:20px;background:#fef3cd;border:2px solid #d4a017;display:inline-block;"></span>
                        <small>Chase</small>
                    </span>
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:20px;height:20px;background:#e9ecef;border:2px solid #ced4da;display:inline-block;"></span>
                        <small>Disabled</small>
                    </span>
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:20px;height:20px;border:3px solid #1a2e4a;display:inline-block;"></span>
                        <small>Strike zone boundary</small>
                    </span>
                </div>

                <!-- Pitch Type Sections -->
                <div id="pitchTypes">
                    <% for (var i = 0; i < pitcher.pitchTypes.length; i++) { %>
                        <% var pitch = pitcher.pitchTypes[i]; %>
                        <%
                            var knownNames = ['Fastball','Two-Seam Fastball','Cutter','Sinker','Curveball','Slider','Sweeper','Slurve','Changeup','Splitter','Screwball','Knuckleball'];
                            var presetValue = knownNames.includes(pitch.name) ? pitch.name : 'custom';
                        %>
                        <div class="pitch-section pitch-type-row">
                            <div class="pitch-section-header">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <select class="form-select pitch-preset" style="max-width:200px;">
                                        <option value="">-- Select a pitch --</option>
                                        <option value="Fastball|FB"              <%= presetValue === 'Fastball'           ? 'selected' : '' %>>Fastball (FB)</option>
                                        <option value="Two-Seam Fastball|2FB"    <%= presetValue === 'Two-Seam Fastball'  ? 'selected' : '' %>>Two-Seam Fastball (2FB)</option>
                                        <option value="Cutter|CUT"              <%= presetValue === 'Cutter'             ? 'selected' : '' %>>Cutter (CUT)</option>
                                        <option value="Sinker|SIN"              <%= presetValue === 'Sinker'             ? 'selected' : '' %>>Sinker (SIN)</option>
                                        <option value="Curveball|CB"            <%= presetValue === 'Curveball'          ? 'selected' : '' %>>Curveball (CB)</option>
                                        <option value="Slider|SL"               <%= presetValue === 'Slider'             ? 'selected' : '' %>>Slider (SL)</option>
                                        <option value="Sweeper|SWP"             <%= presetValue === 'Sweeper'            ? 'selected' : '' %>>Sweeper (SWP)</option>
                                        <option value="Slurve|SLV"              <%= presetValue === 'Slurve'             ? 'selected' : '' %>>Slurve (SLV)</option>
                                        <option value="Changeup|CH"             <%= presetValue === 'Changeup'           ? 'selected' : '' %>>Changeup (CH)</option>
                                        <option value="Splitter|SPL"            <%= presetValue === 'Splitter'           ? 'selected' : '' %>>Splitter (SPL)</option>
                                        <option value="Screwball|SCR"           <%= presetValue === 'Screwball'          ? 'selected' : '' %>>Screwball (SCR)</option>
                                        <option value="Knuckleball|KN"          <%= presetValue === 'Knuckleball'        ? 'selected' : '' %>>Knuckleball (KN)</option>
                                        <option value="custom|"                 <%= presetValue === 'custom'             ? 'selected' : '' %>>Custom</option>
                                    </select>
                                    <input type="text" class="form-control pitch-name fw-bold"
                                        name="pitcher[pitchTypes][<%= i %>][name]" value="<%= pitch.name %>"
                                        placeholder="Pitch name" style="max-width:160px;">
                                    <input type="text" class="form-control pitch-abbr"
                                        name="pitcher[pitchTypes][<%= i %>][abbreviation]"
                                        value="<%= pitch.abbreviation %>" placeholder="Abbr." style="max-width:80px;">
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-pitch">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <!-- VISUAL MODE -->
                            <div class="visual-view">
                                <div class="zone-container">
                                    <div class="zone-grid-wrapper" id="wrapper-<%= i %>">
                                        <div class="pitchers-view-label">Pitcher's View</div>
                                        <div class="zone-grid" id="grid-<%= i %>"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- LIST MODE -->
                            <div class="list-view" style="display:none;">
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <% for (var j = 0; j < pitch.locations.length; j++) { %>
                                        <% var loc = pitch.locations[j]; %>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input list-checkbox" type="checkbox"
                                                id="list-loc-<%= i %>-<%= j %>" data-pitch="<%= i %>"
                                                data-loc="<%= j %>" <%= loc.enabled ? 'checked' : '' %>>
                                            <label class="form-check-label badge p-2
                                                <%= loc.type === 'chase' ? 'bg-warning text-dark' : !loc.enabled ? 'bg-secondary' : 'bg-success' %>"
                                                for="list-loc-<%= i %>-<%= j %>">
                                                <%= loc.name %>
                                            </label>
                                        </div>
                                        <input type="hidden" name="pitcher[pitchTypes][<%= i %>][locations][<%= j %>][name]" value="<%= loc.name %>">
                                        <input type="hidden" name="pitcher[pitchTypes][<%= i %>][locations][<%= j %>][type]" value="<%= loc.type %>">
                                        <input type="hidden" id="enabled-<%= i %>-<%= j %>"
                                            name="pitcher[pitchTypes][<%= i %>][locations][<%= j %>][enabled]"
                                            value="<%= loc.enabled %>">
                                    <% } %>
                                </div>
                            </div>

                        </div>
                    <% } %>
                </div>

                <button type="button" class="btn btn-outline-secondary mb-4" id="addPitch">
                    <i class="bi bi-plus-circle"></i> Add Another Pitch
                </button>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>
                    <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>

    <script type="application/json" id="pitchDataJson"><%- JSON.stringify(pitcher.pitchTypes || []) %></script>
    <script>
        const throws = '<%= pitcher.throws %>';
        const isRHP = throws === 'R';

        const ZONE_LAYOUTS_A = {
            'arm-side':   { row: 1, col: isRHP ? 2 : 1, strike: true },
            'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true },
        };
        const ZONE_LAYOUTS_B = {
            'up':   { row: 1, col: 1, strike: true },
            'down': { row: 2, col: 1, strike: true },
        };
        const ZONE_LAYOUTS_C = {
            'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 },
            'up-out':         { row: 1, col: 2 },
            'arm-out-up':     { row: 1, col: isRHP ? 5 : 1 },
            'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
            'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true },
            'mid-up':         { row: 2, col: 3,              strike: true },
            'arm-up':         { row: 2, col: isRHP ? 4 : 2, strike: true },
            'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
            'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true },
            'mid-mid':        { row: 3, col: 3,              strike: true },
            'arm-mid':        { row: 3, col: isRHP ? 4 : 2, strike: true },
            'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true },
            'mid-down':       { row: 4, col: 3,              strike: true },
            'arm-down':       { row: 4, col: isRHP ? 4 : 2, strike: true },
            'glove-out-down': { row: 5, col: isRHP ? 1 : 5 },
            'down-out':       { row: 5, col: 2 },
            'arm-out-down':   { row: 5, col: isRHP ? 5 : 1 },
        };

        function getZoneLayouts(locations) {
            const names = new Set(locations.map(l => l.name));
            if (names.has('glove-up')) return ZONE_LAYOUTS_C;
            if (names.has('arm-side')) return ZONE_LAYOUTS_A;
            if (names.has('up'))       return ZONE_LAYOUTS_B;
            return ZONE_LAYOUTS_C;
        }

        const isZoneC = locations => new Set(locations.map(l => l.name)).has('glove-up');

        const pitchData = JSON.parse(document.getElementById('pitchDataJson').textContent);

        function getBoxClass(loc) {
            if (!loc.enabled) return 'disabled';
            if (loc.type === 'chase') return 'chase';
            return 'strike';
        }

        // ── Strike zone outline ───────────────────────────────────
        function drawOutline(pitchIndex) {
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            const cells = [...grid.querySelectorAll('[data-is-strike="true"]')];
            if (!cells.length) return;
            const gr = grid.getBoundingClientRect();
            let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
            cells.forEach(c => {
                const cr = c.getBoundingClientRect();
                t = Math.min(t, cr.top    - gr.top);
                l = Math.min(l, cr.left   - gr.left);
                b = Math.max(b, cr.bottom - gr.top);
                r = Math.max(r, cr.right  - gr.left);
            });
            const old = wrapper.querySelector('.strike-zone-outline');
            if (old) old.remove();
            const labelEl = wrapper.querySelector('.pitchers-view-label');
            const labelH  = labelEl ? labelEl.offsetHeight + 4 : 0;
            const outline = document.createElement('div');
            outline.className = 'strike-zone-outline';
            Object.assign(outline.style, {
                top: (t + labelH) + 'px', left: l + 'px',
                width: (r - l) + 'px', height: (b - t) + 'px'
            });
            wrapper.appendChild(outline);
        }

        // ── Chase overlays — matches game.ejs exactly ─────────────
        // hCells → overlay width/x   vCells → overlay height/y
        // covered → underlying cells that get pointer-events: none
        function drawOverlays(pitchIndex, pitch) {
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;

            // Clear previous overlays and covered flags
            wrapper.querySelectorAll('.chase-overlay').forEach(el => el.remove());
            grid.querySelectorAll('.loc-box.covered').forEach(el => el.classList.remove('covered'));

            if (!isZoneC(pitch.locations)) return;

            const gr      = grid.getBoundingClientRect();
            const labelEl = wrapper.querySelector('.pitchers-view-label');
            const labelH  = labelEl ? labelEl.offsetHeight + 4 : 0;

            const getCell = name => [...grid.querySelectorAll('.loc-box')]
                .find(el => el.dataset.locName === name);

            function spanBounds(names) {
                let t = Infinity, l = Infinity, r = -Infinity, b = -Infinity;
                names.forEach(name => {
                    const el = getCell(name);
                    if (!el) return;
                    const cr = el.getBoundingClientRect();
                    t = Math.min(t, cr.top    - gr.top);
                    l = Math.min(l, cr.left   - gr.left);
                    r = Math.max(r, cr.right  - gr.left);
                    b = Math.max(b, cr.bottom - gr.top);
                });
                return { t, l, r, b };
            }

            // hCells → overlay width/x   vCells → overlay height/y
            // covered → underlying cells that get pointer-events: none
            function makeOverlay(locName, label, hCells, vCells, covered) {
                if (!pitch.locations.find(z => z.name === locName)) return;
                const hb = spanBounds(hCells);
                const vb = spanBounds(vCells);
                if (!isFinite(hb.l) || !isFinite(vb.t)) return;

                const locIndex = pitch.locations.findIndex(l => l.name === locName);
                const loc      = pitch.locations[locIndex];
                const enabled  = loc ? loc.enabled : true;

                const el = document.createElement('div');
                el.className           = 'chase-overlay' + (enabled ? '' : ' disabled');
                el.textContent         = label;
                el.dataset.locName     = locName;
                el.dataset.pitchIndex  = pitchIndex;
                el.dataset.locIndex    = locIndex;
                Object.assign(el.style, {
                    top:    (vb.t + labelH) + 'px',
                    left:   hb.l + 'px',
                    width:  (hb.r - hb.l) + 'px',
                    height: (vb.b - vb.t) + 'px'
                });
                wrapper.appendChild(el);

                covered.forEach(name => {
                    const cell = getCell(name);
                    if (cell) cell.classList.add('covered');
                });
            }

            const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
            const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';
            const armCells     = isRHP ? ['arm-up',   'arm-mid',   'arm-down']   : ['glove-up', 'glove-mid', 'glove-down'];
            const gloveCells   = isRHP ? ['glove-up', 'glove-mid', 'glove-down'] : ['arm-up',   'arm-mid',   'arm-down'];

            // Strike cells are only used to MEASURE overlay dimensions — they don't
            // sit underneath the overlays, so nothing needs to be covered.
            makeOverlay('up-out',      'up out',
                ['arm-up', 'mid-up', 'glove-up'],       ['up-out'],   []);
            makeOverlay('down-out',    'down out',
                ['arm-down', 'mid-down', 'glove-down'],  ['down-out'], []);
            makeOverlay(armOutName,   isRHP ? 'arm out'   : 'glove out',
                [armOutName],   armCells,   []);
            makeOverlay(gloveOutName, isRHP ? 'glove out' : 'arm out',
                [gloveOutName], gloveCells, []);
        }

        // ── Build grid ────────────────────────────────────────────
        function buildGrid(pitchIndex) {
            const pitch = pitchData[pitchIndex];
            if (!pitch || !pitch.locations) return;
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;

            grid.innerHTML = '';
            wrapper.querySelectorAll('.chase-overlay, .strike-zone-outline').forEach(el => el.remove());

            const layout  = getZoneLayouts(pitch.locations);
            const maxRow  = Math.max(...Object.values(layout).map(p => (p.row || 1) + (p.rowSpan || 1) - 1));
            const maxCol  = Math.max(...Object.values(layout).map(p => (p.col || 1) + (p.colSpan || 1) - 1));
            const boxSize = window.innerWidth >= 992 ? 108 : window.innerWidth >= 576 ? 88 : 70;

            grid.style.gridTemplateRows    = `repeat(${maxRow}, ${boxSize}px)`;
            grid.style.gridTemplateColumns = `repeat(${maxCol}, ${boxSize}px)`;

            pitch.locations.forEach((loc, locIndex) => {
                const pos = layout[loc.name];
                if (!pos) return;
                const box = document.createElement('div');
                box.className        = `loc-box ${getBoxClass(loc)}`;
                box.textContent      = loc.name.replace(/-/g, ' ');
                box.dataset.locName  = loc.name;
                box.dataset.isStrike = pos.strike ? 'true' : 'false';
                box.dataset.pitch    = pitchIndex;
                box.dataset.loc      = locIndex;
                box.dataset.enabled  = loc.enabled;
                box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
                box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
                grid.appendChild(box);
            });

            requestAnimationFrame(() => {
                drawOutline(pitchIndex);
                drawOverlays(pitchIndex, pitch);
            });
        }

        // Build all grids on load; rebuild on resize
        pitchData.forEach((pitch, i) => buildGrid(i));
        window.addEventListener('resize', () => pitchData.forEach((pitch, i) => buildGrid(i)));

        // ── View toggle ───────────────────────────────────────────
        document.getElementById('visualMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'block');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'none');
            pitchData.forEach((p, i) => requestAnimationFrame(() => {
                drawOutline(i);
                drawOverlays(i, p);
            }));
        });
        document.getElementById('listMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'block');
        });

        // ── Click handler — overlay toggle ────────────────────────
        document.addEventListener('click', (e) => {
            // Chase overlay clicked — toggle that location's enabled state
            const overlay = e.target.closest('.chase-overlay');
            if (overlay) {
                const pitchIndex = parseInt(overlay.dataset.pitchIndex);
                const locIndex   = parseInt(overlay.dataset.locIndex);
                const pitch      = pitchData[pitchIndex];
                if (!pitch || locIndex < 0) return;

                const loc       = pitch.locations[locIndex];
                const newEnabled = !loc.enabled;
                loc.enabled = newEnabled;

                const enabledInput = document.getElementById(`enabled-${pitchIndex}-${locIndex}`);
                if (enabledInput) enabledInput.value = newEnabled;

                const checkbox = document.getElementById(`list-loc-${pitchIndex}-${locIndex}`);
                if (checkbox) checkbox.checked = newEnabled;

                overlay.classList.toggle('disabled', !newEnabled);

                // Also update the underlying cell class (even though it's covered)
                const grid = document.getElementById(`grid-${pitchIndex}`);
                const box  = grid ? [...grid.querySelectorAll('.loc-box')]
                    .find(el => el.dataset.locName === overlay.dataset.locName) : null;
                if (box) {
                    box.dataset.enabled = newEnabled;
                    box.classList.remove('strike', 'chase', 'disabled');
                    box.classList.add(newEnabled ? 'chase' : 'disabled');
                }
                return;
            }

            // Regular loc-box clicked — skip empty and covered cells
            const box = e.target.closest('.loc-box');
            if (!box || box.classList.contains('empty') || box.classList.contains('covered')) return;

            const pitchIdx   = box.dataset.pitch;
            const locIdx     = box.dataset.loc;
            const newEnabled = !(box.dataset.enabled === 'true');
            box.dataset.enabled = newEnabled;

            const typeInput = document.querySelector(`input[name="pitcher[pitchTypes][${pitchIdx}][locations][${locIdx}][type]"]`);
            const type = typeInput ? typeInput.value : '';
            box.classList.remove('strike', 'chase', 'disabled');
            if (!newEnabled)           box.classList.add('disabled');
            else if (type === 'chase') box.classList.add('chase');
            else                       box.classList.add('strike');

            const enabledInput = document.getElementById(`enabled-${pitchIdx}-${locIdx}`);
            if (enabledInput) enabledInput.value = newEnabled;

            const checkbox = document.getElementById(`list-loc-${pitchIdx}-${locIdx}`);
            if (checkbox) checkbox.checked = newEnabled;

            drawOverlays(parseInt(pitchIdx), pitchData[parseInt(pitchIdx)]);
        });

        // ── List checkbox change ───────────────────────────────────
        document.addEventListener('change', (e) => {
            const checkbox = e.target.closest('.list-checkbox');
            if (!checkbox) return;
            const pitchIdx  = checkbox.dataset.pitch;
            const locIdx    = checkbox.dataset.loc;
            const newEnabled = checkbox.checked;

            const enabledInput = document.getElementById(`enabled-${pitchIdx}-${locIdx}`);
            if (enabledInput) enabledInput.value = newEnabled;

            const box = document.querySelector(`.loc-box[data-pitch="${pitchIdx}"][data-loc="${locIdx}"]`);
            if (box) {
                box.dataset.enabled = newEnabled;
                const typeInput = document.querySelector(`input[name="pitcher[pitchTypes][${pitchIdx}][locations][${locIdx}][type]"]`);
                const type = typeInput ? typeInput.value : '';
                box.classList.remove('strike', 'chase', 'disabled');
                if (!newEnabled)           box.classList.add('disabled');
                else if (type === 'chase') box.classList.add('chase');
                else                       box.classList.add('strike');
            }
            drawOverlays(parseInt(pitchIdx), pitchData[parseInt(pitchIdx)]);
        });

        // ── Preset dropdown ───────────────────────────────────────
        const PRESETS_HTML = `
            <option value="">-- Select a pitch --</option>
            <option value="Fastball|FB">Fastball (FB)</option>
            <option value="Two-Seam Fastball|2FB">Two-Seam Fastball (2FB)</option>
            <option value="Cutter|CUT">Cutter (CUT)</option>
            <option value="Sinker|SIN">Sinker (SIN)</option>
            <option value="Curveball|CB">Curveball (CB)</option>
            <option value="Slider|SL">Slider (SL)</option>
            <option value="Sweeper|SWP">Sweeper (SWP)</option>
            <option value="Slurve|SLV">Slurve (SLV)</option>
            <option value="Changeup|CH">Changeup (CH)</option>
            <option value="Splitter|SPL">Splitter (SPL)</option>
            <option value="Screwball|SCR">Screwball (SCR)</option>
            <option value="Knuckleball|KN">Knuckleball (KN)</option>
            <option value="custom|">Custom</option>
        `;

        function applyPreset(select) {
            const row       = select.closest('.pitch-type-row');
            const nameInput = row.querySelector('.pitch-name');
            const abbrInput = row.querySelector('.pitch-abbr');
            const val = select.value;
            if (!val) return;
            if (val === 'custom|') {
                nameInput.value = '';
                abbrInput.value = '';
                nameInput.placeholder = 'Type pitch name';
                abbrInput.placeholder = 'Type abbr.';
                nameInput.focus();
            } else {
                const [name, abbr] = val.split('|');
                nameInput.value = name;
                abbrInput.value = abbr;
            }
        }

        document.getElementById('pitchTypes').addEventListener('change', (e) => {
            if (e.target.classList.contains('pitch-preset')) applyPreset(e.target);
        });

        // ── Add / remove pitch type rows ──────────────────────────
        let pitchCount = <%= pitcher.pitchTypes.length %>;
        document.getElementById('addPitch').addEventListener('click', () => {
            const container = document.getElementById('pitchTypes');
            const div = document.createElement('div');
            div.classList.add('pitch-section', 'pitch-type-row');
            div.innerHTML = `
        <div class="pitch-section-header">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <select class="form-select pitch-preset" style="max-width:200px;">${PRESETS_HTML}</select>
                <input type="text" class="form-control pitch-name fw-bold"
                    name="pitcher[pitchTypes][${pitchCount}][name]"
                    placeholder="Pitch name" style="max-width:160px;">
                <input type="text" class="form-control pitch-abbr"
                    name="pitcher[pitchTypes][${pitchCount}][abbreviation]"
                    placeholder="Abbr." style="max-width:80px;">
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm remove-pitch">
                <i class="bi bi-trash"></i>
            </button>
        </div>
        <p class="text-muted small">Save pitcher first to configure locations for new pitch types.</p>`;
            container.appendChild(div);
            pitchCount++;
        });

        document.getElementById('pitchTypes').addEventListener('click', (e) => {
            if (e.target.closest('.remove-pitch')) e.target.closest('.pitch-type-row').remove();
        });

        // ── Zone card & revert — POST via JS to avoid nested forms ───
        function postTo(url, body) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = url;
            Object.entries(body).forEach(([k, v]) => {
                const input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = k;
                input.value = v;
                form.appendChild(input);
            });
            document.body.appendChild(form);
            form.submit();
        }

        document.querySelectorAll('.zone-image-card-btn[data-zone-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                postTo(btn.dataset.zoneUrl, { zoneId: btn.dataset.zoneId });
            });
        });

        const revertBtn = document.getElementById('revertZoneBtn');
        if (revertBtn) {
            revertBtn.addEventListener('click', () => {
                postTo('/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/revert-zone', {});
            });
        }
    </script>
