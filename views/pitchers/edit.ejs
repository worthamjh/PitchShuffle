<%- layout('layouts/boilerplate') %>
    <style>
        .zone-grid {
            display: grid;
            gap: 0;
            margin: 0 auto;
            border: 2px solid #adb5bd;
        }
        .zone-grid {width: fit-content;}

        .loc-box {
            width: 70px;
            height: 70px;
            border-radius: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.55rem;
            font-weight: 700;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 4px;
            box-sizing: border-box;
            border: 1px solid rgba(0,0,0,0.12);
            transition: background-color 0.15s, border-color 0.15s;
            user-select: none;
            cursor: pointer;
        }

        @media (min-width: 576px) { .loc-box { width: 88px; height: 88px; font-size: 0.6rem; } }
        @media (min-width: 992px) { .loc-box { width: 108px; height: 108px; font-size: 0.7rem; } }

        .loc-box.strike   { background: var(--strike-bg); border-color: var(--strike-border); color: var(--strike-text); }
        .loc-box.chase    { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); }
        .loc-box.disabled { background: #e9ecef; border-color: #ced4da; color: #adb5bd; text-decoration: line-through; }
        .loc-box.empty    { background: transparent; border-color: transparent; cursor: default; pointer-events: none; }
        .loc-box.covered  { pointer-events: none; }
        .loc-box.anchor   { background: transparent !important; border-color: transparent !important; pointer-events: none; cursor: default; }

        .loc-box.strike:hover   { background: var(--strike-hover); border-color: var(--strike-border); }
        .loc-box.chase:hover    { background: var(--chase-hover); border-color: var(--chase-hover-border); }
        .loc-box.disabled:hover { background: #e9ecef; }
        .loc-box.empty:hover, .loc-box.covered:hover { background: inherit; }

        @media (min-width: 576px) { .loc-box, .chase-overlay { font-size: 0.6rem; } }
        @media (min-width: 992px) { .loc-box, .chase-overlay { font-size: 0.7rem; } }

        .chase-overlay {
            position: absolute; z-index: 5;
            background: var(--chase-bg); border: 1px solid var(--chase-border); color: var(--chase-text);
            font-size: 0.55rem; font-weight: 700; text-align: center;
            text-transform: uppercase; letter-spacing: 0.4px;
            display: flex; align-items: center; justify-content: center;
            box-sizing: border-box; cursor: pointer; user-select: none;
            transition: background-color 0.15s, border-color 0.15s;
        }
        .chase-overlay:hover          { background: var(--chase-hover); border-color: var(--chase-hover-border); }
        .chase-overlay.disabled       { background: #e9ecef; border-color: #ced4da; color: #adb5bd; text-decoration: line-through; }
        .chase-overlay.disabled:hover { background: #e9ecef; border-color: #ced4da; }

        .strike-zone-outline { position: absolute; pointer-events: none; border: 3px solid var(--ps-navy); z-index: 10; }
        .zone-grid-wrapper   { display: inline-block; position: relative; }
        .pitchers-view-label { text-align: center; font-size: 0.7rem; font-weight: 600; color: #6c757d; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .zone-container      { display: flex; justify-content: center; padding: 1rem 0; }
        .pitch-section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }

        .zone-image-card-btn {
            width: 100%; background: #fff; border: 2px solid #dee2e6; border-radius: 10px;
            padding: 0.75rem; cursor: pointer; text-align: center;
            transition: border-color 0.15s, box-shadow 0.15s; display: block;
        }
        .zone-image-card-btn:hover { border-color: #8fa8c8; box-shadow: 0 0 0 3px rgba(26,46,74,0.08); }
        .active-zone { border: 2px solid var(--ps-navy) !important; box-shadow: 0 0 0 3px rgba(26,46,74,0.15); background: #eef2f7; }
        .pitch-section { border: 1px solid #dee2e6; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; background: var(--ps-card-bg, #fff); }

        [data-theme="dark"] .loc-box.disabled  { background: #2a3f5a; border-color: #3a5070; color: #5a7a9a; }
        [data-theme="dark"] .chase-overlay.disabled { background: #2a3f5a; border-color: #3a5070; color: #5a7a9a; }
        [data-theme="dark"] .pitch-section { border-color: #2a3f5a; }
        [data-theme="dark"] .loc-box.strike  { background: var(--strike-bg); border-color: var(--strike-border); color: var(--strike-text); filter: brightness(0.6) saturate(0.9); }
        [data-theme="dark"] .loc-box.strike:hover { filter: brightness(0.8) saturate(1); }
        [data-theme="dark"] .loc-box.chase   { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); filter: brightness(0.6) saturate(0.9); }
        [data-theme="dark"] .loc-box.chase:hover  { filter: brightness(0.8) saturate(1); }
        [data-theme="dark"] .chase-overlay   { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); filter: brightness(0.6) saturate(0.9); }
        [data-theme="dark"] .chase-overlay:hover  { filter: brightness(0.8) saturate(1); }
        [data-theme="dark"] .zone-image-card-btn  { background: #1a2535; border-color: #2a3f5a; color: var(--ps-text); }
        .pitch-type-row { margin-left: -1rem; margin-right: -1rem; border-radius: 0; border-left: none; border-right: none; }
    </style>

    <%
        const _userTerm    = (user && user.preferences && user.preferences.zoneTerminology) ? user.preferences.zoneTerminology : 'arm-glove';
        const _pitcherTerm = pitcher.zone && pitcher.zone.terminology ? pitcher.zone.terminology : null;
        const _termMismatch = _pitcherTerm && _pitcherTerm !== 'both' && _pitcherTerm !== _userTerm;
        const _pitcherTermLabel = _pitcherTerm === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
        const _userTermLabel    = _userTerm    === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
    %>
    <% if (_termMismatch) { %>
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div>
                <strong>Zone terminology mismatch:</strong> This pitcher's locations are saved as <strong><%= _pitcherTermLabel %></strong> zones, but your preference is now <strong><%= _userTermLabel %></strong>.
                <br>To switch, <strong>select a new strike zone below and save</strong> &mdash; this will reset all pitch locations to <strong><%= _userTermLabel %></strong> terminology.
            </div>
        </div>
    <% } %>

    <div class="page-header">
        <div class="small fw-semibold mb-1 opacity-75"><i class="bi bi-pencil"></i> Edit</div>
        <h1 class="mb-2"><%= pitcher.firstName ? pitcher.firstName + ' ' + pitcher.lastName : (pitcher.lastName || pitcher.name) %> #<%= pitcher.number %></h1>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/teams/<%= team._id %>" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> Back to Team</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body px-3 pt-3">
            <form action="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>?_method=PUT" method="POST" id="pitcherForm">

                <h5 class="fw-bold mb-3">Basic Info</h5>
                <div class="row mb-3">
                    <div class="col-md-3 mb-3 mb-md-0">
                        <label for="firstName" class="form-label fw-bold">First Name</label>
                        <input type="text" class="form-control form-control-lg" id="firstName" name="pitcher[firstName]" value="<%= pitcher.firstName || '' %>">
                    </div>
                    <div class="col-md-3 mb-3 mb-md-0">
                        <label for="lastName" class="form-label fw-bold">Last Name</label>
                        <input type="text" class="form-control form-control-lg" id="lastName" name="pitcher[lastName]" value="<%= pitcher.lastName || pitcher.name || '' %>" required>
                    </div>
                    <div class="col-md-3 mb-3 mb-md-0">
                        <label for="number" class="form-label fw-bold">Jersey #</label>
                        <input type="number" class="form-control form-control-lg" id="number" name="pitcher[number]" value="<%= pitcher.number %>">
                    </div>
                    <div class="col-md-3">
                        <label for="throws" class="form-label fw-bold">Throws</label>
                        <select class="form-select form-select-lg" id="throws" name="pitcher[throws]">
                            <option value="R" <%= pitcher.throws === 'R' ? 'selected' : '' %>>Right</option>
                            <option value="L" <%= pitcher.throws === 'L' ? 'selected' : '' %>>Left</option>
                        </select>
                    </div>
                </div>

                <h5 class="fw-bold mb-3 mt-4">Strike Zone</h5>
                <% if (pitcher.previousZone) { %>
                    <div class="alert d-flex align-items-center justify-content-between gap-2 mb-3" style="background:#eef2f7;border:1px solid #c0cfe0;border-radius:10px;padding:0.75rem 1rem;">
                        <span><i class="bi bi-arrow-counterclockwise me-1"></i> Zone changed — your previous location settings are saved.</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="revertZoneBtn">Revert to Previous Zone</button>
                    </div>
                <% } %>

                <div class="mb-4">
                    <div class="row row-cols-1 row-cols-md-3 g-3">
                        <%
                            const _userTerminology = (user && user.preferences && user.preferences.zoneTerminology) ? user.preferences.zoneTerminology : 'arm-glove';
                            const _filteredZones = zones.filter(z => z.terminology === _userTerminology || z.terminology === 'both').sort((a,b) => a.name.localeCompare(b.name));
                        %>
                        <% for (let zone of _filteredZones) { %>
                            <% const isSelected = pitcher.zone && pitcher.zone._id.equals(zone._id); %>
                            <%
                                const _zoneImageMap = { 'A': 'zone_a.png', 'B': 'zone_b.png', 'C': 'zone_c.png', 'D': 'zone_d.png' };
                                const _zoneLetter   = zone.name.match(/Zone ([A-Z])/)?.[1];
                                const _zoneImg      = _zoneImageMap[_zoneLetter] || null;
                                const _zoneLabel    = _zoneLetter ? 'Zone ' + _zoneLetter : zone.name;
                            %>
                            <div class="col">
                                <% if (isSelected) { %>
                                    <div class="zone-image-card active-zone">
                                        <% if (_zoneImg) { %><img src="/images/<%= _zoneImg %>" alt="<%= zone.name %>" style="width:80px;height:80px;object-fit:contain;"><% } %>
                                        <div class="zone-card-label"><%= _zoneLabel %><small><%= zone.availableLocations.length %> locations</small></div>
                                    </div>
                                <% } else { %>
                                    <button type="button" class="zone-image-card zone-image-card-btn" data-zone-id="<%= zone._id %>" data-zone-url="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/change-zone">
                                        <% if (_zoneImg) { %><img src="/images/<%= _zoneImg %>" alt="<%= zone.name %>" style="width:80px;height:80px;object-fit:contain;"><% } %>
                                        <div class="zone-card-label"><%= _zoneLabel %><small><%= zone.availableLocations.length %> locations</small></div>
                                    </button>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                    <input type="hidden" name="pitcher[zone]" value="<%= pitcher.zone ? pitcher.zone._id : '' %>">
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                    <h5 class="fw-bold mb-0">Pitch Types & Locations</h5>
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="viewMode" id="visualMode" checked>
                        <label class="btn btn-outline-primary btn-sm" for="visualMode"><i class="bi bi-grid-3x3"></i> Visual</label>
                        <input type="radio" class="btn-check" name="viewMode" id="listMode">
                        <label class="btn btn-outline-primary btn-sm" for="listMode"><i class="bi bi-list-check"></i> List</label>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;background:var(--strike-bg);border:2px solid var(--strike-border);display:inline-block;"></span><small>Strike location</small></span>
                    <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;background:var(--chase-bg);border:2px solid var(--chase-border);display:inline-block;"></span><small>Chase</small></span>
                    <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;background:#e9ecef;border:2px solid #ced4da;display:inline-block;"></span><small>Disabled</small></span>
                    <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;border:3px solid var(--ps-navy);display:inline-block;"></span><small>Strike zone boundary</small></span>
                </div>

                <div id="pitchTypes">
                    <% for (var i = 0; i < pitcher.pitchTypes.length; i++) { %>
                        <% var pitch = pitcher.pitchTypes[i]; %>
                        <% var knownNames = team.sport === 'softball' ? ['Fastball','Riseball','Dropball','Curveball','Changeup','Screwball','Drop Curve','Offspeed'] : ['Fastball','Two-Seam Fastball','Cutter','Sinker','Curveball','Slider','Sweeper','Slurve','Changeup','Splitter','Screwball','Knuckleball']; %>
                        <div class="pitch-section pitch-type-row">
                            <div class="pitch-section-header">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <select class="form-select pitch-preset" style="max-width:200px;">
                                        <%- include('../partials/pitch-presets', { sport: team.sport, currentName: pitch.name }) %>
                                    </select>
                                    <input type="text" class="form-control pitch-name fw-bold" name="pitcher[pitchTypes][<%= i %>][name]" value="<%= pitch.name %>" placeholder="Pitch name" style="max-width:160px;">
                                    <input type="text" class="form-control pitch-abbr" name="pitcher[pitchTypes][<%= i %>][abbreviation]" value="<%= pitch.abbreviation %>" placeholder="Abbr." style="max-width:80px;">
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-pitch"><i class="bi bi-trash"></i></button>
                            </div>
                            <div class="visual-view">
                                <div class="zone-container">
                                    <div class="zone-grid-wrapper" id="wrapper-<%= i %>">
                                        <div class="pitchers-view-label">Pitcher's View</div>
                                        <div class="zone-grid" id="grid-<%= i %>"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="list-view" style="display:none;">
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <% for (var j = 0; j < pitch.locations.length; j++) { %>
                                        <% var loc = pitch.locations[j]; %>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input list-checkbox" type="checkbox" id="list-loc-<%= i %>-<%= j %>" data-pitch="<%= i %>" data-loc="<%= j %>" <%= loc.enabled ? 'checked' : '' %>>
                                            <label class="form-check-label badge p-2 <%= loc.type === 'chase' ? 'bg-warning text-dark' : !loc.enabled ? 'bg-secondary' : 'bg-success' %>" for="list-loc-<%= i %>-<%= j %>"><%= loc.name %></label>
                                        </div>
                                        <input type="hidden" name="pitcher[pitchTypes][<%= i %>][locations][<%= j %>][name]" value="<%= loc.name %>">
                                        <input type="hidden" name="pitcher[pitchTypes][<%= i %>][locations][<%= j %>][type]" value="<%= loc.type %>">
                                        <input type="hidden" id="enabled-<%= i %>-<%= j %>" name="pitcher[pitchTypes][<%= i %>][locations][<%= j %>][enabled]" value="<%= loc.enabled %>">
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <button type="button" class="btn btn-outline-secondary mb-4" id="addPitch"><i class="bi bi-plus-circle"></i> Add Another Pitch</button>

                <div class="d-flex gap-2 flex-shrink-0">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-circle"></i> Save Changes</button>
                    <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>" class="btn btn-outline-secondary btn-lg"><i class="bi bi-x-circle"></i> Cancel</a>
                </div>

            </form>
        </div>
    </div>

    <script type="application/json" id="pitchDataJson"><%- JSON.stringify(pitcher.pitchTypes || []) %></script>
    <script type="application/json" id="zoneDataJson"><%- JSON.stringify(pitcher.zone ? pitcher.zone.availableLocations : []) %></script>
    <script>
        const throws = '<%= pitcher.throws %>';
        const isRHP = throws === 'R';

        const ZONE_LAYOUTS_A = { 'arm-side': { row: 1, col: isRHP ? 2 : 1, strike: true }, 'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true } };
        const ZONE_LAYOUTS_B = { 'up': { row: 1, col: 1, strike: true }, 'down': { row: 2, col: 1, strike: true } };
        const ZONE_LAYOUTS_C = {
            'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 }, 'up-out': { row: 1, col: 2 }, 'arm-out-up': { row: 1, col: isRHP ? 5 : 1 },
            'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
            'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true }, 'mid-up':  { row: 2, col: 3, strike: true }, 'arm-up':   { row: 2, col: isRHP ? 4 : 2, strike: true },
            'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
            'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true }, 'mid-mid': { row: 3, col: 3, strike: true }, 'arm-mid':  { row: 3, col: isRHP ? 4 : 2, strike: true },
            'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true }, 'mid-down':{ row: 4, col: 3, strike: true }, 'arm-down': { row: 4, col: isRHP ? 4 : 2, strike: true },
            'glove-out-down': { row: 5, col: isRHP ? 1 : 5 }, 'down-out': { row: 5, col: 2 }, 'arm-out-down': { row: 5, col: isRHP ? 5 : 1 },
        };
        const ZONE_LAYOUTS_D = {
            'up-out':     { row: 1, col: 2, colSpan: 2, anchor: true },
            'glove-out':  { row: 2, col: isRHP ? 1 : 4, rowSpan: 2, anchor: true },
            'glove-up':   { row: 2, col: isRHP ? 2 : 3, strike: true },
            'arm-up':     { row: 2, col: isRHP ? 3 : 2, strike: true },
            'arm-out':    { row: 2, col: isRHP ? 4 : 1, rowSpan: 2, anchor: true },
            'glove-down': { row: 3, col: isRHP ? 2 : 3, strike: true },
            'arm-down':   { row: 3, col: isRHP ? 3 : 2, strike: true },
            'down-out':   { row: 4, col: 2, colSpan: 2, anchor: true },
        };
        const ZONE_LAYOUTS_A_IA = { 'away-side': { row: 1, col: 1, strike: true }, 'inside-side': { row: 1, col: 2, strike: true } };
        const ZONE_LAYOUTS_C_IA = {
            'away-out-up': { row: 1, col: 1 }, 'up-out': { row: 1, col: 2 }, 'inside-out-up': { row: 1, col: 5 },
            'away-out-mid': { row: 2, col: 1, rowSpan: 3 },
            'away-up': { row: 2, col: 2, strike: true }, 'mid-up': { row: 2, col: 3, strike: true }, 'inside-up': { row: 2, col: 4, strike: true },
            'inside-out-mid': { row: 2, col: 5, rowSpan: 3 },
            'away-mid': { row: 3, col: 2, strike: true }, 'mid-mid': { row: 3, col: 3, strike: true }, 'inside-mid': { row: 3, col: 4, strike: true },
            'away-down': { row: 4, col: 2, strike: true }, 'mid-down': { row: 4, col: 3, strike: true }, 'inside-down': { row: 4, col: 4, strike: true },
            'away-out-down': { row: 5, col: 1 }, 'down-out': { row: 5, col: 2 }, 'inside-out-down': { row: 5, col: 5 },
        };
        const ZONE_LAYOUTS_D_IA = {
            'up-out':      { row: 1, col: 2, colSpan: 2, anchor: true },
            'away-out':    { row: 2, col: 1, rowSpan: 2, anchor: true },
            'away-up':     { row: 2, col: 2, strike: true },
            'inside-up':   { row: 2, col: 3, strike: true },
            'inside-out':  { row: 2, col: 4, rowSpan: 2, anchor: true },
            'away-down':   { row: 3, col: 2, strike: true },
            'inside-down': { row: 3, col: 3, strike: true },
            'down-out':    { row: 4, col: 2, colSpan: 2, anchor: true },
        };

        function getZoneLayouts(locations) {
            const names = new Set(locations.map(l => l.name));
            if (names.has('mid-up') && names.has('glove-up'))  return ZONE_LAYOUTS_C;
            if (names.has('mid-up') && names.has('inside-up')) return ZONE_LAYOUTS_C_IA;
            if (names.has('glove-up') && names.has('arm-up'))  return ZONE_LAYOUTS_D;
            if (names.has('away-up') && names.has('inside-up'))return ZONE_LAYOUTS_D_IA;
            if (names.has('arm-side'))    return ZONE_LAYOUTS_A;
            if (names.has('inside-side')) return ZONE_LAYOUTS_A_IA;
            if (names.has('up'))          return ZONE_LAYOUTS_B;
            return ZONE_LAYOUTS_C;
        }

        const usesOverlays = locations => {
            const names = new Set(locations.map(l => l.name));
            return names.has('glove-up') || names.has('inside-up') || names.has('away-up');
        };
        const isZoneD = locations => {
            const names = new Set(locations.map(l => l.name));
            return (names.has('glove-up') || names.has('away-up')) && !names.has('mid-up');
        };

        const pitchData = JSON.parse(document.getElementById('pitchDataJson').textContent);
        const zoneLocations = JSON.parse(document.getElementById('zoneDataJson').textContent);

        function getBoxClass(loc) {
            if (!loc.enabled) return 'disabled';
            if (loc.type === 'chase') return 'chase';
            return 'strike';
        }

        function drawOutline(pitchIndex) {
            const grid = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            const cells = [...grid.querySelectorAll('[data-is-strike="true"]')];
            if (!cells.length) return;
            const gr = grid.getBoundingClientRect();
            let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
            cells.forEach(c => {
                const cr = c.getBoundingClientRect();
                t = Math.min(t, cr.top - gr.top); l = Math.min(l, cr.left - gr.left);
                b = Math.max(b, cr.bottom - gr.top); r = Math.max(r, cr.right - gr.left);
            });
            const old = wrapper.querySelector('.strike-zone-outline');
            if (old) old.remove();
            const labelEl = wrapper.querySelector('.pitchers-view-label');
            const labelH  = labelEl ? labelEl.offsetHeight + 4 : 0;
            const outline = document.createElement('div');
            outline.className = 'strike-zone-outline';
            Object.assign(outline.style, { top: (t + labelH) + 'px', left: l + 'px', width: (r - l) + 'px', height: (b - t) + 'px' });
            wrapper.appendChild(outline);
        }

        function drawOverlays(pitchIndex, pitch) {
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            wrapper.querySelectorAll('.chase-overlay').forEach(el => el.remove());
            grid.querySelectorAll('.loc-box.covered').forEach(el => el.classList.remove('covered'));
            if (!usesOverlays(pitch.locations)) return;
            const gr      = grid.getBoundingClientRect();
            const labelEl = wrapper.querySelector('.pitchers-view-label');
            const labelH  = labelEl ? labelEl.offsetHeight + 4 : 0;
            const getCell = name => [...grid.querySelectorAll('.loc-box')].find(el => el.dataset.locName === name);
            function spanBounds(names) {
                let t = Infinity, l = Infinity, r = -Infinity, b = -Infinity;
                names.forEach(name => {
                    const el = getCell(name); if (!el) return;
                    const cr = el.getBoundingClientRect();
                    t = Math.min(t, cr.top - gr.top); l = Math.min(l, cr.left - gr.left);
                    r = Math.max(r, cr.right - gr.left); b = Math.max(b, cr.bottom - gr.top);
                });
                return { t, l, r, b };
            }
            function makeOverlay(locName, label, hCells, vCells, covered) {
                if (!pitch.locations.find(z => z.name === locName)) return;
                const hb = spanBounds(hCells); const vb = spanBounds(vCells);
                if (!isFinite(hb.l) || !isFinite(vb.t)) return;
                const locIndex = pitch.locations.findIndex(l => l.name === locName);
                const loc = pitch.locations[locIndex];
                const el = document.createElement('div');
                el.className = 'chase-overlay' + (loc && !loc.enabled ? ' disabled' : '');
                el.textContent = label; el.dataset.locName = locName;
                el.dataset.pitchIndex = pitchIndex; el.dataset.locIndex = locIndex;
                Object.assign(el.style, { top: (vb.t + labelH) + 'px', left: hb.l + 'px', width: (hb.r - hb.l) + 'px', height: (vb.b - vb.t) + 'px' });
                wrapper.appendChild(el);
                covered.forEach(name => { const cell = getCell(name); if (cell) cell.classList.add('covered'); });
            }

            const locNames     = new Set(pitch.locations.map(l => l.name));
            const isInsideAway = locNames.has('inside-up') || locNames.has('inside-down');

            if (isZoneD(pitch.locations)) {
                    if (isInsideAway) {
                        makeOverlay('up-out',     'up out',   ['corner-top-glove','away-up','inside-up','corner-top-arm'],     ['up-out'],   ['up-out']);
                        makeOverlay('down-out',   'down out', ['corner-bot-glove','away-down','inside-down','corner-bot-arm'], ['down-out'], ['down-out']);
                        makeOverlay('away-out',   'away out',   ['away-out'],  ['away-up','away-down'],     []);
                        makeOverlay('inside-out', 'inside out', ['inside-out'],['inside-up','inside-down'], []);
                    } else {
                        makeOverlay('up-out',    'up out',   ['corner-top-glove','glove-up','arm-up','corner-top-arm'],     ['up-out'],   ['up-out']);
                        makeOverlay('down-out',  'down out', ['corner-bot-glove','glove-down','arm-down','corner-bot-arm'], ['down-out'], ['down-out']);
                        makeOverlay('glove-out', 'glove out', ['glove-out'], ['glove-up', 'glove-down'], []);
                        makeOverlay('arm-out',   'arm out',   ['arm-out'],   ['arm-up', 'arm-down'], []);
                    }
                } else {
                if (isInsideAway) {
                    makeOverlay('up-out',         'up out',     ['inside-up', 'mid-up', 'away-up'],         ['up-out'],   []);
                    makeOverlay('down-out',       'down out',   ['inside-down', 'mid-down', 'away-down'],    ['down-out'], []);
                    makeOverlay('inside-out-mid', 'inside out', ['inside-out-mid'], ['inside-up', 'inside-mid', 'inside-down'], []);
                    makeOverlay('away-out-mid',   'away out',   ['away-out-mid'],   ['away-up', 'away-mid', 'away-down'],       []);
                } else {
                    const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
                    const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';
                    const armCells     = isRHP ? ['arm-up','arm-mid','arm-down']       : ['glove-up','glove-mid','glove-down'];
                    const gloveCells   = isRHP ? ['glove-up','glove-mid','glove-down'] : ['arm-up','arm-mid','arm-down'];
                    makeOverlay('up-out',      'up out',   ['arm-up','mid-up','glove-up'],       ['up-out'],   []);
                    makeOverlay('down-out',    'down out', ['arm-down','mid-down','glove-down'],  ['down-out'], []);
                    makeOverlay(armOutName,   isRHP ? 'arm out'   : 'glove out', [armOutName],   armCells,   []);
                    makeOverlay(gloveOutName, isRHP ? 'glove out' : 'arm out',  [gloveOutName], gloveCells, []);
                }
            }
        }
       function buildGrid(pitchIndex) {
            const pitch = pitchData[pitchIndex];
            if (!pitch || !pitch.locations) return;
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            grid.innerHTML = '';
            wrapper.querySelectorAll('.chase-overlay, .strike-zone-outline').forEach(el => el.remove());
            const layout  = getZoneLayouts(pitch.locations);
            const maxRow  = Math.max(...Object.values(layout).map(p => (p.row || 1) + (p.rowSpan || 1) - 1));
            const maxCol  = Math.max(...Object.values(layout).map(p => (p.col || 1) + (p.colSpan || 1) - 1));
            let boxSize = window.innerWidth >= 992 ? 108 : window.innerWidth >= 576 ? 88 : 70;
            if (maxRow <= 2) boxSize = Math.min(boxSize, 120);
            grid.style.gridTemplateRows    = `repeat(${maxRow}, ${boxSize}px)`;
            grid.style.gridTemplateColumns = `repeat(${maxCol}, ${boxSize}px)`;
            pitch.locations.forEach((loc, locIndex) => {
                const pos = layout[loc.name]; if (!pos) return;
                const box = document.createElement('div');
                const cls = pos.anchor ? 'anchor' : getBoxClass(loc);
                box.className        = `loc-box ${cls}`;
                box.textContent      = pos.anchor ? '' : loc.name.replace(/-/g, ' ');
                box.dataset.locName  = loc.name;
                box.dataset.isStrike = pos.strike ? 'true' : 'false';
                box.dataset.pitch    = pitchIndex;
                box.dataset.loc      = locIndex;
                box.dataset.enabled  = loc.enabled;
                box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
                box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
                grid.appendChild(box);
            });

    // Inject Zone D corner fillers BEFORE paint so spanBounds can measure them
                if (isZoneD(pitch.locations)) {
                    const upOut   = pitch.locations.find(l => l.name === 'up-out');
                    const downOut = pitch.locations.find(l => l.name === 'down-out');
                    const upCls   = (upOut   && !upOut.enabled)   ? 'loc-box disabled' : 'loc-box chase';
                    const downCls = (downOut && !downOut.enabled)  ? 'loc-box disabled' : 'loc-box chase';
                    [
                    { row: 1, col: isRHP ? 1 : 4, cls: upCls,   name: 'corner-top-arm'   },
                    { row: 1, col: isRHP ? 4 : 1, cls: upCls,   name: 'corner-top-glove' },
                    { row: 4, col: isRHP ? 1 : 4, cls: downCls, name: 'corner-bot-arm'   },
                    { row: 4, col: isRHP ? 4 : 1, cls: downCls, name: 'corner-bot-glove' },
                    ].forEach(pos => {
                        const filler = document.createElement('div');
                        filler.className        = pos.cls;
                        filler.dataset.locName  = pos.name;
                        filler.style.gridRow    = String(pos.row);
                        filler.style.gridColumn = String(pos.col);
                        filler.style.pointerEvents = 'none';
                        filler.style.cursor     = 'default';
                        grid.appendChild(filler);
                    });
                }

            requestAnimationFrame(() => { drawOutline(pitchIndex); drawOverlays(pitchIndex, pitch); });
        }

        pitchData.forEach((pitch, i) => buildGrid(i));
        window.addEventListener('resize', () => pitchData.forEach((pitch, i) => buildGrid(i)));

        function reindexRows() {
            document.querySelectorAll('.pitch-type-row').forEach((row, newIdx) => {
                const grid    = row.querySelector('.zone-grid');
                const wrapper = row.querySelector('.zone-grid-wrapper');
                if (!grid) return;
                const oldIdx = parseInt(grid.id.replace('grid-', ''));
                if (oldIdx === newIdx) return;
                grid.id = `grid-${newIdx}`; wrapper.id = `wrapper-${newIdx}`;
                grid.querySelectorAll('.loc-box').forEach(c => { c.dataset.pitch = newIdx; });
                wrapper.querySelectorAll('.chase-overlay').forEach(el => { el.dataset.pitchIndex = newIdx; });
                const re = new RegExp(`\\[pitchTypes\\]\\[${oldIdx}\\]`, 'g');
                row.querySelectorAll('[name]').forEach(el => { el.name = el.name.replace(re, `[pitchTypes][${newIdx}]`); });
                row.querySelectorAll('input[id^="enabled-"]').forEach(inp => { const locIdx = inp.id.split('-')[2]; inp.id = `enabled-${newIdx}-${locIdx}`; });
                row.querySelectorAll('.list-checkbox').forEach(cb => { const locIdx = cb.dataset.loc; cb.id = `list-loc-${newIdx}-${locIdx}`; cb.dataset.pitch = newIdx; });
                row.querySelectorAll('label[for^="list-loc-"]').forEach(lbl => { const locIdx = lbl.htmlFor.split('-')[3]; lbl.htmlFor = `list-loc-${newIdx}-${locIdx}`; });
                const select = row.querySelector('.pitch-preset'), nameInput = row.querySelector('.pitch-name');
                if (select && nameInput) {
                    const currentName = nameInput.value.trim();
                    const matchingOpt = [...select.options].find(o => o.value.split('|')[0] === currentName);
                    if (matchingOpt) select.value = matchingOpt.value;
                    else if (currentName) { const customOpt = [...select.options].find(o => o.value === 'custom|'); if (customOpt) select.value = 'custom|'; }
                    else select.value = '';
                }
                drawOutline(newIdx); drawOverlays(newIdx, pitchData[newIdx]);
            });
        }

        document.getElementById('visualMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'block');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'none');
            pitchData.forEach((p, i) => requestAnimationFrame(() => { drawOutline(i); drawOverlays(i, p); }));
        });
        document.getElementById('listMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'block');
        });

        document.addEventListener('click', (e) => {
            const overlay = e.target.closest('.chase-overlay');
            if (overlay) {
                const pitchIndex = parseInt(overlay.dataset.pitchIndex);
                const locIndex   = parseInt(overlay.dataset.locIndex);
                const pitch = pitchData[pitchIndex];
                if (!pitch || locIndex < 0) return;
                const loc = pitch.locations[locIndex];
                const newEnabled = !loc.enabled;
                loc.enabled = newEnabled;
                const enabledInput = document.getElementById(`enabled-${pitchIndex}-${locIndex}`);
                if (enabledInput) enabledInput.value = newEnabled;
                const checkbox = document.getElementById(`list-loc-${pitchIndex}-${locIndex}`);
                if (checkbox) checkbox.checked = newEnabled;
                overlay.classList.toggle('disabled', !newEnabled);
                const grid = document.getElementById(`grid-${pitchIndex}`);
                const box  = grid ? [...grid.querySelectorAll('.loc-box')].find(el => el.dataset.locName === overlay.dataset.locName) : null;
                if (box) { box.dataset.enabled = newEnabled; box.classList.remove('strike','chase','disabled'); box.classList.add(newEnabled ? 'chase' : 'disabled'); }
                return;
            }
            const box = e.target.closest('.loc-box');
            if (!box || box.classList.contains('empty') || box.classList.contains('covered') || box.classList.contains('anchor')) return;
            const pitchIdx  = box.dataset.pitch;
            const locIdx    = box.dataset.loc;
            const newEnabled = !(box.dataset.enabled === 'true');
            box.dataset.enabled = newEnabled;
            const typeInput = document.querySelector(`input[name="pitcher[pitchTypes][${pitchIdx}][locations][${locIdx}][type]"]`);
            const type = typeInput ? typeInput.value : '';
            box.classList.remove('strike','chase','disabled');
            if (!newEnabled) box.classList.add('disabled');
            else if (type === 'chase') box.classList.add('chase');
            else box.classList.add('strike');
            const enabledInput = document.getElementById(`enabled-${pitchIdx}-${locIdx}`);
            if (enabledInput) enabledInput.value = newEnabled;
            const checkbox = document.getElementById(`list-loc-${pitchIdx}-${locIdx}`);
            if (checkbox) checkbox.checked = newEnabled;
            drawOverlays(parseInt(pitchIdx), pitchData[parseInt(pitchIdx)]);
        });

        document.addEventListener('change', (e) => {
            const checkbox = e.target.closest('.list-checkbox');
            if (!checkbox) return;
            const pitchIdx  = checkbox.dataset.pitch;
            const locIdx    = checkbox.dataset.loc;
            const newEnabled = checkbox.checked;
            const enabledInput = document.getElementById(`enabled-${pitchIdx}-${locIdx}`);
            if (enabledInput) enabledInput.value = newEnabled;
            const box = document.querySelector(`.loc-box[data-pitch="${pitchIdx}"][data-loc="${locIdx}"]`);
            if (box) {
                box.dataset.enabled = newEnabled;
                const typeInput = document.querySelector(`input[name="pitcher[pitchTypes][${pitchIdx}][locations][${locIdx}][type]"]`);
                const type = typeInput ? typeInput.value : '';
                box.classList.remove('strike','chase','disabled');
                if (!newEnabled) box.classList.add('disabled');
                else if (type === 'chase') box.classList.add('chase');
                else box.classList.add('strike');
            }
            drawOverlays(parseInt(pitchIdx), pitchData[parseInt(pitchIdx)]);
        });

        const PRESETS_HTML = `<%- team.sport === 'softball'
            ? '<option value="">-- Select a pitch --</option><option value="Fastball|FB">Fastball (FB)</option><option value="Riseball|RB">Riseball (RB)</option><option value="Dropball|DB">Dropball (DB)</option><option value="Curveball|CB">Curveball (CB)</option><option value="Changeup|CH">Changeup (CH)</option><option value="Screwball|SCR">Screwball (SCR)</option><option value="Drop Curve|DC">Drop Curve (DC)</option><option value="Offspeed|OS">Offspeed (OS)</option><option value="custom|">Custom</option>'
            : '<option value="">-- Select a pitch --</option><option value="Fastball|FB">Fastball (FB)</option><option value="Two-Seam Fastball|2FB">Two-Seam Fastball (2FB)</option><option value="Cutter|CUT">Cutter (CUT)</option><option value="Sinker|SIN">Sinker (SIN)</option><option value="Curveball|CB">Curveball (CB)</option><option value="Slider|SL">Slider (SL)</option><option value="Sweeper|SWP">Sweeper (SWP)</option><option value="Slurve|SLV">Slurve (SLV)</option><option value="Changeup|CH">Changeup (CH)</option><option value="Splitter|SPL">Splitter (SPL)</option><option value="Screwball|SCR">Screwball (SCR)</option><option value="Knuckleball|KN">Knuckleball (KN)</option><option value="custom|">Custom</option>'
        %>`;

        function applyPreset(select) {
            const row = select.closest('.pitch-type-row');
            const nameInput = row.querySelector('.pitch-name'), abbrInput = row.querySelector('.pitch-abbr');
            const val = select.value; if (!val) return;
            if (val === 'custom|') { nameInput.value = ''; abbrInput.value = ''; nameInput.placeholder = 'Type pitch name'; abbrInput.placeholder = 'Type abbr.'; nameInput.focus(); }
            else { const [name, abbr] = val.split('|'); nameInput.value = name; abbrInput.value = abbr; }
        }
        document.getElementById('pitchTypes').addEventListener('change', (e) => { if (e.target.classList.contains('pitch-preset')) applyPreset(e.target); });

        let pitchCount = <%= pitcher.pitchTypes.length %>;
        document.getElementById('addPitch').addEventListener('click', () => {
            const rows = document.querySelectorAll('.pitch-type-row');
            if (rows.length >= 8) { const btn = document.getElementById('addPitch'); btn.disabled = true; btn.innerHTML = '<i class="bi bi-slash-circle"></i> Maximum 8 pitches reached'; return; }
            const container = document.getElementById('pitchTypes');
            const div = document.createElement('div');
            div.classList.add('pitch-section', 'pitch-type-row');
            const locInputs = zoneLocations.map((loc, j) => `
                <input type="hidden" name="pitcher[pitchTypes][${pitchCount}][locations][${j}][name]" value="${loc.name}">
                <input type="hidden" name="pitcher[pitchTypes][${pitchCount}][locations][${j}][type]" value="${loc.type}">
                <input type="hidden" id="enabled-${pitchCount}-${j}" name="pitcher[pitchTypes][${pitchCount}][locations][${j}][enabled]" value="true">
            `).join('');
            const listChecks = zoneLocations.map((loc, j) => {
                const badgeClass = loc.type === 'chase' ? 'bg-warning text-dark' : 'bg-success';
                return `<div class="form-check form-check-inline"><input class="form-check-input list-checkbox" type="checkbox" id="list-loc-${pitchCount}-${j}" data-pitch="${pitchCount}" data-loc="${j}" checked><label class="form-check-label badge p-2 ${badgeClass}" for="list-loc-${pitchCount}-${j}">${loc.name}</label></div>`;
            }).join('');
            div.innerHTML = `
                <div class="pitch-section-header">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <select class="form-select pitch-preset" style="max-width:200px;">${PRESETS_HTML}</select>
                        <input type="text" class="form-control pitch-name fw-bold" name="pitcher[pitchTypes][${pitchCount}][name]" placeholder="Pitch name" style="max-width:160px;">
                        <input type="text" class="form-control pitch-abbr" name="pitcher[pitchTypes][${pitchCount}][abbreviation]" placeholder="Abbr." style="max-width:80px;">
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-pitch"><i class="bi bi-trash"></i></button>
                </div>
                <div class="visual-view"><div class="zone-container"><div class="zone-grid-wrapper" id="wrapper-${pitchCount}"><div class="pitchers-view-label">Pitcher's View</div><div class="zone-grid" id="grid-${pitchCount}"></div></div></div></div>
                <div class="list-view" style="display:none;"><div class="d-flex flex-wrap gap-2 mt-2">${listChecks}</div></div>
                ${locInputs}`;
            container.appendChild(div);
            const isListMode = document.getElementById('listMode').checked;
            div.querySelector('.visual-view').style.display = isListMode ? 'none' : 'block';
            div.querySelector('.list-view').style.display   = isListMode ? 'block' : 'none';
            const syntheticPitch = { locations: zoneLocations.map(loc => ({ ...loc, enabled: true })) };
            pitchData.push(syntheticPitch);
            buildGrid(pitchCount);
            pitchCount++;
        });

        document.getElementById('pitchTypes').addEventListener('click', (e) => {
            if (e.target.closest('.remove-pitch')) {
                const row = e.target.closest('.pitch-type-row');
                const allRows = [...document.querySelectorAll('.pitch-type-row')];
                const idx = allRows.indexOf(row);
                if (idx >= 0) pitchData.splice(idx, 1);
                row.remove(); reindexRows();
                const rows = document.querySelectorAll('.pitch-type-row');
                if (rows.length < 8) { const btn = document.getElementById('addPitch'); btn.disabled = false; btn.innerHTML = '<i class="bi bi-plus-circle"></i> Add Another Pitch'; }
            }
        });

        document.querySelectorAll('.zone-image-card-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const form = document.createElement('form'); form.method = 'POST'; form.action = btn.dataset.zoneUrl;
                const input = document.createElement('input'); input.type = 'hidden'; input.name = 'zoneId'; input.value = btn.dataset.zoneId;
                form.appendChild(input); document.body.appendChild(form); form.submit();
            });
        });

        const revertBtn = document.getElementById('revertZoneBtn');
        if (revertBtn) {
            revertBtn.addEventListener('click', () => {
                const form = document.createElement('form'); form.method = 'POST';
                form.action = `/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/revert-zone`;
                document.body.appendChild(form); form.submit();
            });
        }
    </script>
