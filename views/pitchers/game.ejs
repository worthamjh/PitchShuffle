<%- layout('layouts/boilerplate') %>

<style>
    .speaking-dot {
        display: inline-block; width: 8px; height: 8px; border-radius: 50%;
        background: #2ecc71; margin-left: 4px; vertical-align: middle;
        animation: pulse 0.8s infinite alternate;
    }
    @keyframes pulse { from { opacity: 0.3; transform: scale(0.8); } to { opacity: 1; transform: scale(1.2); } }

    /* Lock the page — no scrolling, everything fits in viewport */
    html, body { height: 100%; overflow: hidden; }
    main { padding: 0 !important; overflow: hidden; }
    .container.mt-3 { display: none !important; }
    .navbar { position: relative; z-index: 1050; }
    .navbar-collapse { z-index: 1050; }

    .game-page {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 56px); /* full viewport minus Bootstrap navbar */
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        background: var(--ps-card-bg);
        overflow: hidden;
    }

    /* Pitch row — fixed height, no shrink */
    .pitch-row {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        overflow-x: auto;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        flex-shrink: 0;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .pitch-row::-webkit-scrollbar { display: none; }

    .pitch-btn {
        flex: 1;
        min-width: 0;
        padding: 0.35rem 0.5rem;
        border-radius: var(--btn-radius);
        font-size: 0.95rem;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        border: 2px solid #c0cfe0;
        background: #eef2f7;
        color: var(--ps-navy);
        user-select: none;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
        white-space: nowrap;
    }
    .pitch-btn:hover  { background: #dce6f0; border-color: #8fa8c8; }
    .pitch-btn.active { background: var(--ps-navy); border-color: var(--ps-navy); color: var(--accent-text, #fff); }

    /* Zone — takes all remaining space between pitch row and action row */
    .zone-area {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--ps-card-bg);
    }
    .zone-col { width: 100%; display: flex; align-items: center; justify-content: center; }

    /* Action row — fixed height, no shrink */
    .action-row {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        flex-shrink: 0;
    }
    .action-btn {
        flex: 1;
        padding: 0.4rem 0.25rem;
        border-radius: var(--btn-radius);
        font-size: 0.8rem;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        border: 2px solid transparent;
        user-select: none;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .btn-random { background: #e8f4fd; border-color: #4a9edd; color: #1a5f8a; }
    .btn-random:hover { background: #4a9edd; color: #fff; }
    .btn-clear  { background: #fde8e8; border-color: #dd4a4a; color: #8a1a1a; }
    .btn-clear:hover  { background: #dd4a4a; color: #fff; }
    .btn-repeat { background: #f0e8fd; border-color: #9a4add; color: #5a1a8a; }
    .btn-repeat:hover { background: #9a4add; color: #fff; }
    .btn-repeat.disabled-btn { opacity: 0.45; pointer-events: none; }

    /* Call bar — fixed height, no shrink, always last item */
    .call-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem 0.75rem;
        background: var(--ps-navy);
        color: #fff;
        min-height: 60px;
        flex-shrink: 0;
    }
    .call-bar .call-label { color: var(--ps-navy-muted); font-size: 0.7rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.5px; }
    .call-bar .call-text  { font-size: 0.95rem; font-weight: 700; line-height: 1.2; }
    .call-bar .call-info  { flex: 1; min-width: 0; }
    .btn-call {
        flex-shrink: 0;
        background: #fff;
        color: var(--ps-navy);
        border: 2px solid #fff;
        border-radius: var(--btn-radius);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.6rem 1.25rem 0.85rem;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        user-select: none;
        white-space: nowrap;
    }
    .btn-call:hover { background: var(--ps-navy-muted); color: #fff; }
    .btn-call.disabled-btn { opacity: 0.45; pointer-events: none; }

    /* Zone font sizes */
    .zone-col .loc-box,
    .zone-col .chase-overlay { font-size: 0.55rem; }
    @media (min-width: 400px) {
        .zone-col .loc-box,
        .zone-col .chase-overlay { font-size: 0.6rem; }
    }
    @media (min-width: 600px) {
        .zone-col .loc-box,
        .zone-col .chase-overlay { font-size: 0.7rem; }
    }

    [data-theme='dark'] .pitch-row,
    [data-theme='dark'] .action-row { background: #1a2535; border-color: #2a3f5a; }
    [data-theme='dark'] .pitch-btn  { background: #243350; border-color: #2a3f5a; color: var(--ps-navy-muted); }
    [data-theme='dark'] .pitch-btn.active { background: var(--ps-navy); color: var(--accent-text, #fff); }
    /* ── Pickoff / Pitchout row ──────────────────────────────── */
    .special-row {
        display: flex;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        background: var(--ps-card-bg);
        border-top: 1px solid #dee2e6;
        flex-shrink: 0;
    }
    .btn-pickoff  { background: #e8f4fd; border: 2px solid #4a9edd; color: #1a5f8a; flex: 1; border-radius: var(--btn-radius); padding: 0.35rem 0.5rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
    .btn-pitchout { background: #fff3e0; border: 2px solid #e67e22; color: #7d4000; flex: 1; border-radius: var(--btn-radius); padding: 0.35rem 0.5rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
    .btn-pickoff:hover  { background: #4a9edd; color: #fff; }
    .btn-pitchout:hover { background: #e67e22; color: #fff; }

    /* ── Pickoff base selector overlay ──────────────────────── */
    .pickoff-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pickoff-diamond {
        background: var(--ps-card-bg);
        border-radius: 16px;
        padding: 2rem 1.5rem 1.5rem;
        width: 280px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto auto;
        gap: 0.75rem;
        text-align: center;
    }
    .pickoff-diamond .base-2nd {
        grid-column: 1 / span 2;
        justify-self: center;
        width: 50%;
    }
    .pickoff-diamond .base-btn {
        padding: 0.75rem 0.5rem;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        border: 2px solid #4a9edd;
        background: #e8f4fd;
        color: #1a5f8a;
    }
    .pickoff-diamond .base-btn:hover { background: #4a9edd; color: #fff; }
    .pickoff-diamond .btn-cancel-pickoff {
        padding: 0.75rem 0.5rem;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        border: 2px solid #adb5bd;
        background: #f8f9fa;
        color: #495057;
    }
    .pickoff-diamond .btn-cancel-pickoff:hover { background: #dee2e6; }
    [data-theme="dark"] .pickoff-diamond { background: #1a2535; }
    [data-theme="dark"] .special-row { background: #1a2535; border-color: #2a3f5a; }
    /* ── Tour ── */
    .ps-tour-overlay {
        position: fixed; inset: 0; z-index: 3000;
        pointer-events: none; display: none;
    }
    .ps-tour-backdrop {
        position: absolute; inset: 0;
        background: rgba(0,0,0,0.62);
        pointer-events: none;
    }
    .ps-tour-highlight {
        position: absolute; border-radius: 8px;
        box-shadow: 0 0 0 9999px rgba(0,0,0,0.62);
        z-index: 3001; pointer-events: none;
        border: 2px solid rgba(255,255,255,0.45);
    }
    .ps-tour-card {
        position: absolute; background: #fff; border-radius: 14px;
        padding: 1rem 1.25rem 0.85rem; max-width: 300px; width: 88%;
        z-index: 3002; pointer-events: all;
    }
    [data-theme='dark'] .ps-tour-card { background: #1a2535; color: #e8edf2; }
    .ps-tour-step-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #8fa8c8; margin-bottom: 0.3rem; }
    .ps-tour-card h4 { font-size: 0.95rem; font-weight: 700; margin: 0 0 0.35rem; color: var(--ps-navy, #1a2e4a); line-height: 1.3; }
    [data-theme='dark'] .ps-tour-card h4 { color: #e8edf2; }
    .ps-tour-card p { font-size: 0.8rem; color: #555; margin: 0 0 0.85rem; line-height: 1.5; }
    [data-theme='dark'] .ps-tour-card p { color: #8fa8c8; }
    .ps-tour-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    .ps-tour-dots { display: flex; gap: 5px; }
    .ps-tour-dot { width: 6px; height: 6px; border-radius: 50%; background: #c0cfe0; }
    .ps-tour-dot.active { background: var(--ps-navy, #1a2e4a); }
    .ps-tour-next { background: var(--ps-navy, #1a2e4a); color: #fff; border: none; border-radius: 8px; padding: 0.45rem 1.1rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; }
    [data-theme="dark"] .loc-box.strike {
            background: var(--strike-bg);
            border-color: var(--strike-border);
            color: var(--strike-text);
            filter: brightness(0.6) saturate(0.9);
        }
        [data-theme="dark"] .loc-box.strike:hover {
            filter: brightness(0.8) saturate(1);
        }
        [data-theme="dark"] .loc-box.chase {
            background: var(--chase-bg);
            border-color: var(--chase-border);
            color: var(--chase-text);
            filter: brightness(0.6) saturate(0.9);
        }
        [data-theme="dark"] .loc-box.chase:hover {
            filter: brightness(0.8) saturate(1);
        }
        [data-theme="dark"] .chase-overlay {
            background: var(--chase-bg);
            border-color: var(--chase-border);
            color: var(--chase-text);
            filter: brightness(0.6) saturate(0.9);
        }
        [data-theme="dark"] .chase-overlay:hover {
            filter: brightness(0.8) saturate(1);
        }
        [data-theme="dark"] .loc-box.disabled,
        [data-theme="dark"] .chase-overlay.disabled {
            filter: none;
        }
</style>


<!-- ── Header + game page — one flex column filling the viewport below navbar -->
<div class="game-page">

<!-- Game header inside the flex column -->
<div class="game-header">
    <a href="/teams/<%= team._id %>" class="btn btn-sm btn-outline-light">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="pitcher-info">
        <div class="pitcher-name">#<%= pitcher.number %> <%= pitcher.name %></div>
        <div class="pitcher-meta"><%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot; <%= pitcher.zone ? pitcher.zone.name : 'No Zone' %></div>
    </div>
    <a href="/teams/<%= team._id %>/pitchers/game?from=<%= pitcher._id %>" class="btn btn-sm btn-outline-light">
        <i class="bi bi-person-fill"></i> Change Pitcher
    </a>
</div>

<%
    const _gUserTerm    = (currentUser && currentUser.preferences && currentUser.preferences.zoneTerminology)
        ? currentUser.preferences.zoneTerminology : 'arm-glove';
    const _gPitcherTerm = pitcher.zone && pitcher.zone.terminology ? pitcher.zone.terminology : null;
    const _gTermMismatch = _gPitcherTerm && _gPitcherTerm !== 'both' && _gPitcherTerm !== _gUserTerm;
    const _gPitcherTermLabel = _gPitcherTerm === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
    const _gUserTermLabel    = _gUserTerm    === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
%>
<% if (_gTermMismatch) { %>
<div class="alert alert-warning d-flex align-items-center gap-2 mx-2 mt-2 mb-0" role="alert">
    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
    <div class="small">
        <strong>Zone terminology mismatch:</strong> This pitcher's locations are saved as
        <strong><%= _gPitcherTermLabel %></strong> zones, but your preference is
        <strong><%= _gUserTermLabel %></strong>. Pitch calls will use the old terminology.
        <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/edit" class="alert-link fw-bold">Edit this pitcher</a>
        and re-select a strike zone to reset to <strong><%= _gUserTermLabel %></strong>.
    </div>
</div>
<% } %>

<!-- Pitch buttons row -->
<div class="pitch-row" id="pitchRow">
    <% pitcher.pitchTypes.forEach(function(pt, i) { %>
        <button class="pitch-btn" data-pitch-index="<%= i %>">
            <%= pt.abbreviation || pt.name %>
        </button>
    <% }); %>
</div>

<!-- Zone -->
<div class="zone-area">
    <div class="zone-col">
        <div class="zone-grid-wrapper" id="zoneWrapper">
            <div class="zone-grid" id="zoneGrid"></div>
        </div>
    </div>
</div>

<!-- Action buttons row -->
 <!-- Pickoff overlay -->
<div class="pickoff-overlay" id="pickoffOverlay" style="display:none;">
    <div class="pickoff-diamond">
        <div class="base-2nd">
            <button class="base-btn" data-base="2nd">2nd Base</button>
        </div>
        <button class="base-btn" data-base="3rd">3rd Base</button>
        <button class="base-btn" data-base="1st">1st Base</button>
        <button class="btn-cancel-pickoff" id="btnCancelPickoff"><i class="bi bi-x-circle"></i> Cancel</button>
        <button class="base-btn" id="btnConfirmPickoff" style="display:none;" data-base="">
            <i class="bi bi-megaphone"></i> Pickoff
        </button>
    </div>
</div>

<!-- Pickoff / Pitchout row -->
<div class="special-row">
    <button class="btn-pickoff" id="btnPickoff"><i class="bi bi-person-fill-slash"></i> Pickoff</button>
    <button class="btn-pitchout" id="btnPitchout"><i class="bi bi-slash-circle"></i> Pitchout</button>
</div>

<!-- Action buttons row -->
<div class="action-row" id="actionRow">
    <button class="action-btn btn-random" id="btnRandom"><i class="bi bi-shuffle"></i> Random</button>
    <button class="action-btn btn-clear"  id="btnClear"><i class="bi bi-x-circle"></i> Clear</button>
    <button class="action-btn btn-repeat disabled-btn" id="btnRepeat"><i class="bi bi-arrow-repeat"></i> Repeat</button>
</div>

<!-- Call bar -->
<div class="call-bar" id="callBar">
    <div class="call-info">
        <div class="call-label">SELECT PITCH &amp; LOCATION</div>
        <div class="call-text" id="callText" style="display:none;"></div>
    </div>
    <button class="btn-call disabled-btn" id="btnCall"><i class="bi bi-megaphone"></i> Call Pitch</button>
</div>


<!-- ── Tour ── -->
<div class="ps-tour-overlay" id="psTourOverlay">
    <div class="ps-tour-backdrop"></div>
    <div class="ps-tour-highlight" id="psTourHighlight"></div>
    <div class="ps-tour-card" id="psTourCard">
        <div class="ps-tour-step-label" id="psTourStepLabel"></div>
        <h4 id="psTourTitle"></h4>
        <p id="psTourBody"></p>
        <div class="ps-tour-footer">
            <div class="ps-tour-dots" id="psTourDots"></div>
            <button class="ps-tour-next" id="psTourNext">Next</button>
        </div>
    </div>
</div>

</div><!-- end .game-page -->

<!-- ── Data ─────────────────────────────────────────────────── -->
<script type="application/json" id="pitcherJson"><%- JSON.stringify(pitcher) %></script>

<script>
    const pitcherData   = JSON.parse(document.getElementById('pitcherJson').textContent);
    const isRHP         = pitcherData.throws === 'R';
    const pitchTypes    = pitcherData.pitchTypes || [];
    const zoneLocations = pitcherData.zone ? pitcherData.zone.availableLocations : [];

    let selectedPitchIndex = null;
    let selectedLocation   = null;
    let lastCall           = null;

    // ── Zone layouts ──────────────────────────────────────────
    const LAYOUTS_C = {
        'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 },
        'up-out':         { row: 1, col: 2 },
        'arm-out-up':     { row: 1, col: isRHP ? 5 : 1 },
        'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
        'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true },
        'mid-up':         { row: 2, col: 3,              strike: true },
        'arm-up':         { row: 2, col: isRHP ? 4 : 2, strike: true },
        'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
        'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true },
        'mid-mid':        { row: 3, col: 3,              strike: true },
        'arm-mid':        { row: 3, col: isRHP ? 4 : 2, strike: true },
        'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true },
        'mid-down':       { row: 4, col: 3,              strike: true },
        'arm-down':       { row: 4, col: isRHP ? 4 : 2, strike: true },
        'glove-out-down': { row: 5, col: isRHP ? 1 : 5 },
        'down-out':       { row: 5, col: 2 },
        'arm-out-down':   { row: 5, col: isRHP ? 5 : 1 },
    };
    const LAYOUTS_A = {
        'arm-side':   { row: 1, col: isRHP ? 2 : 1, strike: true },
        'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true },
    };
    const LAYOUTS_B = {
        'up':   { row: 1, col: 1, strike: true },
        'down': { row: 2, col: 1, strike: true },
    };

    // ── Inside/Away layouts (fixed — no isRHP flip) ───────────
    // inside = col 5 (right), away = col 1 (left) — RHH perspective
    const LAYOUTS_A_IA = {
        'away-side':   { row: 1, col: 1, strike: true },
        'inside-side': { row: 1, col: 2, strike: true },
    };
    const LAYOUTS_C_IA = {
        'away-out-up':     { row: 1, col: 1 },
        'up-out':          { row: 1, col: 2 },
        'inside-out-up':   { row: 1, col: 5 },
        'away-out-mid':    { row: 2, col: 1, rowSpan: 3 },
        'away-up':         { row: 2, col: 2, strike: true },
        'mid-up':          { row: 2, col: 3, strike: true },
        'inside-up':       { row: 2, col: 4, strike: true },
        'inside-out-mid':  { row: 2, col: 5, rowSpan: 3 },
        'away-mid':        { row: 3, col: 2, strike: true },
        'mid-mid':         { row: 3, col: 3, strike: true },
        'inside-mid':      { row: 3, col: 4, strike: true },
        'away-down':       { row: 4, col: 2, strike: true },
        'mid-down':        { row: 4, col: 3, strike: true },
        'inside-down':     { row: 4, col: 4, strike: true },
        'away-out-down':   { row: 5, col: 1 },
        'down-out':        { row: 5, col: 2 },
        'inside-out-down': { row: 5, col: 5 },
    };

    function getLayout(locs) {
        const n = new Set(locs.map(l => l.name));
        if (n.has('glove-up'))    return LAYOUTS_C;
        if (n.has('inside-up'))   return LAYOUTS_C_IA;
        if (n.has('arm-side'))    return LAYOUTS_A;
        if (n.has('inside-side')) return LAYOUTS_A_IA;
        if (n.has('up'))          return LAYOUTS_B;
        return LAYOUTS_C;
    }
    const isZoneC = locs => {
        const n = new Set(locs.map(l => l.name));
        return n.has('glove-up') || n.has('inside-up');
    };

    // ── Build grid ────────────────────────────────────────────
    let _boxSize = 70; // shared with drawOutline / drawOverlays

    function buildGrid() {
        const grid    = document.getElementById('zoneGrid');
        const wrapper = document.getElementById('zoneWrapper');
        grid.innerHTML = '';
        wrapper.querySelectorAll('.chase-overlay, .strike-zone-outline').forEach(el => el.remove());
        if (!zoneLocations.length) return;

        const layout  = getLayout(zoneLocations);
        const maxRow  = Math.max(...Object.values(layout).map(p => (p.row||1) + (p.rowSpan||1) - 1));
        const maxCol  = Math.max(...Object.values(layout).map(p => (p.col||1) + (p.colSpan||1) - 1));

        // Measure zone-area after layout has settled
        const zoneArea   = document.querySelector('.zone-area');
        const _availH  = (zoneArea && zoneArea.offsetHeight > 0)
            ? zoneArea.offsetHeight
            : window.innerHeight - 56 - 44 - 44 - 48;

        // Height first — fill the zone, then cap by width
        _boxSize = Math.floor(_availH / maxRow);
        const _availW = window.innerWidth - 4;
        const _boxW   = Math.floor(_availW / maxCol);
        _boxSize = Math.min(_boxSize, _boxW);
        _boxSize = Math.max(_boxSize, 44); // minimum touch target

        grid.style.gridTemplateRows    = `repeat(${maxRow}, ${_boxSize}px)`;
        grid.style.gridTemplateColumns = `repeat(${maxCol}, ${_boxSize}px)`;

        zoneLocations.forEach(loc => {
            const pos = layout[loc.name];
            if (!pos) return;
            const box = document.createElement('div');
            box.className        = `loc-box ${loc.type === 'chase' ? 'chase' : 'strike'}`;
            box.textContent      = loc.name.replace(/-/g, ' ');
            box.dataset.locName  = loc.name;
            box.dataset.isStrike = pos.strike ? 'true' : 'false';
            box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
            box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
            grid.appendChild(box);
        });

        // Use math-based positioning — no getBoundingClientRect needed
        drawOutline(layout);
        if (isZoneC(zoneLocations)) drawOverlays(layout);
        if (selectedLocation) highlightLocation(selectedLocation);
    }

    function cellBounds(pos) {
        const top    = (pos.row - 1) * _boxSize;
        const left   = (pos.col - 1) * _boxSize;
        const height = (pos.rowSpan || 1) * _boxSize;
        const width  = (pos.colSpan || 1) * _boxSize;
        return { top, left, bottom: top + height, right: left + width, width, height };
    }

    function drawOutline(layout) {
        const wrapper    = document.getElementById('zoneWrapper');
        const gridBorder = 2; // .zone-grid has border: 2px — offset overlays into wrapper coords
        const strikePosArr = Object.values(layout).filter(p => p.strike);
        if (!strikePosArr.length) return;

        let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
        strikePosArr.forEach(pos => {
            const bnd = cellBounds(pos);
            t = Math.min(t, bnd.top);
            l = Math.min(l, bnd.left);
            b = Math.max(b, bnd.bottom);
            r = Math.max(r, bnd.right);
        });

        const outline = document.createElement('div');
        outline.className = 'strike-zone-outline';
        Object.assign(outline.style, {
            top:    (t + gridBorder) + 'px',
            left:   (l + gridBorder) + 'px',
            width:  (r - l) + 'px',
            height: (b - t) + 'px'
        });
        wrapper.appendChild(outline);
    }

    // ── Chase overlays (Zone C only) ──────────────────────────
    // Positions span-overlay rectangles over up-out, down-out, arm-out-mid,
    // glove-out-mid using the same math-based cellBounds — no getBoundingClientRect.
    function drawOverlays(layout) {
        const wrapper = document.getElementById('zoneWrapper');
        const grid    = document.getElementById('zoneGrid');
        wrapper.querySelectorAll('.chase-overlay').forEach(el => el.remove());

        // The grid has a 2px border — overlays are relative to wrapper, so offset by that
        const gridBorder = 2;

        const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
        const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';

        function spanBounds(names) {
            let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
            names.forEach(name => {
                const pos = layout[name];
                if (!pos) return;
                const bnd = cellBounds(pos);
                t = Math.min(t, bnd.top);    l = Math.min(l, bnd.left);
                b = Math.max(b, bnd.bottom); r = Math.max(r, bnd.right);
            });
            return { t, l, b, r };
        }

        function makeOverlay(locName, label, hCellNames, vCellNames, coverAlso = []) {
            const loc = zoneLocations.find(z => z.name === locName);
            if (!loc) return;
            const hb = spanBounds(hCellNames);
            const vb = spanBounds(vCellNames);
            if (!isFinite(hb.l) || !isFinite(vb.t)) return;

            // Hide the underlying grid cell(s) — overlay takes over interaction
            const allToHide = [locName, ...coverAlso];
            allToHide.forEach(name => {
                const cell = grid ? [...grid.querySelectorAll('.loc-box')]
                    .find(el => el.dataset.locName === name) : null;
                if (cell) cell.classList.add('covered');
            });

            const el = document.createElement('div');
            el.className        = 'chase-overlay' + (loc.enabled === false ? ' disabled' : '');
            el.textContent      = label;
            el.dataset.locName  = locName;
            Object.assign(el.style, {
                top:    (vb.t + gridBorder) + 'px',
                left:   (hb.l + gridBorder) + 'px',
                width:  (hb.r - hb.l) + 'px',
                height: (vb.b - vb.t) + 'px',
            });
            wrapper.appendChild(el);
        }

        // Detect inside/away vs arm/glove terminology
        const locNames     = new Set(zoneLocations.map(l => l.name));
        const isInsideAway = locNames.has('inside-up');

        if (isInsideAway) {
            // Inside/Away — fixed layout, no handedness flip
            makeOverlay('up-out',         'up out',
                ['away-up', 'mid-up', 'inside-up'], ['up-out']);
            makeOverlay('down-out',        'down out',
                ['away-down', 'mid-down', 'inside-down'], ['down-out']);
            makeOverlay('inside-out-mid', 'inside out',
                ['inside-out-mid'], ['inside-up', 'inside-mid', 'inside-down']);
            makeOverlay('away-out-mid',   'away out',
                ['away-out-mid'],   ['away-up', 'away-mid', 'away-down']);
        } else {
            // Arm/Glove — mirrors based on pitcher handedness
            makeOverlay('up-out',   'up out',
                ['glove-up', 'mid-up', 'arm-up'], ['up-out']);
            makeOverlay('down-out', 'down out',
                ['glove-down', 'mid-down', 'arm-down'], ['down-out']);
            makeOverlay(armOutName,   isRHP ? 'arm out'   : 'glove out',
                [armOutName], ['glove-up', 'glove-mid', 'glove-down']);
            makeOverlay(gloveOutName, isRHP ? 'glove out' : 'arm out',
                [gloveOutName], ['arm-up', 'arm-mid', 'arm-down']);
        }
    }

    // ── Selection helpers ─────────────────────────────────────
    function selectPitch(index) {
        selectedPitchIndex = index;
        document.querySelectorAll('.pitch-btn').forEach((btn, i) =>
            btn.classList.toggle('active', i === index));
        updateCallBar();
        updateButtons();
    }

    function selectLocation(locName) {
        selectedLocation = locName;
        highlightLocation(locName);
        updateCallBar();
        updateButtons();
    }

    function highlightLocation(locName) {
        document.querySelectorAll('.loc-box, .chase-overlay').forEach(el =>
            el.classList.toggle('selected-loc', el.dataset.locName === locName));
    }

    function clearSelection() {
        selectedPitchIndex = null;
        selectedLocation   = null;
        document.querySelectorAll('.pitch-btn').forEach(btn => btn.classList.remove('active'));
        highlightLocation(null);
        updateCallBar();
        updateButtons();
    }

    // ── LOC labels for speech ─────────────────────────────────
    const LOC_LABELS = {
        'glove-up':       'glove side up',
        'glove-mid':      'glove side middle',
        'glove-down':     'glove side down',
        'arm-up':         'arm side up',
        'arm-mid':        'arm side middle',
        'arm-down':       'arm side down',
        'mid-up':         'middle up',
        'mid-mid':        'middle middle',
        'mid-down':       'middle down',
        'glove-out-up':   'glove side up and out',
        'glove-out-mid':  'glove side out',
        'glove-out-down': 'glove side down and out',
        'arm-out-up':     'arm side up and out',
        'arm-out-mid':    'arm side out',
        'arm-out-down':   'arm side down and out',
        'up-out':         'up and out',
        'down-out':       'down and out',
        'glove-side':       'glove side',
        'arm-side':         'arm side',
        'up':               'up',
        'down':             'down',
        'away-up':          'away up',
        'away-mid':         'away middle',
        'away-down':        'away down',
        'inside-up':        'inside up',
        'inside-mid':       'inside middle',
        'inside-down':      'inside down',
        'away-out-up':      'away up and out',
        'away-out-mid':     'away out',
        'away-out-down':    'away down and out',
        'inside-out-up':    'inside up and out',
        'inside-out-mid':   'inside out',
        'inside-out-down':  'inside down and out',
        'away-side':        'away',
        'inside-side':      'inside',
    };
    function locLabel(locName) {
        return LOC_LABELS[locName] || locName.replace(/-/g, ' ');
    }

    function updateCallBar() {
        const label = document.querySelector('#callBar .call-label');
        const text  = document.getElementById('callText');
        if (selectedPitchIndex !== null && selectedLocation) {
            const name = pitchTypes[selectedPitchIndex].name;
            label.textContent = 'CALL:';
            text.textContent  = `${name} — ${locLabel(selectedLocation)}`;
            text.style.display = '';
        } else if (selectedPitchIndex !== null) {
            label.textContent = 'SELECT LOCATION';
            text.style.display = 'none';
        } else if (selectedLocation) {
            label.textContent = 'SELECT PITCH TYPE';
            text.style.display = 'none';
        } else {
            label.textContent = 'SELECT PITCH & LOCATION';
            text.style.display = 'none';
        }
    }

    function updateButtons() {
        const ready = selectedPitchIndex !== null && selectedLocation !== null;
        document.getElementById('btnCall').classList.toggle('disabled-btn', !ready);
        document.getElementById('btnRepeat').classList.toggle('disabled-btn', !lastCall);
    }

    // ── Event listeners ───────────────────────────────────────
    document.getElementById('pitchRow').addEventListener('click', e => {
        const btn = e.target.closest('.pitch-btn');
        if (btn) selectPitch(Number(btn.dataset.pitchIndex));
    });

    document.getElementById('zoneWrapper').addEventListener('click', e => {
        const el = e.target.closest('.loc-box:not(.covered):not(.empty), .chase-overlay');
        if (el) selectLocation(el.dataset.locName);
    });

    document.getElementById('btnRandom').addEventListener('click', () => {
        const eligible = pitchTypes.filter((_, i) => {
            const pt = pitchTypes[i];
            return pt.locations?.some(l => l.enabled);
        });
        const locs = zoneLocations.filter(l => l.enabled !== false);
        if (!pitchTypes.length || !locs.length) return;
        selectPitch(Math.floor(Math.random() * pitchTypes.length));
        selectLocation(locs[Math.floor(Math.random() * locs.length)].name);
    });

    document.getElementById('btnClear').addEventListener('click', clearSelection);

    document.getElementById('btnRepeat').addEventListener('click', () => {
        if (lastCall) speak(lastCall.pitchName, lastCall.locName);
    });


function speak(pitchName, locName) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(locName ? `${pitchName}, ${locLabel(locName)}` : pitchName);
    utter.rate  = 0.95;

    // Apply saved voice — fetch voices fresh each time as they may not
    // be loaded yet if called early, and use a small delay if list is empty
    function applyVoiceAndSpeak() {
        const savedURI = window.PS_VOICE_URI || '';
        if (savedURI) {
            const voices = window.speechSynthesis.getVoices();
            const match  = voices.find(v => v.voiceURI === savedURI);
            if (match) utter.voice = match;
        }
        const bar = document.getElementById('callBar');
        const dot = Object.assign(document.createElement('span'), { className: 'speaking-dot' });
        utter.onstart = () => bar.appendChild(dot);
        utter.onend = utter.onerror = () => dot.parentNode?.removeChild(dot);
        window.speechSynthesis.speak(utter);
    }

    applyVoiceAndSpeak();
}


    // ── Tour ──────────────────────────────────────────────────
    const TOUR_KEY = 'ps_game_tour_v2';
    const TOUR_STEPS = [
        {
            targetId: 'pitchRow',
            title: 'Select a pitch type',
            body: 'Tap any pitch type button to choose what you want to throw.',
            position: 'below'
        },
        {
            targetId: 'zoneWrapper',
            title: 'Select a pitch location',
            body: 'Tap a location on the zone to choose where the pitch should go.',
            position: 'above'
        },
        {
            targetId: 'actionRow',
            title: 'Random, Clear & Repeat',
            body: 'Random selects both a pitch type and a location for you. Clear resets your selection. Repeat re-announces the last call.',
            position: 'above'
        },
        {
            targetId: 'callBar',
            title: 'Your call appears here',
            body: 'Once a pitch type and location are selected your call shows up here. Tap Call Pitch to send the pitch call to your catcher.',
            position: 'above'
        }
    ];

    let _tourStep = 0;

    function _tourShow(step) {
        const ov  = document.getElementById('psTourOverlay');
        const hl  = document.getElementById('psTourHighlight');
        const card = document.getElementById('psTourCard');
        const s   = TOUR_STEPS[step];
        const pad = 8;
        const el  = document.getElementById(s.targetId);
        if (!el) return;
        const r = el.getBoundingClientRect();

        ov.style.display = 'block';

        Object.assign(hl.style, {
            top:    (r.top    - pad) + 'px',
            left:   (r.left   - pad) + 'px',
            width:  (r.width  + pad * 2) + 'px',
            height: (r.height + pad * 2) + 'px',
        });

        document.getElementById('psTourStepLabel').textContent = 'Step ' + (step+1) + ' of ' + TOUR_STEPS.length;
        document.getElementById('psTourTitle').textContent = s.title;
        document.getElementById('psTourBody').textContent  = s.body;
        document.getElementById('psTourNext').textContent  = step === TOUR_STEPS.length - 1 ? 'Got it' : 'Next';

        const dots = document.getElementById('psTourDots');
        dots.innerHTML = '';
        TOUR_STEPS.forEach((_, i) => {
            const d = document.createElement('div');
            d.className = 'ps-tour-dot' + (i === step ? ' active' : '');
            dots.appendChild(d);
        });

        const cardW    = Math.min(300, window.innerWidth * 0.88);
        const cardLeft = Math.max(8, Math.min(r.left, window.innerWidth - cardW - 8));
        card.style.width  = cardW + 'px';
        card.style.left   = cardLeft + 'px';
        card.style.top    = '';
        card.style.bottom = '';

        if (s.position === 'below') {
            card.style.top = (r.bottom + pad + 10) + 'px';
        } else {
            const estH    = 180;
            const margin  = 12;
            const spaceAbove = r.top - pad - margin - estH;
            const spaceBelow = window.innerHeight - r.bottom - pad - margin - estH;

            if (spaceAbove >= estH) {
                // Enough room above the highlight
                card.style.top = (r.top - pad - margin - estH) + 'px';
            } else if (spaceBelow >= estH) {
                // Enough room below
                card.style.top = (r.bottom + pad + margin) + 'px';
            } else {
                // Not enough room above or below — float card in centre of highlight
                const centreY = r.top + r.height / 2;
                card.style.top = Math.max(margin, centreY - estH / 2) + 'px';
            }
        }
    }

    function _tourEnd() {
        document.getElementById('psTourOverlay').style.display = 'none';
    }

    document.getElementById('psTourNext').addEventListener('click', () => {
        _tourStep++;
        if (_tourStep >= TOUR_STEPS.length) {
            _tourEnd();
        } else {
            _tourShow(_tourStep);
        }
    });

    // Start tour — save key immediately so navigation away never re-triggers
    if (!localStorage.getItem(TOUR_KEY)) {
        localStorage.setItem(TOUR_KEY, '1');
        setTimeout(() => requestAnimationFrame(() => _tourShow(0)), 750);
    }

    // ── Init ─────────────────────────────────────────────────
    let resizeTimer;
    requestAnimationFrame(buildGrid);
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(buildGrid, 100);
    });
    // ── Pickoff / Pitchout ────────────────────────────────────
    const pickoffOverlay = document.getElementById('pickoffOverlay');

    document.getElementById('btnPickoff').addEventListener('click', () => {
        pickoffOverlay.style.display = 'flex';
    });

    document.getElementById('btnCancelPickoff').addEventListener('click', () => {
        pickoffOverlay.style.display = 'none';
    });

    pickoffOverlay.querySelectorAll('.base-btn[data-base]').forEach(btn => {
        btn.addEventListener('click', () => {
            const base = btn.dataset.base;
            if (!base) return;
            pickoffOverlay.style.display = 'none';

            // Populate call bar
            const label = document.querySelector('#callBar .call-label');
            const text  = document.getElementById('callText');
            label.textContent    = 'CALL:';
            text.textContent     = `Pickoff — ${base} Base`;
            text.style.display   = '';

            // Enable Call Pitch
            const btnCall = document.getElementById('btnCall');
            btnCall.classList.remove('disabled-btn');

            // Override btnCall for this pickoff call
            function handlePickoffCall() {
                const baseLabel = base === '1st' ? 'first base' : base === '2nd' ? 'second base' : 'third base';
                speak('Pickoff', baseLabel);
                btnCall.removeEventListener('click', handlePickoffCall);
                // Restore normal handler after call
                btnCall.addEventListener('click', normalCallHandler);
            }
            btnCall.removeEventListener('click', normalCallHandler);
            btnCall.addEventListener('click', handlePickoffCall);
        });
    });

    document.getElementById('btnPitchout').addEventListener('click', () => {
        // Clear any pitch/location selection
        clearSelection();

        // Populate call bar directly
        const label = document.querySelector('#callBar .call-label');
        const text  = document.getElementById('callText');
        label.textContent  = 'CALL:';
        text.textContent   = 'Pitchout';
        text.style.display = '';

        const btnCall = document.getElementById('btnCall');
        btnCall.classList.remove('disabled-btn');

        function handlePitchoutCall() {
            speak('Pitchout', '');
            btnCall.removeEventListener('click', handlePitchoutCall);
            btnCall.addEventListener('click', normalCallHandler);
        }
        btnCall.removeEventListener('click', normalCallHandler);
        btnCall.addEventListener('click', handlePitchoutCall);
    });

    // Save reference to the normal call handler so we can restore it
    function normalCallHandler() {
        if (selectedPitchIndex === null || !selectedLocation) return;
        const pitchName = pitchTypes[selectedPitchIndex].name;
        lastCall = { pitchName, locName: selectedLocation };
        speak(pitchName, selectedLocation);
        updateButtons();
    }
    document.getElementById('btnCall').addEventListener('click', normalCallHandler);
</script>
