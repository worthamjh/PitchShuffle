<%- layout('layouts/boilerplate') %>

<style>
    .speaking-dot {
        display: inline-block; width: 8px; height: 8px; border-radius: 50%;
        background: #2ecc71; margin-left: 4px; vertical-align: middle;
        animation: pulse 0.8s infinite alternate;
    }
    @keyframes pulse { from { opacity: 0.3; transform: scale(0.8); } to { opacity: 1; transform: scale(1.2); } }

    html { height: 100%; }
    body { height: 100%; overflow: hidden; display: block !important; }
    main { padding: 0 !important; margin: 0 !important; max-width: 100% !important; width: 100% !important; overflow: hidden; }
    .container.mt-3 { display: none !important; }
    .navbar { position: relative; z-index: 1050; }
    .navbar-collapse { z-index: 1050; }
    body { background: #2a2a2a; }

    .game-page {
        display: flex; flex-direction: column;
        height: calc(100vh - 56px); width: 100%; max-width: 430px;
        margin: 0 auto; background: var(--ps-card-bg);
        overflow: hidden; box-shadow: 0 0 40px rgba(0,0,0,0.4);
    }
    @media (min-width: 600px) {
        .game-page { max-width: 100%; box-shadow: none; }
    }
    .pitch-row {
        display: flex; flex-direction: row; flex-wrap: wrap;
        gap: 0.4rem; padding: 0.3rem 0.75rem;
        background: #f8f9fa; border-bottom: 1px solid #dee2e6;
        flex-shrink: 0; max-height: 96px; overflow-y: auto; scrollbar-width: none;
    }
    .pitch-row::-webkit-scrollbar { display: none; }
    .pitch-btn { flex: 1 1 calc(25% - 0.4rem); min-width: calc(25% - 0.4rem); }
    .pitch-btn:hover  { background: #dce6f0; }
    .pitch-btn.active { background: var(--ps-navy); border-color: var(--ps-navy); color: var(--accent-text, #fff); }

    .zone-area {
        flex: 1; display: flex; align-items: center;
        justify-content: center; overflow: hidden; padding: 0.25rem;
    }
    .zone-col { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
    .zone-grid-wrapper { display: inline-block; position: relative; }
    .zone-grid { display: grid; gap: 0; border: 2px solid #adb5bd; }
    .pitchers-view-label {
        font-size: 0.6rem; font-weight: 600; color: #6c757d;
        text-align: center; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 2px;
    }
    .action-row {
        display: flex; flex-direction: row; gap: 0.4rem;
        padding: 0.3rem 0.75rem; background: #f8f9fa;
        border-top: 1px solid #dee2e6; flex-shrink: 0;
    }
    .action-btn {
        flex: 1; padding: 0.4rem 0.3rem; border-radius: var(--btn-radius);
        font-size: 0.78rem; font-weight: 700; text-align: center; cursor: pointer;
        border: 2px solid transparent; user-select: none;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .btn-random { background: #e8f4fd; border-color: #4a9edd; color: #1a5f8a; }
    .btn-random:hover { background: #4a9edd; color: #fff; }
    .btn-clear  { background: #fde8e8; border-color: #dd4a4a; color: #8a1a1a; }
    .btn-clear:hover  { background: #dd4a4a; color: #fff; }
    .btn-repeat { background: #f0e8fd; border-color: #9a4add; color: #5a1a8a; }
    .btn-repeat:hover { background: #9a4add; color: #fff; }
    .btn-repeat.disabled-btn { opacity: 0.45; pointer-events: none; }

    .call-bar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 0.5rem; padding: 1.25rem 0.75rem 1.5rem;
        background: var(--ps-navy); color: var(--accent-text, #fff);
        flex-shrink: 0; min-height: 100px;
    }
    .call-info { flex: 1; min-width: 0; }
    .call-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; opacity: 0.8; }
    .call-text  { font-size: 0.95rem; font-weight: 700; line-height: 1.3; }
    .btn-call {
        background: #fff; color: var(--ps-navy); border: none;
        border-radius: var(--btn-radius); padding: 0.75rem 1.25rem;
        font-size: 1rem; font-weight: 700; cursor: pointer; flex-shrink: 0;
        transition: background 0.15s, opacity 0.15s;
    }
    .btn-call:hover { background: #e0ecf8; }
    .btn-call.disabled-btn { opacity: 0.45; pointer-events: none; }

    .zone-col .loc-box {
        display: flex; align-items: center; justify-content: center;
        font-size: 0.55rem; font-weight: 600; text-align: center; cursor: pointer;
        border: 1px solid #dee2e6; user-select: none;
        transition: background 0.12s, border-color 0.12s;
        box-sizing: border-box; line-height: 1.1; padding: 2px;
    }
    @media (min-width: 400px) { .zone-col .loc-box, .zone-col .chase-overlay { font-size: 0.6rem; } }
    @media (min-width: 600px) { .zone-col .loc-box, .zone-col .chase-overlay { font-size: 0.7rem; } }

    .loc-box.strike       { background: var(--strike-bg); border-color: var(--strike-border); color: var(--strike-text); }
    .loc-box.chase        { background: var(--chase-bg);  border-color: var(--chase-border);  color: var(--chase-text); }
    .loc-box.anchor       { background: transparent; border-color: transparent; pointer-events: none; cursor: default; }
    .loc-box.covered      { visibility: hidden; pointer-events: none; }
    .loc-box.selected-loc { outline: 3px solid var(--ps-navy); outline-offset: -2px; z-index: 2; filter: brightness(0.82); }
    .chase-overlay.selected-loc { outline: 3px solid var(--ps-navy); outline-offset: -2px; z-index: 4; filter: brightness(0.82); }

    .chase-overlay {
        position: absolute; display: flex; align-items: center; justify-content: center;
        font-size: 0.55rem; font-weight: 600; text-align: center; cursor: pointer;
        background: var(--chase-bg); border: 1px solid var(--chase-border); color: var(--chase-text);
        box-sizing: border-box; z-index: 3; user-select: none; transition: background 0.12s;
    }
    .strike-zone-outline { position: absolute; border: 3px solid var(--ps-navy); pointer-events: none; z-index: 4; box-sizing: border-box; }

    [data-theme='dark'] .pitch-row, [data-theme='dark'] .action-row { background: #1a2535; border-color: #2a3f5a; }
    [data-theme='dark'] .pitch-btn  { background: #243350; border-color: #2a3f5a; color: var(--ps-navy-muted); }
    [data-theme='dark'] .pitch-btn.active { background: var(--ps-navy); color: var(--accent-text, #fff); }

    .special-row { display: flex; gap: 0.4rem; padding: 0.3rem 0.75rem; background: var(--ps-card-bg); border-top: 1px solid #dee2e6; flex-shrink: 0; }
    .btn-pickoff  { background: #e8f4fd; border: 2px solid #4a9edd; color: #1a5f8a; flex: 1; border-radius: var(--btn-radius); padding: 0.35rem 0.5rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
    .btn-pitchout { background: #fff3e0; border: 2px solid #e67e22; color: #7d4000; flex: 1; border-radius: var(--btn-radius); padding: 0.35rem 0.5rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
    .btn-pickoff:hover  { background: #4a9edd; color: #fff; }
    .btn-pitchout:hover { background: #e67e22; color: #fff; }

    .pickoff-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 200; display: flex; align-items: center; justify-content: center; }
    .pickoff-diamond { background: var(--ps-card-bg); border-radius: 16px; padding: 2rem 1.5rem 1.5rem; width: 280px; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto; gap: 0.75rem; text-align: center; }
    .pickoff-diamond .base-2nd { grid-column: 1 / span 2; justify-self: center; width: 50%; }
    .pickoff-diamond .base-btn { padding: 0.75rem 0.5rem; border-radius: 10px; font-size: 1rem; font-weight: 700; cursor: pointer; border: 2px solid #4a9edd; background: #e8f4fd; color: #1a5f8a; }
    .pickoff-diamond .base-btn:hover { background: #4a9edd; color: #fff; }
    .pickoff-diamond .btn-cancel-pickoff { padding: 0.75rem 0.5rem; border-radius: 10px; font-size: 1rem; font-weight: 700; cursor: pointer; border: 2px solid #adb5bd; background: #f8f9fa; color: #495057; }
    .pickoff-diamond .btn-cancel-pickoff:hover { background: #dee2e6; }
    [data-theme="dark"] .pickoff-diamond { background: #1a2535; }
    [data-theme="dark"] .special-row { background: #1a2535; border-color: #2a3f5a; }

    [data-theme="dark"] .loc-box.strike { background: var(--strike-bg); border-color: var(--strike-border); color: var(--strike-text); filter: brightness(0.6) saturate(0.9); }
    [data-theme="dark"] .loc-box.strike:hover { filter: brightness(0.8) saturate(1); }
    [data-theme="dark"] .loc-box.chase  { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); filter: brightness(0.6) saturate(0.9); }
    [data-theme="dark"] .loc-box.chase:hover { filter: brightness(0.8) saturate(1); }
    [data-theme="dark"] .chase-overlay  { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); filter: brightness(0.6) saturate(0.9); }
    [data-theme="dark"] .chase-overlay:hover { filter: brightness(0.8) saturate(1); }
    [data-theme="dark"] .loc-box.disabled, [data-theme="dark"] .chase-overlay.disabled { filter: none; }
    [data-theme="dark"] .loc-box.selected-loc, [data-theme="dark"] .chase-overlay.selected-loc { filter: brightness(0.95) saturate(1.1); }

    .ps-tour-overlay { position: fixed; inset: 0; z-index: 3000; pointer-events: none; display: none; }
    .ps-tour-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.62); pointer-events: none; }
    .ps-tour-highlight { position: absolute; border-radius: 8px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.62); z-index: 3001; pointer-events: none; border: 2px solid rgba(255,255,255,0.45); }
    .ps-tour-card { position: absolute; background: #fff; border-radius: 14px; padding: 1rem 1.25rem 0.85rem; max-width: 300px; width: 88%; z-index: 3002; pointer-events: all; }
    [data-theme='dark'] .ps-tour-card { background: #1a2535; color: #e8edf2; }
    .ps-tour-step-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #8fa8c8; margin-bottom: 0.3rem; }
    .ps-tour-card h4 { font-size: 0.95rem; font-weight: 700; margin: 0 0 0.35rem; color: var(--ps-navy, #1a2e4a); line-height: 1.3; }
    [data-theme='dark'] .ps-tour-card h4 { color: #e8edf2; }
    .ps-tour-card p { font-size: 0.8rem; color: #555; margin: 0 0 0.85rem; line-height: 1.5; }
    [data-theme='dark'] .ps-tour-card p { color: #8fa8c8; }
    .ps-tour-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    .ps-tour-dots { display: flex; gap: 5px; }
    .ps-tour-dot { width: 6px; height: 6px; border-radius: 50%; background: #c0cfe0; }
    .ps-tour-dot.active { background: var(--ps-navy, #1a2e4a); }
    .ps-tour-next { background: var(--ps-navy, #1a2e4a); color: #fff; border: none; border-radius: 8px; padding: 0.45rem 1.1rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; }
</style>

<div class="game-page">
    <div class="game-header">
        <a href="/teams/<%= team._id %>" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left"></i></a>
        <div class="pitcher-info">
            <div class="pitcher-name">#<%= pitcher.number %> <%= pitcher.name %></div>
            <div class="pitcher-meta"><%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot; <%= pitcher.zone ? pitcher.zone.name : 'No Zone' %></div>
        </div>
        <a href="/teams/<%= team._id %>/pitchers/game?from=<%= pitcher._id %>" class="btn btn-sm btn-outline-light">
            <i class="bi bi-person-fill"></i> Change Pitcher
        </a>
    </div>

    <%
        const _gUserTerm    = (currentUser && currentUser.preferences && currentUser.preferences.zoneTerminology) ? currentUser.preferences.zoneTerminology : 'arm-glove';
        const _gPitcherTerm = pitcher.zone && pitcher.zone.terminology ? pitcher.zone.terminology : null;
        const _gTermMismatch = _gPitcherTerm && _gPitcherTerm !== 'both' && _gPitcherTerm !== _gUserTerm;
        const _gPitcherTermLabel = _gPitcherTerm === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
        const _gUserTermLabel    = _gUserTerm    === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
    %>
    <% if (_gTermMismatch) { %>
    <div class="alert alert-warning d-flex align-items-center gap-2 mx-2 mt-2 mb-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <div class="small">
            <strong>Zone terminology mismatch:</strong> This pitcher's locations are saved as <strong><%= _gPitcherTermLabel %></strong> zones, but your preference is <strong><%= _gUserTermLabel %></strong>.
            <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/edit" class="alert-link fw-bold">Edit this pitcher</a> and re-select a strike zone to reset.
        </div>
    </div>
    <% } %>

    <div class="pitch-row" id="pitchRow">
        <% pitcher.pitchTypes.forEach(function(pt, i) { %>
            <button class="pitch-btn" data-pitch-index="<%= i %>"><%= pt.abbreviation || pt.name %></button>
        <% }); %>
    </div>

    <div class="zone-area">
        <div class="zone-col">
            <div class="zone-grid-wrapper" id="zoneWrapper">
                <div class="pitchers-view-label">Pitcher's View</div>
                <div class="zone-grid" id="zoneGrid"></div>
            </div>
        </div>
    </div>

    <div class="pickoff-overlay" id="pickoffOverlay" style="display:none;">
        <div class="pickoff-diamond">
            <div class="base-2nd"><button class="base-btn" data-base="2nd">2nd Base</button></div>
            <button class="base-btn" data-base="3rd">3rd Base</button>
            <button class="base-btn" data-base="1st">1st Base</button>
            <button class="btn-cancel-pickoff" id="btnCancelPickoff"><i class="bi bi-x-circle"></i> Cancel</button>
        </div>
    </div>

    <div class="special-row">
        <button class="btn-pickoff" id="btnPickoff"><i class="bi bi-person-fill-slash"></i> Pickoff</button>
        <button class="btn-pitchout" id="btnPitchout"><i class="bi bi-slash-circle"></i> Pitchout</button>
    </div>

    <div class="action-row" id="actionRow">
        <button class="action-btn btn-random" id="btnRandom"><i class="bi bi-shuffle"></i> Shuffle</button>
        <button class="action-btn btn-clear"  id="btnClear"><i class="bi bi-x-circle"></i> Clear</button>
        <button class="action-btn btn-repeat disabled-btn" id="btnRepeat"><i class="bi bi-arrow-repeat"></i> Repeat</button>
    </div>

    <div class="call-bar" id="callBar">
        <div class="call-info">
            <div class="call-label">SELECT PITCH &amp; LOCATION</div>
            <div class="call-text" id="callText" style="display:none;"></div>
        </div>
        <button class="btn-call disabled-btn" id="btnCall"><i class="bi bi-megaphone"></i> Call Pitch</button>
    </div>

    <div class="ps-tour-overlay" id="psTourOverlay">
        <div class="ps-tour-backdrop"></div>
        <div class="ps-tour-highlight" id="psTourHighlight"></div>
        <div class="ps-tour-card" id="psTourCard">
            <div class="ps-tour-step-label" id="psTourStepLabel"></div>
            <h4 id="psTourTitle"></h4>
            <p id="psTourBody"></p>
            <div class="ps-tour-footer">
                <div class="ps-tour-dots" id="psTourDots"></div>
                <button class="ps-tour-next" id="psTourNext">Next</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="pitcherJson"><%- JSON.stringify(pitcher) %></script>
<script>
    const pitcherData   = JSON.parse(document.getElementById('pitcherJson').textContent);
    const isRHP         = pitcherData.throws === 'R';
    const pitchTypes    = pitcherData.pitchTypes || [];
    const zoneLocations = pitcherData.zone ? pitcherData.zone.availableLocations : [];

    let selectedPitchIndex = null;
    let selectedLocation   = null;
    let lastCall           = null;

    // ── Zone layouts ──────────────────────────────────────────
    const LAYOUTS_C = {
        'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 },
        'up-out':         { row: 1, col: 2 },
        'arm-out-up':     { row: 1, col: isRHP ? 5 : 1 },
        'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
        'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true },
        'mid-up':         { row: 2, col: 3,              strike: true },
        'arm-up':         { row: 2, col: isRHP ? 4 : 2, strike: true },
        'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
        'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true },
        'mid-mid':        { row: 3, col: 3,              strike: true },
        'arm-mid':        { row: 3, col: isRHP ? 4 : 2, strike: true },
        'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true },
        'mid-down':       { row: 4, col: 3,              strike: true },
        'arm-down':       { row: 4, col: isRHP ? 4 : 2, strike: true },
        'glove-out-down': { row: 5, col: isRHP ? 1 : 5 },
        'down-out':       { row: 5, col: 2 },
        'arm-out-down':   { row: 5, col: isRHP ? 5 : 1 },
    };
    // Zone D: chase cells are invisible anchors, strike cells are solid 2x2
    const LAYOUTS_D = {
        'up-out':     { row: 1, col: 2, colSpan: 2, anchor: true },
        'glove-out':  { row: 2, col: isRHP ? 1 : 4, rowSpan: 2, anchor: true },
        'glove-up':   { row: 2, col: isRHP ? 2 : 3, strike: true },
        'arm-up':     { row: 2, col: isRHP ? 3 : 2, strike: true },
        'arm-out':    { row: 2, col: isRHP ? 4 : 1, rowSpan: 2, anchor: true },
        'glove-down': { row: 3, col: isRHP ? 2 : 3, strike: true },
        'arm-down':   { row: 3, col: isRHP ? 3 : 2, strike: true },
        'down-out':   { row: 4, col: 2, colSpan: 2, anchor: true },
        'corner-top-glove': { row: 1, col: isRHP ? 1 : 4 },
        'corner-top-arm':   { row: 1, col: isRHP ? 4 : 1 },
        'corner-bot-glove': { row: 4, col: isRHP ? 1 : 4 },
        'corner-bot-arm':   { row: 4, col: isRHP ? 4 : 1 },
    };
    const LAYOUTS_A = {
        'arm-side':   { row: 1, col: isRHP ? 2 : 1, strike: true },
        'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true },
    };
    const LAYOUTS_B = {
        'up':   { row: 1, col: 1, strike: true },
        'down': { row: 2, col: 1, strike: true },
    };
    const LAYOUTS_A_IA = {
        'away-side':   { row: 1, col: 1, strike: true },
        'inside-side': { row: 1, col: 2, strike: true },
    };
    const LAYOUTS_C_IA = {
        'away-out-up':     { row: 1, col: 1 },
        'up-out':          { row: 1, col: 2 },
        'inside-out-up':   { row: 1, col: 5 },
        'away-out-mid':    { row: 2, col: 1, rowSpan: 3 },
        'away-up':         { row: 2, col: 2, strike: true },
        'mid-up':          { row: 2, col: 3, strike: true },
        'inside-up':       { row: 2, col: 4, strike: true },
        'inside-out-mid':  { row: 2, col: 5, rowSpan: 3 },
        'away-mid':        { row: 3, col: 2, strike: true },
        'mid-mid':         { row: 3, col: 3, strike: true },
        'inside-mid':      { row: 3, col: 4, strike: true },
        'away-down':       { row: 4, col: 2, strike: true },
        'mid-down':        { row: 4, col: 3, strike: true },
        'inside-down':     { row: 4, col: 4, strike: true },
        'away-out-down':   { row: 5, col: 1 },
        'down-out':        { row: 5, col: 2 },
        'inside-out-down': { row: 5, col: 5 },
    };
    const LAYOUTS_D_IA = {
        'up-out':      { row: 1, col: 2, colSpan: 2, anchor: true },
        'away-out':    { row: 2, col: 1, rowSpan: 2, anchor: true },
        'away-up':     { row: 2, col: 2, strike: true },
        'inside-up':   { row: 2, col: 3, strike: true },
        'inside-out':  { row: 2, col: 4, rowSpan: 2, anchor: true },
        'away-down':   { row: 3, col: 2, strike: true },
        'inside-down': { row: 3, col: 3, strike: true },
        'down-out':    { row: 4, col: 2, colSpan: 2, anchor: true },
    };

    function getLayout(locs) {
        const n = new Set(locs.map(l => l.name));
        if (n.has('mid-up') && n.has('glove-up'))  return LAYOUTS_C;
        if (n.has('mid-up') && n.has('inside-up')) return LAYOUTS_C_IA;
        if (n.has('glove-up') && n.has('arm-up'))  return LAYOUTS_D;
        if (n.has('away-up') && n.has('inside-up'))return LAYOUTS_D_IA;
        if (n.has('arm-side'))    return LAYOUTS_A;
        if (n.has('inside-side')) return LAYOUTS_A_IA;
        if (n.has('up'))          return LAYOUTS_B;
        return LAYOUTS_C;
    }

    const usesOverlays = locs => {
        const n = new Set(locs.map(l => l.name));
        return n.has('glove-up') || n.has('inside-up') || n.has('away-up');
    };
    const isZoneD = locs => {
        const n = new Set(locs.map(l => l.name));
        return (n.has('glove-up') || n.has('away-up')) && !n.has('mid-up');
    };

    let _boxSize = 70;

    function buildGrid() {
    const grid    = document.getElementById('zoneGrid');
    const wrapper = document.getElementById('zoneWrapper');
    grid.innerHTML = '';
    wrapper.querySelectorAll('.chase-overlay, .strike-zone-outline').forEach(el => el.remove());
    if (!zoneLocations.length) return;

    const layout = getLayout(zoneLocations);
    const maxRow = Math.max(...Object.values(layout).map(p => (p.row||1) + (p.rowSpan||1) - 1));
    const maxCol = Math.max(...Object.values(layout).map(p => (p.col||1) + (p.colSpan||1) - 1));

    const labelEl = wrapper.querySelector('.pitchers-view-label');
    const labelH  = labelEl ? labelEl.offsetHeight + 2 : 0;

    const zoneArea = document.querySelector('.zone-area');
    const _availH  = ((zoneArea && zoneArea.offsetHeight > 0)
        ? zoneArea.offsetHeight
        : window.innerHeight - 56 - 44 - 44 - 48) - labelH;

    _boxSize = Math.floor(_availH / maxRow);
    const gamePanel = document.querySelector('.game-page');
    const _availW = (gamePanel ? gamePanel.offsetWidth : window.innerWidth) - 4;
    const _boxW   = Math.floor(_availW / maxCol);
    _boxSize = Math.min(_boxSize, _boxW);
    _boxSize = Math.max(_boxSize, 44);
    if (maxRow <= 2) _boxSize = Math.min(_boxSize, 120);

        grid.style.gridTemplateRows    = `repeat(${maxRow}, ${_boxSize}px)`;
        grid.style.gridTemplateColumns = `repeat(${maxCol}, ${_boxSize}px)`;

        // Add corner fillers for Zone D BEFORE the location cells
        if (isZoneD(zoneLocations)) {
            const upOut   = zoneLocations.find(l => l.name === 'up-out');
            const downOut = zoneLocations.find(l => l.name === 'down-out');
            const upClass   = (upOut   && upOut.enabled   === false) ? 'loc-box chase disabled' : 'loc-box chase';
            const downClass = (downOut && downOut.enabled === false) ? 'loc-box chase disabled' : 'loc-box chase';
            const cornerPositions = [
                { row: 1, col: isRHP ? 1 : 4, cls: upClass,   name: 'corner-top-glove' },
                { row: 1, col: isRHP ? 4 : 1, cls: upClass,   name: 'corner-top-arm'   },
                { row: 4, col: isRHP ? 1 : 4, cls: downClass, name: 'corner-bot-glove' },
                { row: 4, col: isRHP ? 4 : 1, cls: downClass, name: 'corner-bot-arm'   },
            ];
            cornerPositions.forEach(pos => {
                const filler = document.createElement('div');
                filler.className = pos.cls;
                filler.dataset.locName = pos.name;
                filler.style.gridRow       = String(pos.row);
                filler.style.gridColumn    = String(pos.col);
                filler.style.pointerEvents = 'none';
                filler.style.cursor        = 'default';
                grid.appendChild(filler);
            });
        }

        zoneLocations.forEach(loc => {
            const pos = layout[loc.name];
            if (!pos) return;
            const box = document.createElement('div');
            const cls = pos.anchor ? 'anchor' : (loc.type === 'chase' ? 'chase' : 'strike');
            box.className        = `loc-box ${cls}`;
            box.textContent      = pos.anchor ? '' : loc.name.replace(/-/g, ' ');
            box.dataset.locName  = loc.name;
            box.dataset.isStrike = pos.strike ? 'true' : 'false';
            box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
            box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
            grid.appendChild(box);
        });

        drawOutline(layout);
        if (usesOverlays(zoneLocations)) drawOverlays(layout);
        if (selectedLocation) highlightLocation(selectedLocation);
    }

    function cellBounds(pos) {
        return {
            top:    (pos.row - 1) * _boxSize,
            left:   (pos.col - 1) * _boxSize,
            bottom: ((pos.row - 1) + (pos.rowSpan || 1)) * _boxSize,
            right:  ((pos.col - 1) + (pos.colSpan || 1)) * _boxSize,
        };
    }

    function drawOutline(layout) {
        const wrapper      = document.getElementById('zoneWrapper');
        const labelEl      = wrapper.querySelector('.pitchers-view-label');
        const labelH       = labelEl ? labelEl.offsetHeight + 2 : 0;
        const strikePosArr = Object.values(layout).filter(p => p.strike);
        if (!strikePosArr.length) return;
        let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
        strikePosArr.forEach(pos => {
            const bnd = cellBounds(pos);
            t = Math.min(t, bnd.top);    l = Math.min(l, bnd.left);
            b = Math.max(b, bnd.bottom); r = Math.max(r, bnd.right);
        });
        const outline = document.createElement('div');
        outline.className = 'strike-zone-outline';
        Object.assign(outline.style, { top: (t + 2 + labelH) + 'px', left: (l + 2) + 'px', width: (r - l) + 'px', height: (b - t) + 'px' });
        wrapper.appendChild(outline);
    }

    function drawOverlays(layout) {
        const wrapper    = document.getElementById('zoneWrapper');
        const grid       = document.getElementById('zoneGrid');
        const labelEl    = wrapper.querySelector('.pitchers-view-label');
        const labelH     = labelEl ? labelEl.offsetHeight + 2 : 0;
        wrapper.querySelectorAll('.chase-overlay').forEach(el => el.remove());

        function spanBounds(names) {
            let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
            names.forEach(name => {
                const pos = layout[name];
                if (!pos) return;
                const bnd = cellBounds(pos);
                t = Math.min(t, bnd.top);    l = Math.min(l, bnd.left);
                b = Math.max(b, bnd.bottom); r = Math.max(r, bnd.right);
            });
            return { t, l, b, r };
        }

        function makeOverlay(locName, label, hCellNames, vCellNames) {
            const loc = zoneLocations.find(z => z.name === locName);
            if (!loc) return;
            const hb = spanBounds(hCellNames);
            const vb = spanBounds(vCellNames);
            if (!isFinite(hb.l) || !isFinite(vb.t)) return;
            // Mark the anchor cell as covered so it doesn't interfere with clicks
            const cell = [...grid.querySelectorAll('.loc-box')].find(el => el.dataset.locName === locName);
            if (cell) cell.classList.add('covered');
            const el = document.createElement('div');
            el.className       = 'chase-overlay' + (loc.enabled === false ? ' disabled' : '');
            el.textContent     = label;
            el.dataset.locName = locName;
            Object.assign(el.style, {
                top:    (vb.t + 2 + labelH) + 'px',
                left:   (hb.l + 2) + 'px',
                width:  (hb.r - hb.l) + 'px',
                height: (vb.b - vb.t) + 'px',
            });
            wrapper.appendChild(el);
        }

        const locNames     = new Set(zoneLocations.map(l => l.name));
        const isInsideAway = locNames.has('inside-up') || locNames.has('inside-down');

        if (isZoneD(zoneLocations)) {
            if (isInsideAway) {
                makeOverlay('up-out',     'up out',   ['corner-top-glove', 'away-up',   'inside-up',   'corner-top-arm'],   ['up-out']);
                makeOverlay('down-out',   'down out', ['corner-bot-glove', 'away-down', 'inside-down', 'corner-bot-arm'],   ['down-out']);
                makeOverlay('away-out',   'away out',   ['away-out'],  ['away-up',   'away-down']);
                makeOverlay('inside-out', 'inside out', ['inside-out'],['inside-up', 'inside-down']);
            } else {
                makeOverlay('up-out',    'up out',   ['corner-top-glove', 'glove-up',   'arm-up',   'corner-top-arm'],   ['up-out']);
                makeOverlay('down-out',  'down out', ['corner-bot-glove', 'glove-down', 'arm-down', 'corner-bot-arm'],   ['down-out']);
                makeOverlay('glove-out', isRHP ? 'glove out' : 'arm out',
                    ['glove-out'], ['glove-up', 'glove-down']);
                makeOverlay('arm-out',   isRHP ? 'arm out' : 'glove out',
                    ['arm-out'],   ['arm-up', 'arm-down']);
            }
        } else {
            if (isInsideAway) {
                makeOverlay('up-out',         'up out',     ['away-up', 'mid-up', 'inside-up'],      ['up-out']);
                makeOverlay('down-out',       'down out',   ['away-down', 'mid-down', 'inside-down'], ['down-out']);
                makeOverlay('inside-out-mid', 'inside out', ['inside-out-mid'], ['inside-up', 'inside-mid', 'inside-down']);
                makeOverlay('away-out-mid',   'away out',   ['away-out-mid'],   ['away-up', 'away-mid', 'away-down']);
            } else {
                const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
                const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';
                makeOverlay('up-out',      'up out',    ['glove-up', 'mid-up', 'arm-up'],       ['up-out']);
                makeOverlay('down-out',    'down out',  ['glove-down', 'mid-down', 'arm-down'],  ['down-out']);
                makeOverlay(armOutName,   isRHP ? 'arm out'   : 'glove out',
                    [armOutName],   isRHP ? ['arm-up','arm-mid','arm-down']     : ['glove-up','glove-mid','glove-down']);
                makeOverlay(gloveOutName, isRHP ? 'glove out' : 'arm out',
                    [gloveOutName], isRHP ? ['glove-up','glove-mid','glove-down'] : ['arm-up','arm-mid','arm-down']);
            }
        }
    }

    function selectPitch(index) {
        selectedPitchIndex = index;
        document.querySelectorAll('.pitch-btn').forEach((btn, i) => btn.classList.toggle('active', i === index));
        updateCallBar(); updateButtons();
    }
    function selectLocation(locName) {
        selectedLocation = locName;
        highlightLocation(locName);
        updateCallBar(); updateButtons();
    }
    function highlightLocation(locName) {
        document.querySelectorAll('.loc-box, .chase-overlay').forEach(el =>
            el.classList.toggle('selected-loc', el.dataset.locName === locName));
    }
    function clearSelection() {
        selectedPitchIndex = null; selectedLocation = null;
        document.querySelectorAll('.pitch-btn').forEach(btn => btn.classList.remove('active'));
        highlightLocation(null); updateCallBar(); updateButtons();
    }

    const LOC_LABELS = {
        'glove-up': 'glove side up', 'glove-mid': 'glove side middle', 'glove-down': 'glove side down',
        'arm-up': 'arm side up', 'arm-mid': 'arm side middle', 'arm-down': 'arm side down',
        'mid-up': 'middle up', 'mid-mid': 'middle middle', 'mid-down': 'middle down',
        'glove-out-up': 'glove side up and out', 'glove-out-mid': 'glove side out', 'glove-out-down': 'glove side down and out',
        'arm-out-up': 'arm side up and out', 'arm-out-mid': 'arm side out', 'arm-out-down': 'arm side down and out',
        'up-out': 'up and out', 'down-out': 'down and out',
        'glove-side': 'glove side', 'arm-side': 'arm side', 'up': 'up', 'down': 'down',
        'away-up': 'away up', 'away-mid': 'away middle', 'away-down': 'away down',
        'inside-up': 'inside up', 'inside-mid': 'inside middle', 'inside-down': 'inside down',
        'away-out-up': 'away up and out', 'away-out-mid': 'away out', 'away-out-down': 'away down and out',
        'inside-out-up': 'inside up and out', 'inside-out-mid': 'inside out', 'inside-out-down': 'inside down and out',
        'away-side': 'away', 'inside-side': 'inside',
        'glove-out': 'glove side out', 'arm-out': 'arm side out',
        'away-out': 'away out', 'inside-out': 'inside out',
    };
    function locLabel(locName) { return LOC_LABELS[locName] || locName.replace(/-/g, ' '); }

    function updateCallBar() {
        const label = document.querySelector('#callBar .call-label');
        const text  = document.getElementById('callText');
        if (selectedPitchIndex !== null && selectedLocation) {
            label.textContent = 'CALL:';
            text.textContent  = `${pitchTypes[selectedPitchIndex].name} — ${locLabel(selectedLocation)}`;
            text.style.display = '';
        } else if (selectedPitchIndex !== null) {
            label.textContent = 'SELECT LOCATION'; text.style.display = 'none';
        } else if (selectedLocation) {
            label.textContent = 'SELECT PITCH TYPE'; text.style.display = 'none';
        } else {
            label.textContent = 'SELECT PITCH & LOCATION'; text.style.display = 'none';
        }
    }
    function updateButtons() {
        const ready = selectedPitchIndex !== null && selectedLocation !== null;
        document.getElementById('btnCall').classList.toggle('disabled-btn', !ready);
        document.getElementById('btnRepeat').classList.toggle('disabled-btn', !lastCall);
    }

    document.getElementById('pitchRow').addEventListener('click', e => {
        const btn = e.target.closest('.pitch-btn');
        if (btn) selectPitch(Number(btn.dataset.pitchIndex));
    });
    document.getElementById('zoneWrapper').addEventListener('click', e => {
        const el = e.target.closest('.loc-box:not(.covered):not(.anchor):not(.empty), .chase-overlay');
        if (el) selectLocation(el.dataset.locName);
    });
    document.getElementById('btnRandom').addEventListener('click', () => {
        const eligible = pitchTypes.filter(pt => pt.locations?.some(l => l.enabled));
        if (!eligible.length) return;

        // ── Weighted pitch type selection ──────────────────────
        const shuffleSettings = pitcherData.shuffleSettings || {};
        const pitchWeights    = shuffleSettings.pitchWeights || {};
        const strikeChancePct = shuffleSettings.strikeChancePct != null
            ? shuffleSettings.strikeChancePct
            : (<%= currentUser && currentUser.preferences && currentUser.preferences.strikeChancePct != null ? currentUser.preferences.strikeChancePct : 70 %>);

        // Build weight array for eligible pitches
        const weights = eligible.map(pt => {
            const w = pitchWeights[pt.name];
            return (w != null && !isNaN(w)) ? parseInt(w) : 1;
        });
        const totalWeight = weights.reduce((a, b) => a + b, 0);
        let roll = Math.random() * totalWeight;
        let pt = eligible[eligible.length - 1];
        for (let i = 0; i < eligible.length; i++) {
            roll -= weights[i];
            if (roll <= 0) { pt = eligible[i]; break; }
        }
        const pitchIndex = pitchTypes.indexOf(pt);

        // ── Weighted strike/chase location selection ───────────
        const strikeLocs = pt.locations.filter(l => l.enabled && l.type === 'strike');
        const chaseLocs  = pt.locations.filter(l => l.enabled && l.type === 'chase');
        let locPool;
        if (strikeLocs.length && chaseLocs.length) {
            // Both types available — use the weighted split
            locPool = Math.random() * 100 < strikeChancePct ? strikeLocs : chaseLocs;
        } else if (strikeLocs.length) {
            // Only strike locations available — always pick strike regardless of slider
            locPool = strikeLocs;
        } else if (chaseLocs.length) {
            // Only chase locations available — always pick chase regardless of slider
            locPool = chaseLocs;
        } else {
            return; // No enabled locations at all
        }
        const loc = locPool[Math.floor(Math.random() * locPool.length)];
        selectPitch(pitchIndex);
        // Flash the cell if it's the same location as before
        if (loc.name === selectedLocation) {
            document.querySelectorAll(`[data-loc-name="${loc.name}"]`).forEach(el => {
                el.classList.remove('selected-loc');
            });
            setTimeout(() => selectLocation(loc.name), 150);
        } else {
            selectLocation(loc.name);
        }
    });
    document.getElementById('btnClear').addEventListener('click', clearSelection);
    document.getElementById('btnRepeat').addEventListener('click', () => { if (lastCall) speak(lastCall.pitchName, lastCall.locName); });

    function speak(pitchName, locName) {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(locName ? `${pitchName}, ${locLabel(locName)}` : pitchName);
        utter.rate = 0.95;
        function applyVoiceAndSpeak() {
            const savedURI = window.PS_VOICE_URI || '';
            if (savedURI) { const voices = window.speechSynthesis.getVoices(); const match = voices.find(v => v.voiceURI === savedURI); if (match) utter.voice = match; }
            const bar = document.getElementById('callBar');
            const dot = Object.assign(document.createElement('span'), { className: 'speaking-dot' });
            utter.onstart = () => bar.appendChild(dot);
            utter.onend = utter.onerror = () => dot.parentNode?.removeChild(dot);
            window.speechSynthesis.speak(utter);
        }
        applyVoiceAndSpeak();
    }

    const TOUR_KEY = 'ps_game_tour_v2';
    const TOUR_STEPS = [
        { targetId: 'pitchRow',    title: 'Select a pitch type',    body: 'Tap any pitch type button to choose what you want to throw.',                                                                  position: 'below' },
        { targetId: 'zoneWrapper', title: 'Select a pitch location', body: 'Tap a location on the zone to choose where the pitch should go.',                                                            position: 'above' },
        { targetId: 'actionRow',   title: 'Shuffle, Clear & Repeat',  body: 'Shuffle picks a random pitch type and location for you. Clear resets your selection. Repeat re-announces the last call.',    position: 'above' },
        { targetId: 'callBar',     title: 'Your call appears here',  body: 'Once a pitch type and location are selected your call shows up here. Tap Call Pitch to send the call to your catcher.',     position: 'above' },
    ];
    let _tourStep = 0;
    function _tourShow(step) {
        const ov = document.getElementById('psTourOverlay'), hl = document.getElementById('psTourHighlight'), card = document.getElementById('psTourCard');
        const s = TOUR_STEPS[step], el = document.getElementById(s.targetId);
        if (!el) return;
        const r = el.getBoundingClientRect(), pad = 8;
        ov.style.display = 'block';
        Object.assign(hl.style, { top: (r.top-pad)+'px', left: (r.left-pad)+'px', width: (r.width+pad*2)+'px', height: (r.height+pad*2)+'px' });
        document.getElementById('psTourStepLabel').textContent = `Step ${step+1} of ${TOUR_STEPS.length}`;
        document.getElementById('psTourTitle').textContent = s.title;
        document.getElementById('psTourBody').textContent  = s.body;
        document.getElementById('psTourNext').textContent  = step === TOUR_STEPS.length-1 ? 'Got it' : 'Next';
        const dots = document.getElementById('psTourDots'); dots.innerHTML = '';
        TOUR_STEPS.forEach((_,i) => { const d = document.createElement('div'); d.className = 'ps-tour-dot'+(i===step?' active':''); dots.appendChild(d); });
        const cardW = Math.min(300, window.innerWidth*0.88), cardLeft = Math.max(8, Math.min(r.left, window.innerWidth-cardW-8));
        card.style.width = cardW+'px'; card.style.left = cardLeft+'px'; card.style.top = card.style.bottom = '';
        if (s.position === 'below') { card.style.top = (r.bottom+pad+10)+'px'; }
        else { const estH=180, margin=12; if(r.top-pad-margin-estH>=estH){card.style.top=(r.top-pad-margin-estH)+'px';}else if(window.innerHeight-r.bottom-pad-margin-estH>=estH){card.style.top=(r.bottom+pad+margin)+'px';}else{card.style.top=Math.max(margin,r.top+r.height/2-estH/2)+'px';} }
    }
    document.getElementById('psTourNext').addEventListener('click', () => {
        _tourStep++;
        if (_tourStep >= TOUR_STEPS.length) document.getElementById('psTourOverlay').style.display = 'none';
        else _tourShow(_tourStep);
    });
    if (!localStorage.getItem(TOUR_KEY)) { localStorage.setItem(TOUR_KEY,'1'); setTimeout(() => requestAnimationFrame(() => _tourShow(0)), 1500); }

    let resizeTimer;
    requestAnimationFrame(buildGrid);
    window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(buildGrid, 100); });

    const pickoffOverlay = document.getElementById('pickoffOverlay');
    document.getElementById('btnPickoff').addEventListener('click', () => { pickoffOverlay.style.display = 'flex'; });
    document.getElementById('btnCancelPickoff').addEventListener('click', () => { pickoffOverlay.style.display = 'none'; });
    pickoffOverlay.querySelectorAll('.base-btn[data-base]').forEach(btn => {
        btn.addEventListener('click', () => {
            const base = btn.dataset.base; if (!base) return;
            pickoffOverlay.style.display = 'none';
            const label = document.querySelector('#callBar .call-label'), text = document.getElementById('callText');
            label.textContent = 'CALL:'; text.textContent = `Pickoff — ${base} Base`; text.style.display = '';
            const btnCall = document.getElementById('btnCall'); btnCall.classList.remove('disabled-btn');
            function handlePickoffCall() {
                const baseLabel = base==='1st'?'first base':base==='2nd'?'second base':'third base';
                speak('Pickoff', baseLabel);
                btnCall.removeEventListener('click', handlePickoffCall);
                btnCall.addEventListener('click', normalCallHandler);
            }
            btnCall.removeEventListener('click', normalCallHandler);
            btnCall.addEventListener('click', handlePickoffCall);
        });
    });
    document.getElementById('btnPitchout').addEventListener('click', () => {
        clearSelection();
        const label = document.querySelector('#callBar .call-label'), text = document.getElementById('callText');
        label.textContent = 'CALL:'; text.textContent = 'Pitchout'; text.style.display = '';
        const btnCall = document.getElementById('btnCall'); btnCall.classList.remove('disabled-btn');
        function handlePitchoutCall() { speak('Pitchout',''); btnCall.removeEventListener('click',handlePitchoutCall); btnCall.addEventListener('click',normalCallHandler); }
        btnCall.removeEventListener('click', normalCallHandler);
        btnCall.addEventListener('click', handlePitchoutCall);
    });
    function normalCallHandler() {
        if (selectedPitchIndex === null || !selectedLocation) return;
        const pitchName = pitchTypes[selectedPitchIndex].name;
        lastCall = { pitchName, locName: selectedLocation };
        speak(pitchName, selectedLocation); updateButtons();
    }
    document.getElementById('btnCall').addEventListener('click', normalCallHandler);
</script>
