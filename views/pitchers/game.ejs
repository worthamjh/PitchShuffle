<%- layout('layouts/boilerplate') %>

<style>
    /* ── Page-specific only: speaking dot animation ─────────── */
    .speaking-dot {
        display: inline-block; width: 8px; height: 8px; border-radius: 50%;
        background: #2ecc71; margin-left: 4px; vertical-align: middle;
        animation: pulse 0.8s infinite alternate;
    }
    @keyframes pulse { from { opacity: 0.3; transform: scale(0.8); } to { opacity: 1; transform: scale(1.2); } }

    /* ── Call bar style for game.ejs (dark navy bar) ─────────── */
    .call-bar {
        flex-shrink: 0; min-height: 38px;
        background: var(--ps-navy); color: #fff;
        display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 600;
    }
    .call-bar .call-label { color: var(--ps-navy-muted); font-weight: 400; font-size: 0.75rem; }
</style>

<!-- ── Header ──────────────────────────────────────────────────── -->
<div class="game-header">
    <a href="/teams/<%= team._id %>" class="btn btn-sm btn-outline-light">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="pitcher-info">
        <div class="pitcher-name">#<%= pitcher.number %> <%= pitcher.name %></div>
        <div class="pitcher-meta"><%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %></div>
    </div>
    <a href="/teams/<%= team._id %>/pitchers/game?from=<%= pitcher._id %>" class="btn btn-sm btn-outline-light">Change Pitcher</a>
</div>

<!-- ── Body ───────────────────────────────────────────────────── -->
<div class="game-body">

    <div class="pitch-col" id="pitchCol">
        <% pitcher.pitchTypes.forEach(function(pt, i) { %>
            <button class="pitch-btn" data-pitch-index="<%= i %>"><%= pt.name %></button>
        <% }); %>
    </div>

    <div class="zone-col">
        <div class="zone-grid-wrapper" id="zoneWrapper">
            <div class="zone-grid" id="zoneGrid"></div>
        </div>
    </div>

    <div class="action-col">
        <button class="action-btn btn-random" id="btnRandom"><i class="bi bi-shuffle"></i><br>Random</button>
        <button class="action-btn btn-clear"  id="btnClear"><i class="bi bi-x-circle"></i><br>Clear</button>
        <button class="action-btn btn-repeat disabled-btn" id="btnRepeat"><i class="bi bi-arrow-repeat"></i><br>Repeat</button>
        <button class="action-btn btn-call disabled-btn"   id="btnCall"><i class="bi bi-megaphone"></i><br>Call Pitch</button>
    </div>

</div>

<!-- ── Bottom bar ─────────────────────────────────────────────── -->
<div class="call-bar" id="callBar">
    <span class="call-label">SELECT PITCH & LOCATION</span>
</div>

<!-- ── Data ───────────────────────────────────────────────────── -->
<script type="application/json" id="pitcherJson"><%- JSON.stringify({
    throws:     pitcher.throws,
    pitchTypes: pitcher.pitchTypes,
    zone:       pitcher.zone
}) %></script>

<script>
    const pitcherData   = JSON.parse(document.getElementById('pitcherJson').textContent);
    const isRHP         = pitcherData.throws === 'R';
    const pitchTypes    = pitcherData.pitchTypes || [];
    const zoneLocations = (pitcherData.zone?.availableLocations || [])
                            .map(l => ({ ...l, enabled: true }));

    let selectedPitchIndex = null;
    let selectedLocation   = null;
    let lastCall           = null;

    // ── Zone layouts ──────────────────────────────────────────
    const LAYOUTS_C = {
        'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 },
        'up-out':         { row: 1, col: 2 },
        'arm-out-up':     { row: 1, col: isRHP ? 5 : 1 },
        'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
        'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true },
        'mid-up':         { row: 2, col: 3,              strike: true },
        'arm-up':         { row: 2, col: isRHP ? 4 : 2, strike: true },
        'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
        'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true },
        'mid-mid':        { row: 3, col: 3,              strike: true },
        'arm-mid':        { row: 3, col: isRHP ? 4 : 2, strike: true },
        'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true },
        'mid-down':       { row: 4, col: 3,              strike: true },
        'arm-down':       { row: 4, col: isRHP ? 4 : 2, strike: true },
        'glove-out-down': { row: 5, col: isRHP ? 1 : 5 },
        'down-out':       { row: 5, col: 2 },
        'arm-out-down':   { row: 5, col: isRHP ? 5 : 1 },
    };
    const LAYOUTS_A = {
        'arm-side':   { row: 1, col: isRHP ? 2 : 1, strike: true },
        'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true },
    };
    const LAYOUTS_B = {
        'up':   { row: 1, col: 1, strike: true },
        'down': { row: 2, col: 1, strike: true },
    };

    function getLayout(locs) {
        const n = new Set(locs.map(l => l.name));
        if (n.has('glove-up')) return LAYOUTS_C;
        if (n.has('arm-side')) return LAYOUTS_A;
        if (n.has('up'))       return LAYOUTS_B;
        return LAYOUTS_C;
    }
    const isZoneC = locs => new Set(locs.map(l => l.name)).has('glove-up');

    // ── Build grid ────────────────────────────────────────────
    function buildGrid() {
        const grid    = document.getElementById('zoneGrid');
        const wrapper = document.getElementById('zoneWrapper');
        grid.innerHTML = '';
        wrapper.querySelectorAll('.chase-overlay, .strike-zone-outline').forEach(el => el.remove());
        if (!zoneLocations.length) return;

        const layout  = getLayout(zoneLocations);
        const maxRow  = Math.max(...Object.values(layout).map(p => (p.row||1) + (p.rowSpan||1) - 1));
        const maxCol  = Math.max(...Object.values(layout).map(p => (p.col||1) + (p.colSpan||1) - 1));
        const boxSize = window.innerWidth >= 992 ? 108 : window.innerWidth >= 576 ? 88 : 70;

        grid.style.gridTemplateRows    = `repeat(${maxRow}, ${boxSize}px)`;
        grid.style.gridTemplateColumns = `repeat(${maxCol}, ${boxSize}px)`;

        zoneLocations.forEach(loc => {
            const pos = layout[loc.name];
            if (!pos) return;
            const box = document.createElement('div');
            box.className        = `loc-box ${loc.type === 'chase' ? 'chase' : 'strike'}`;
            box.textContent      = loc.name.replace(/-/g, ' ');
            box.dataset.locName  = loc.name;
            box.dataset.isStrike = pos.strike ? 'true' : 'false';
            box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
            box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
            grid.appendChild(box);
        });

        requestAnimationFrame(() => {
            drawOutline();
            if (isZoneC(zoneLocations)) drawOverlays();
            if (selectedLocation) highlightLocation(selectedLocation);
        });
    }

    function drawOutline() {
        const grid  = document.getElementById('zoneGrid');
        const wrapper = document.getElementById('zoneWrapper');
        const cells = [...grid.querySelectorAll('[data-is-strike="true"]')];
        if (!cells.length) return;
        const gr = grid.getBoundingClientRect();
        let t = Infinity, l = Infinity, b = -Infinity, r = -Infinity;
        cells.forEach(c => {
            const cr = c.getBoundingClientRect();
            t = Math.min(t, cr.top    - gr.top);
            l = Math.min(l, cr.left   - gr.left);
            b = Math.max(b, cr.bottom - gr.top);
            r = Math.max(r, cr.right  - gr.left);
        });
        const outline = document.createElement('div');
        outline.className = 'strike-zone-outline';
        Object.assign(outline.style, { top: t+'px', left: l+'px', width: (r-l)+'px', height: (b-t)+'px' });
        wrapper.appendChild(outline);
    }

    function drawOverlays() {
        const grid    = document.getElementById('zoneGrid');
        const wrapper = document.getElementById('zoneWrapper');
        const gr      = grid.getBoundingClientRect();
        const getCell = name => [...grid.querySelectorAll('.loc-box')]
            .find(el => el.dataset.locName === name);

        function spanBounds(names) {
            let t = Infinity, l = Infinity, r = -Infinity, b = -Infinity;
            names.forEach(name => {
                const el = getCell(name);
                if (!el) return;
                const cr = el.getBoundingClientRect();
                t = Math.min(t, cr.top    - gr.top);
                l = Math.min(l, cr.left   - gr.left);
                r = Math.max(r, cr.right  - gr.left);
                b = Math.max(b, cr.bottom - gr.top);
            });
            return { t, l, r, b };
        }

        function makeOverlay(locName, label, hCells, vCells, covered) {
            if (!zoneLocations.find(z => z.name === locName)) return;
            const hb = spanBounds(hCells);
            const vb = spanBounds(vCells);
            if (!isFinite(hb.l) || !isFinite(vb.t)) return;
            const el = document.createElement('div');
            el.className       = 'chase-overlay';
            el.textContent     = label;
            el.dataset.locName = locName;
            Object.assign(el.style, {
                top: vb.t+'px', left: hb.l+'px',
                width: (hb.r - hb.l)+'px', height: (vb.b - vb.t)+'px'
            });
            wrapper.appendChild(el);
            covered.forEach(name => {
                const cell = getCell(name);
                if (cell) cell.classList.add('covered');
            });
        }

        const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
        const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';
        const armOutHCells   = isRHP ? ['arm-up','arm-mid','arm-down']   : ['glove-up','glove-mid','glove-down'];
        const gloveOutHCells = isRHP ? ['glove-up','glove-mid','glove-down'] : ['arm-up','arm-mid','arm-down'];

        makeOverlay(armOutName,   armOutName.replace(/-/g,' '),   armOutHCells,   ['mid-up','mid-mid','mid-down'], []);
        makeOverlay(gloveOutName, gloveOutName.replace(/-/g,' '), gloveOutHCells, ['mid-up','mid-mid','mid-down'], []);
    }

    // ── Selection helpers ─────────────────────────────────────
    function selectPitch(index) {
        selectedPitchIndex = index;
        document.querySelectorAll('.pitch-btn').forEach((btn, i) =>
            btn.classList.toggle('active', i === index));
        updateCallBar();
        updateButtons();
    }

    function selectLocation(locName) {
        selectedLocation = locName;
        highlightLocation(locName);
        updateCallBar();
        updateButtons();
    }

    function highlightLocation(locName) {
        document.querySelectorAll('.loc-box, .chase-overlay').forEach(el =>
            el.classList.toggle('selected-loc', el.dataset.locName === locName));
    }

    function clearSelection() {
        selectedPitchIndex = null;
        selectedLocation   = null;
        document.querySelectorAll('.pitch-btn').forEach(btn => btn.classList.remove('active'));
        highlightLocation(null);
        updateCallBar();
        updateButtons();
    }

    // ── LOC labels for speech ─────────────────────────────────
    const LOC_LABELS = {
        'glove-up':       'glove side up',
        'glove-mid':      'glove side middle',
        'glove-down':     'glove side down',
        'arm-up':         'arm side up',
        'arm-mid':        'arm side middle',
        'arm-down':       'arm side down',
        'mid-up':         'middle up',
        'mid-mid':        'middle middle',
        'mid-down':       'middle down',
        'glove-out-up':   'glove side up and out',
        'glove-out-mid':  'glove side out',
        'glove-out-down': 'glove side down and out',
        'arm-out-up':     'arm side up and out',
        'arm-out-mid':    'arm side out',
        'arm-out-down':   'arm side down and out',
        'up-out':         'up and out',
        'down-out':       'down and out',
        'glove-side':     'glove side',
        'arm-side':       'arm side',
        'up':             'up',
        'down':           'down',
    };
    function locLabel(locName) {
        return LOC_LABELS[locName] || locName.replace(/-/g, ' ');
    }

    function updateCallBar() {
        const bar = document.getElementById('callBar');
        if (selectedPitchIndex !== null && selectedLocation) {
            const name = pitchTypes[selectedPitchIndex].name;
            bar.innerHTML = `<span class="call-label">CALL:</span>${name} — ${locLabel(selectedLocation)}`;
        } else if (selectedPitchIndex !== null) {
            bar.innerHTML = `<span class="call-label">SELECT LOCATION</span>`;
        } else if (selectedLocation) {
            bar.innerHTML = `<span class="call-label">SELECT PITCH TYPE</span>`;
        } else {
            bar.innerHTML = `<span class="call-label">SELECT PITCH & LOCATION</span>`;
        }
    }

    function updateButtons() {
        const ready = selectedPitchIndex !== null && selectedLocation !== null;
        document.getElementById('btnCall').classList.toggle('disabled-btn', !ready);
        document.getElementById('btnRepeat').classList.toggle('disabled-btn', !lastCall);
    }

    // ── Event listeners ───────────────────────────────────────
    document.getElementById('pitchCol').addEventListener('click', e => {
        const btn = e.target.closest('.pitch-btn');
        if (btn) selectPitch(Number(btn.dataset.pitchIndex));
    });

    document.getElementById('zoneWrapper').addEventListener('click', e => {
        const el = e.target.closest('.loc-box:not(.covered):not(.empty), .chase-overlay');
        if (el) selectLocation(el.dataset.locName);
    });

    document.getElementById('btnRandom').addEventListener('click', () => {
        const eligible = pitchTypes.filter((_, i) => {
            const pt = pitchTypes[i];
            return pt.locations?.some(l => l.enabled);
        });
        const locs = zoneLocations.filter(l => l.enabled !== false);
        if (!pitchTypes.length || !locs.length) return;
        selectPitch(Math.floor(Math.random() * pitchTypes.length));
        selectLocation(locs[Math.floor(Math.random() * locs.length)].name);
    });

    document.getElementById('btnClear').addEventListener('click', clearSelection);

    document.getElementById('btnRepeat').addEventListener('click', () => {
        if (lastCall) speak(lastCall.pitchName, lastCall.locName);
    });

    document.getElementById('btnCall').addEventListener('click', () => {
        if (selectedPitchIndex === null || !selectedLocation) return;
        const pitchName = pitchTypes[selectedPitchIndex].name;
        lastCall = { pitchName, locName: selectedLocation };
        speak(pitchName, selectedLocation);
        updateButtons();
    });

    function speak(pitchName, locName) {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(`${pitchName}, ${locLabel(locName)}`);
        utter.rate  = 0.95;
        const bar   = document.getElementById('callBar');
        const dot   = Object.assign(document.createElement('span'), { className: 'speaking-dot' });
        utter.onstart = () => bar.appendChild(dot);
        utter.onend = utter.onerror = () => dot.parentNode?.removeChild(dot);
        window.speechSynthesis.speak(utter);
    }

    buildGrid();
    window.addEventListener('resize', buildGrid);
</script>
