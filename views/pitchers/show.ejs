<%- layout('layouts/boilerplate') %>

    <style>
        .zone-grid {
            display: grid;
            gap: 0;
            margin: 0 auto;
            border: 2px solid #adb5bd;
        }

        .loc-box {
            width: 70px;
            height: 70px;
            border-radius: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.55rem;
            font-weight: 700;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 4px;
            box-sizing: border-box;
            border: 1px solid rgba(0,0,0,0.12);
        }

        @media (min-width: 576px) {
            .loc-box { width: 88px; height: 88px; font-size: 0.6rem; }
        }
        @media (min-width: 992px) {
            .loc-box { width: 108px; height: 108px; font-size: 0.7rem; }
        }

        .loc-box.strike   { background-color: #c8ecd4; border: 1px solid #2e7d4f; color: #155724; }
        .loc-box.chase    { background-color: #fef3cd; border: 1px solid #d4a017; color: #856404; }
        .loc-box.disabled { background-color: #e9ecef; border: 1px solid #ced4da; color: #adb5bd; text-decoration: line-through; }
        .loc-box.empty    { background: transparent; border-color: transparent; pointer-events: none; }

        .chase-overlay {
            position: absolute;
            background-color: #fef3cd;
            border: 1px solid #d4a017;
            color: #856404;
            font-size: 0.55rem;
            font-weight: 700;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            z-index: 5;
            pointer-events: none;
        }
        .chase-overlay.disabled {
            background-color: #e9ecef;
            border-color: #ced4da;
            color: #adb5bd;
            text-decoration: line-through;
        }
        @media (min-width: 576px) { .chase-overlay { font-size: 0.6rem; } }
        @media (min-width: 992px) { .chase-overlay { font-size: 0.7rem; } }

        .strike-zone-outline {
            position: absolute;
            pointer-events: none;
            border: 3px solid #1a2e4a;
            z-index: 10;
        }

        .zone-grid-wrapper {
            display: inline-block;
            position: relative;
        }

        .pitchers-view-label {
            text-align: center;
            font-size: 0.7rem;
            font-weight: 600;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .zone-container { display: flex; justify-content: center; padding: 1rem 0; }
        .pitch-section  { border: 1px solid #dee2e6; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; background: #fff; }
    </style>

    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <h1><i class="bi bi-person-fill"></i> <%= pitcher.name %> #<%= pitcher.number %></h1>
        <div class="d-flex gap-2">
            <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/edit" class="btn btn-outline-light">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <button type="button" class="btn btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#deletePitcherModal">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>

    <!-- Delete Pitcher Modal -->
    <div class="modal fade" id="deletePitcherModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;overflow:hidden;">
                <div class="modal-header" style="background:#1a2e4a;color:#fff;border:none;">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Pitcher
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-1">Are you sure you want to delete <strong><%= pitcher.name %> #<%= pitcher.number %></strong>?</p>
                    <p class="text-muted small mb-0">This will permanently remove the pitcher and all their pitch data. This cannot be undone.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>?_method=DELETE" method="POST" style="margin:0;">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Basic Info -->
    <div class="card mb-4">
        <div class="card-header">Basic Info</div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5 mb-3 mb-md-0">
                    <p class="text-muted mb-1">Name</p>
                    <p class="fw-bold fs-5"><%= pitcher.name %></p>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <p class="text-muted mb-1">Jersey #</p>
                    <p class="fw-bold fs-5">#<%= pitcher.number %></p>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <p class="text-muted mb-1">Throws</p>
                    <p class="fw-bold fs-5"><%= pitcher.throws === 'R' ? 'Right' : 'Left' %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pitch Types -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Pitch Types & Locations</h5>
        <div class="btn-group" role="group">
            <input type="radio" class="btn-check" name="viewMode" id="visualMode" checked>
            <label class="btn btn-outline-primary btn-sm" for="visualMode">
                <i class="bi bi-grid-3x3"></i> Visual
            </label>
            <input type="radio" class="btn-check" name="viewMode" id="listMode">
            <label class="btn btn-outline-primary btn-sm" for="listMode">
                <i class="bi bi-list-check"></i> List
            </label>
        </div>
    </div>

    <% if (pitcher.pitchTypes.length === 0) { %>
        <div class="card">
            <div class="card-body text-center p-4 text-muted">No pitch types added yet.</div>
        </div>
    <% } else { %>
        <% for (var i = 0; i < pitcher.pitchTypes.length; i++) { %>
            <% var pitch = pitcher.pitchTypes[i]; %>
            <div class="pitch-section">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <h5 class="fw-bold mb-0"><%= pitch.name %></h5>
                    <span class="badge bg-secondary"><%= pitch.abbreviation %></span>
                </div>
                <div class="visual-view">
                    <div class="zone-container">
                        <div class="zone-grid-wrapper" id="wrapper-<%= i %>">
                            <div class="pitchers-view-label">Pitcher's View</div>
                            <div class="zone-grid" id="grid-<%= i %>"></div>
                        </div>
                    </div>
                </div>
                <div class="list-view" style="display:none;">
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <% for (var loc of pitch.locations) { %>
                            <span class="badge p-2
                                <% if (!loc.enabled) { %>bg-secondary
                                <% } else if (loc.type === 'chase') { %>bg-warning text-dark
                                <% } else { %>bg-success<% } %>">
                                <%= loc.enabled ? '' : '✕ ' %><%= loc.name %>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Legend -->
        <div class="d-flex gap-3 mb-4 flex-wrap">
            <span class="d-flex align-items-center gap-2">
                <span style="width:20px;height:20px;background:#c8ecd4;border:2px solid #2e7d4f;display:inline-block;"></span>
                <small>Strike location</small>
            </span>
            <span class="d-flex align-items-center gap-2">
                <span style="width:20px;height:20px;background:#fef3cd;border:2px solid #d4a017;display:inline-block;"></span>
                <small>Chase</small>
            </span>
            <span class="d-flex align-items-center gap-2">
                <span style="width:20px;height:20px;background:#e9ecef;border:2px solid #ced4da;display:inline-block;"></span>
                <small>Disabled</small>
            </span>
            <span class="d-flex align-items-center gap-2">
                <span style="width:20px;height:20px;border:3px solid #1a2e4a;display:inline-block;"></span>
                <small>Strike zone boundary</small>
            </span>
        </div>
    <% } %>

    <a href="/teams/<%= team._id %>" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Team
    </a>

    <script>
        const throws = '<%= pitcher.throws %>';
        const isRHP = throws === 'R';

        const ZONE_LAYOUTS_A = {
            'arm-side':   { row: 1, col: isRHP ? 2 : 1, strike: true },
            'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true },
        };
        const ZONE_LAYOUTS_B = {
            'up':   { row: 1, col: 1, strike: true },
            'down': { row: 2, col: 1, strike: true },
        };
        const ZONE_LAYOUTS_C = {
            'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 },
            'up-out':         { row: 1, col: 2 },
            'arm-out-up':     { row: 1, col: isRHP ? 5 : 1 },
            'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
            'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true },
            'mid-up':         { row: 2, col: 3,              strike: true },
            'arm-up':         { row: 2, col: isRHP ? 4 : 2, strike: true },
            'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
            'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true },
            'mid-mid':        { row: 3, col: 3,              strike: true },
            'arm-mid':        { row: 3, col: isRHP ? 4 : 2, strike: true },
            'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true },
            'mid-down':       { row: 4, col: 3,              strike: true },
            'arm-down':       { row: 4, col: isRHP ? 4 : 2, strike: true },
            'glove-out-down': { row: 5, col: isRHP ? 1 : 5 },
            'down-out':       { row: 5, col: 2 },
            'arm-out-down':   { row: 5, col: isRHP ? 5 : 1 },
        };

        function getZoneLayouts(locations) {
            const names = new Set(locations.map(l => l.name));
            if (names.has('glove-up')) return ZONE_LAYOUTS_C;
            if (names.has('arm-side')) return ZONE_LAYOUTS_A;
            if (names.has('up'))       return ZONE_LAYOUTS_B;
            return ZONE_LAYOUTS_C;
        }

        function isZoneC(locations) {
            return new Set(locations.map(l => l.name)).has('glove-up');
        }
    </script>

    <script type="application/json" id="pitchDataJson"><%- JSON.stringify(pitcher.pitchTypes || []) %></script>
    <script>
        const pitchData = JSON.parse(document.getElementById('pitchDataJson').textContent);

        function getBoxClass(loc) {
            if (!loc.enabled) return 'disabled';
            if (loc.type === 'chase') return 'chase';
            return 'strike';
        }

        function drawOutline(pitchIndex) {
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            const strikeCells = [...grid.querySelectorAll('[data-is-strike="true"]')];
            if (strikeCells.length === 0) return;
            const gridRect = grid.getBoundingClientRect();
            let top = Infinity, left = Infinity, bottom = -Infinity, right = -Infinity;
            strikeCells.forEach(cell => {
                const r = cell.getBoundingClientRect();
                top    = Math.min(top,    r.top    - gridRect.top);
                left   = Math.min(left,   r.left   - gridRect.left);
                bottom = Math.max(bottom, r.bottom - gridRect.top);
                right  = Math.max(right,  r.right  - gridRect.left);
            });
            const old = wrapper.querySelector('.strike-zone-outline');
            if (old) old.remove();
            const labelEl = wrapper.querySelector('.pitchers-view-label');
            const labelH  = labelEl ? labelEl.offsetHeight + 4 : 0;
            const outline = document.createElement('div');
            outline.className = 'strike-zone-outline';
            outline.style.top    = (top + labelH) + 'px';
            outline.style.left   = left + 'px';
            outline.style.width  = (right - left) + 'px';
            outline.style.height = (bottom - top) + 'px';
            wrapper.appendChild(outline);
        }

        function drawOverlays(pitchIndex, pitch) {
            const grid    = document.getElementById(`grid-${pitchIndex}`);
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            wrapper.querySelectorAll('.chase-overlay').forEach(el => el.remove());
            if (!isZoneC(pitch.locations)) return;

            const gridRect = grid.getBoundingClientRect();
            const labelEl  = wrapper.querySelector('.pitchers-view-label');
            const labelH   = labelEl ? labelEl.offsetHeight + 4 : 0;

            function getCell(locName) {
                return [...grid.querySelectorAll('.loc-box')]
                    .find(el => el.dataset.locName === locName);
            }

            function spanBounds(locNames) {
                let top = Infinity, left = Infinity, right = -Infinity, bottom = -Infinity;
                locNames.forEach(name => {
                    const el = getCell(name);
                    if (!el) return;
                    const r = el.getBoundingClientRect();
                    top    = Math.min(top,    r.top    - gridRect.top);
                    left   = Math.min(left,   r.left   - gridRect.left);
                    right  = Math.max(right,  r.right  - gridRect.left);
                    bottom = Math.max(bottom, r.bottom - gridRect.top);
                });
                return { top, left, right, bottom };
            }

            function makeOverlay(locName, label, spanCells, heightCells) {
                const locIndex = pitch.locations.findIndex(l => l.name === locName);
                const loc      = pitch.locations[locIndex];
                const enabled  = loc ? loc.enabled : true;
                const hb = spanBounds(spanCells);
                const vb = spanBounds(heightCells);
                const overlay = document.createElement('div');
                overlay.className    = 'chase-overlay' + (enabled ? '' : ' disabled');
                overlay.textContent  = label;
                overlay.style.top    = (vb.top  + labelH) + 'px';
                overlay.style.left   = hb.left + 'px';
                overlay.style.width  = (hb.right - hb.left) + 'px';
                overlay.style.height = (vb.bottom - vb.top) + 'px';
                wrapper.appendChild(overlay);
            }

            makeOverlay('up-out',   'up out',
                ['arm-up', 'mid-up', 'glove-up'], ['up-out']);
            makeOverlay('down-out', 'down out',
                ['arm-down', 'mid-down', 'glove-down'], ['down-out']);

            const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
            const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';
            const armLabel     = isRHP ? 'arm out'       : 'glove out';
            const gloveLabel   = isRHP ? 'glove out'     : 'arm out';

            makeOverlay(armOutName,   armLabel,
                [armOutName],   ['arm-up',   'arm-mid',   'arm-down']);
            makeOverlay(gloveOutName, gloveLabel,
                [gloveOutName], ['glove-up', 'glove-mid', 'glove-down']);
        }

        function buildGrid(pitchIndex) {
            const pitch = pitchData[pitchIndex];
            if (!pitch || !pitch.locations) return;
            const grid = document.getElementById(`grid-${pitchIndex}`);
            if (!grid) return;
            grid.innerHTML = '';
            const layout  = getZoneLayouts(pitch.locations);
            const maxRow  = Math.max(...Object.values(layout).map(p => (p.row || 1) + (p.rowSpan || 1) - 1));
            const maxCol  = Math.max(...Object.values(layout).map(p => (p.col || 1) + (p.colSpan || 1) - 1));
            const boxSize = window.innerWidth >= 992 ? 108 : window.innerWidth >= 576 ? 88 : 70;
            grid.style.gridTemplateRows    = `repeat(${maxRow}, ${boxSize}px)`;
            grid.style.gridTemplateColumns = `repeat(${maxCol}, ${boxSize}px)`;

            pitch.locations.forEach((loc) => {
                const pos = layout[loc.name];
                if (!pos) return;
                const box = document.createElement('div');
                box.className        = `loc-box ${getBoxClass(loc)}`;
                box.textContent      = loc.name.replace(/-/g, ' ');
                box.dataset.isStrike = pos.strike ? 'true' : 'false';
                box.dataset.locName  = loc.name;
                box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
                box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
                grid.appendChild(box);
            });
            requestAnimationFrame(() => {
                drawOutline(pitchIndex);
                drawOverlays(pitchIndex, pitch);
            });
        }

        pitchData.forEach((pitch, i) => buildGrid(i));
        window.addEventListener('resize', () => pitchData.forEach((p, i) => buildGrid(i)));

        document.getElementById('visualMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'block');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'none');
            pitchData.forEach((p, i) => requestAnimationFrame(() => {
                drawOutline(i);
                drawOverlays(i, p);
            }));
        });
        document.getElementById('listMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'block');
        });
    </script>
