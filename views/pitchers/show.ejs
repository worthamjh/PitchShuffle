<%- layout('layouts/boilerplate') %>

    <style>
        .zone-grid { display: grid; gap: 0; margin: 0 auto; border: 2px solid #adb5bd; }
        .zone-grid {width: fit-content;}
        .loc-box {
            width: 70px; height: 70px; border-radius: 0;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            font-size: 0.55rem; font-weight: 700; text-align: center; text-transform: uppercase;
            letter-spacing: 0.4px; padding: 4px; box-sizing: border-box; border: 1px solid rgba(0,0,0,0.12);
        }
        @media (min-width: 576px) { .loc-box { width: 88px; height: 88px; font-size: 0.6rem; } }
        @media (min-width: 992px) { .loc-box { width: 108px; height: 108px; font-size: 0.7rem; } }
        .zone-grid .loc-box { height: 100%; width: 100%; }
        .loc-box.strike   { background-color: var(--strike-bg); border: 1px solid var(--strike-border); color: var(--strike-text); }
        .loc-box.chase    { background-color: var(--chase-bg); border: 1px solid var(--chase-border); color: var(--chase-text); }
        .loc-box.disabled { background-color: #e9ecef; border: 1px solid #ced4da; color: #adb5bd; text-decoration: line-through; }
        .loc-box.empty    { background: transparent; border-color: transparent; pointer-events: none; }
        .loc-box.anchor   { background: transparent !important; border-color: transparent !important; pointer-events: none; cursor: default; }
        .chase-overlay {
            position: absolute; background-color: var(--chase-bg); border: 1px solid var(--chase-border); color: var(--chase-text);
            font-size: 0.55rem; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.4px;
            display: flex; align-items: center; justify-content: center; box-sizing: border-box; z-index: 5; pointer-events: none;
        }
        .chase-overlay.disabled { background-color: #e9ecef; border-color: #ced4da; color: #adb5bd; text-decoration: line-through; }
        @media (min-width: 576px) { .chase-overlay { font-size: 0.6rem; } }
        @media (min-width: 992px) { .chase-overlay { font-size: 0.7rem; } }
        .strike-zone-outline { position: absolute; pointer-events: none; border: 3px solid var(--ps-navy); z-index: 10; }
        .zone-grid-wrapper   { display: inline-block; position: relative; }
        .pitchers-view-label { text-align: center; font-size: 0.7rem; font-weight: 600; color: #6c757d; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .zone-container { display: flex; justify-content: center; padding: 1rem 0; }
        .pitch-section  { border: 1px solid #dee2e6; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; background: var(--ps-card-bg, #fff); }
        [data-theme="dark"] .loc-box.disabled  { background: #2a3f5a; border-color: #3a5070; color: #5a7a9a; }
        [data-theme="dark"] .chase-overlay.disabled { background: #2a3f5a; border-color: #3a5070; color: #5a7a9a; }
        [data-theme="dark"] .pitch-section { border-color: #2a3f5a; }
        [data-theme="dark"] .loc-box.strike  { background: var(--strike-bg); border-color: var(--strike-border); color: var(--strike-text); filter: brightness(0.6) saturate(0.9); }
        [data-theme="dark"] .loc-box.strike:hover { filter: brightness(0.8) saturate(1); }
        [data-theme="dark"] .loc-box.chase   { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); filter: brightness(0.6) saturate(0.9); }
        [data-theme="dark"] .loc-box.chase:hover  { filter: brightness(0.8) saturate(1); }
        [data-theme="dark"] .chase-overlay   { background: var(--chase-bg); border-color: var(--chase-border); color: var(--chase-text); filter: brightness(0.6) saturate(0.9); }
        [data-theme="dark"] .loc-box.disabled, [data-theme="dark"] .chase-overlay.disabled { filter: none; }
    </style>

    <%
        const _userTerm    = (currentUser && currentUser.preferences && currentUser.preferences.zoneTerminology) ? currentUser.preferences.zoneTerminology : 'arm-glove';
        const _pitcherTerm = pitcher.zone && pitcher.zone.terminology ? pitcher.zone.terminology : null;
        const _termMismatch = _pitcherTerm && _pitcherTerm !== 'both' && _pitcherTerm !== _userTerm;
        const _pitcherTermLabel = _pitcherTerm === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
        const _userTermLabel    = _userTerm    === 'arm-glove' ? 'Arm/Glove' : 'Inside/Away';
    %>
    <% if (_termMismatch) { %>
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div>
                <strong>Zone terminology mismatch:</strong> This pitcher's locations are saved as <strong><%= _pitcherTermLabel %></strong> zones, but your preference is now <strong><%= _userTermLabel %></strong>.
                <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/edit" class="alert-link fw-bold">Edit this pitcher</a>, choose a strike zone, and save.
            </div>
        </div>
    <% } %>

    <div class="page-header">
        <h1 class="mb-2"><%= pitcher.name %> #<%= pitcher.number %></h1>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/teams/<%= team._id %>" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Back to Team</a>
            <a href="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>/edit" class="btn btn-outline-light btn-sm"><i class="bi bi-pencil"></i> Edit</a>
            <button type="button" class="btn btn-delete-adaptive btn-sm" data-bs-toggle="modal" data-bs-target="#deletePitcherModal"><i class="bi bi-trash"></i> Delete</button>
        </div>
    </div>

    <div class="modal fade" id="deletePitcherModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;overflow:hidden;">
                <div class="modal-header" style="background:var(--ps-navy);color:var(--accent-text,#fff);border:none;">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Pitcher</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-1">Are you sure you want to delete <strong><%= pitcher.name %> #<%= pitcher.number %></strong>?</p>
                    <p class="text-muted small mb-0">This will permanently remove the pitcher and all their pitch data. This cannot be undone.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/teams/<%= team._id %>/pitchers/<%= pitcher._id %>?_method=DELETE" method="POST" style="margin:0;">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Basic Info</div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5 mb-3 mb-md-0"><p class="text-muted mb-1">Name</p><p class="fw-bold fs-5"><%= pitcher.name %></p></div>
                <div class="col-md-3 mb-3 mb-md-0"><p class="text-muted mb-1">Jersey #</p><p class="fw-bold fs-5">#<%= pitcher.number %></p></div>
                <div class="col-md-4 mb-3 mb-md-0"><p class="text-muted mb-1">Throws</p><p class="fw-bold fs-5"><%= pitcher.throws === 'R' ? 'Right' : 'Left' %></p></div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Pitch Types & Locations</h5>
        <div class="btn-group" role="group">
            <input type="radio" class="btn-check" name="viewMode" id="visualMode" checked>
            <label class="btn btn-outline-primary btn-sm" for="visualMode"><i class="bi bi-grid-3x3"></i> Visual</label>
            <input type="radio" class="btn-check" name="viewMode" id="listMode">
            <label class="btn btn-outline-primary btn-sm" for="listMode"><i class="bi bi-list-check"></i> List</label>
        </div>
    </div>

    <% if (pitcher.pitchTypes.length === 0) { %>
        <div class="card"><div class="card-body text-center p-4 text-muted">No pitch types added yet.</div></div>
    <% } else { %>
        <% for (var i = 0; i < pitcher.pitchTypes.length; i++) { %>
            <% var pitch = pitcher.pitchTypes[i]; %>
            <div class="pitch-section">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <h5 class="fw-bold mb-0"><%= pitch.name %></h5>
                    <span class="badge bg-secondary"><%= pitch.abbreviation %></span>
                </div>
                <div class="visual-view">
                    <div class="zone-container">
                        <div class="zone-grid-wrapper" id="wrapper-<%= i %>">
                            <div class="pitchers-view-label">Pitcher's View</div>
                            <div class="zone-grid" id="grid-<%= i %>"></div>
                        </div>
                    </div>
                </div>
                <div class="list-view" style="display:none;">
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <% for (var loc of pitch.locations) { %>
                            <span class="badge p-2 <% if (!loc.enabled) { %>bg-secondary<% } else if (loc.type === 'chase') { %>bg-warning text-dark<% } else { %>bg-success<% } %>">
                                <%= loc.enabled ? '' : '✕ ' %><%= loc.name %>
                            </span>
                        <% } %>
                    </div>
                </div>

                <%
                    const _ss2   = pitcher.shuffleSettings || {};
                    const _pw2Raw = _ss2.pitchWeights;
                    const _pw2 = (_pw2Raw instanceof Map)
                        ? Object.fromEntries(_pw2Raw)
                        : (_pw2Raw || {});
                    const _totalW2 = pitcher.pitchTypes.reduce((sum, pt2) => {
                        const w = _pw2[pt2.name];
                        return sum + ((w != null && !isNaN(w)) ? parseInt(w) : 1);
                    }, 0);
                    const _pitchW  = _pw2[pitch.name];
                    const _pitchWVal = (_pitchW != null && !isNaN(_pitchW)) ? parseInt(_pitchW) : 1;
                    const _pitchPct  = _totalW2 > 0 ? Math.round((_pitchWVal / _totalW2) * 100) : 0;
                %>
                <div class="mt-3 pt-2 border-top">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted"><i class="bi bi-shuffle"></i> Shuffle Frequency</span>
                        <span class="small fw-bold"><%= _pitchPct %>%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar" style="width: <%= _pitchPct %>%; background: var(--ps-navy);"></div>
                    </div>
                </div>
            </div>
        <% } %>
        <div class="d-flex gap-3 mb-4 flex-wrap">
            <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;background:var(--strike-bg);border:2px solid var(--strike-border);display:inline-block;"></span><small>Strike location</small></span>
            <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;background:var(--chase-bg);border:2px solid var(--chase-border);display:inline-block;"></span><small>Chase</small></span>
            <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;background:#e9ecef;border:2px solid #ced4da;display:inline-block;"></span><small>Disabled</small></span>
            <span class="d-flex align-items-center gap-2"><span style="width:20px;height:20px;border:3px solid var(--ps-navy);display:inline-block;"></span><small>Strike zone boundary</small></span>
        </div>
    <% } %>

        <a href="/teams/<%= team._id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Team</a>

    <script>
        const throws = '<%= pitcher.throws %>';
        const isRHP = throws === 'R';

        const ZONE_LAYOUTS_A = { 'arm-side': { row: 1, col: isRHP ? 2 : 1, strike: true }, 'glove-side': { row: 1, col: isRHP ? 1 : 2, strike: true } };
        const ZONE_LAYOUTS_B = { 'up': { row: 1, col: 1, strike: true }, 'down': { row: 2, col: 1, strike: true } };
        const ZONE_LAYOUTS_C = {
            'glove-out-up':   { row: 1, col: isRHP ? 1 : 5 }, 'up-out': { row: 1, col: 2 }, 'arm-out-up': { row: 1, col: isRHP ? 5 : 1 },
            'glove-out-mid':  { row: 2, col: isRHP ? 1 : 5, rowSpan: 3 },
            'glove-up':       { row: 2, col: isRHP ? 2 : 4, strike: true }, 'mid-up': { row: 2, col: 3, strike: true }, 'arm-up': { row: 2, col: isRHP ? 4 : 2, strike: true },
            'arm-out-mid':    { row: 2, col: isRHP ? 5 : 1, rowSpan: 3 },
            'glove-mid':      { row: 3, col: isRHP ? 2 : 4, strike: true }, 'mid-mid': { row: 3, col: 3, strike: true }, 'arm-mid': { row: 3, col: isRHP ? 4 : 2, strike: true },
            'glove-down':     { row: 4, col: isRHP ? 2 : 4, strike: true }, 'mid-down': { row: 4, col: 3, strike: true }, 'arm-down': { row: 4, col: isRHP ? 4 : 2, strike: true },
            'glove-out-down': { row: 5, col: isRHP ? 1 : 5 }, 'down-out': { row: 5, col: 2 }, 'arm-out-down': { row: 5, col: isRHP ? 5 : 1 },
        };
        const ZONE_LAYOUTS_D = {
            'up-out':     { row: 1, col: 2, colSpan: 2, anchor: true },
            'glove-out':  { row: 2, col: isRHP ? 1 : 4, rowSpan: 2, anchor: true },
            'glove-up':   { row: 2, col: isRHP ? 2 : 3, strike: true },
            'arm-up':     { row: 2, col: isRHP ? 3 : 2, strike: true },
            'arm-out':    { row: 2, col: isRHP ? 4 : 1, rowSpan: 2, anchor: true },
            'glove-down': { row: 3, col: isRHP ? 2 : 3, strike: true },
            'arm-down':   { row: 3, col: isRHP ? 3 : 2, strike: true },
            'down-out':   { row: 4, col: 2, colSpan: 2, anchor: true },
        };
        const ZONE_LAYOUTS_A_IA = { 'away-side': { row: 1, col: 1, strike: true }, 'inside-side': { row: 1, col: 2, strike: true } };
        const ZONE_LAYOUTS_C_IA = {
            'away-out-up': { row: 1, col: 1 }, 'up-out': { row: 1, col: 2 }, 'inside-out-up': { row: 1, col: 5 },
            'away-out-mid': { row: 2, col: 1, rowSpan: 3 },
            'away-up': { row: 2, col: 2, strike: true }, 'mid-up': { row: 2, col: 3, strike: true }, 'inside-up': { row: 2, col: 4, strike: true },
            'inside-out-mid': { row: 2, col: 5, rowSpan: 3 },
            'away-mid': { row: 3, col: 2, strike: true }, 'mid-mid': { row: 3, col: 3, strike: true }, 'inside-mid': { row: 3, col: 4, strike: true },
            'away-down': { row: 4, col: 2, strike: true }, 'mid-down': { row: 4, col: 3, strike: true }, 'inside-down': { row: 4, col: 4, strike: true },
            'away-out-down': { row: 5, col: 1 }, 'down-out': { row: 5, col: 2 }, 'inside-out-down': { row: 5, col: 5 },
        };
        const ZONE_LAYOUTS_D_IA = {
            'up-out':      { row: 1, col: 2, colSpan: 2, anchor: true },
            'away-out':    { row: 2, col: 1, rowSpan: 2, anchor: true },
            'away-up':     { row: 2, col: 2, strike: true },
            'inside-up':   { row: 2, col: 3, strike: true },
            'inside-out':  { row: 2, col: 4, rowSpan: 2, anchor: true },
            'away-down':   { row: 3, col: 2, strike: true },
            'inside-down': { row: 3, col: 3, strike: true },
            'down-out':    { row: 4, col: 2, colSpan: 2, anchor: true },
        };

        function getZoneLayouts(locations) {
            const names = new Set(locations.map(l => l.name));
            if (names.has('mid-up') && names.has('glove-up'))  return ZONE_LAYOUTS_C;
            if (names.has('mid-up') && names.has('inside-up')) return ZONE_LAYOUTS_C_IA;
            if (names.has('glove-up') && names.has('arm-up'))  return ZONE_LAYOUTS_D;
            if (names.has('away-up') && names.has('inside-up'))return ZONE_LAYOUTS_D_IA;
            if (names.has('arm-side'))    return ZONE_LAYOUTS_A;
            if (names.has('inside-side')) return ZONE_LAYOUTS_A_IA;
            if (names.has('up'))          return ZONE_LAYOUTS_B;
            return ZONE_LAYOUTS_C;
        }
        const usesOverlays = locations => { const names = new Set(locations.map(l => l.name)); return names.has('glove-up') || names.has('inside-up') || names.has('away-up'); };
        const isZoneD = locations => { const names = new Set(locations.map(l => l.name)); return (names.has('glove-up') || names.has('away-up')) && !names.has('mid-up'); };
    </script>

    <script type="application/json" id="pitchDataJson"><%- JSON.stringify(pitcher.pitchTypes || []) %></script>
    <script>
        const pitchData = JSON.parse(document.getElementById('pitchDataJson').textContent);

        function getBoxClass(loc) { if (!loc.enabled) return 'disabled'; if (loc.type === 'chase') return 'chase'; return 'strike'; }

        function drawOutline(pitchIndex) {
            const grid = document.getElementById(`grid-${pitchIndex}`), wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            const strikeCells = [...grid.querySelectorAll('[data-is-strike="true"]')]; if (!strikeCells.length) return;
            const gridRect = grid.getBoundingClientRect();
            let top = Infinity, left = Infinity, bottom = -Infinity, right = -Infinity;
            strikeCells.forEach(cell => { const r = cell.getBoundingClientRect(); top=Math.min(top,r.top-gridRect.top); left=Math.min(left,r.left-gridRect.left); bottom=Math.max(bottom,r.bottom-gridRect.top); right=Math.max(right,r.right-gridRect.left); });
            const old = wrapper.querySelector('.strike-zone-outline'); if (old) old.remove();
            const labelEl = wrapper.querySelector('.pitchers-view-label'), labelH = labelEl ? labelEl.offsetHeight + 4 : 0;
            const outline = document.createElement('div'); outline.className = 'strike-zone-outline';
            outline.style.top = (top+labelH)+'px'; outline.style.left = left+'px'; outline.style.width = (right-left)+'px'; outline.style.height = (bottom-top)+'px';
            wrapper.appendChild(outline);
        }

        function drawOverlays(pitchIndex, pitch) {
            const grid = document.getElementById(`grid-${pitchIndex}`), wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (!grid || !wrapper) return;
            wrapper.querySelectorAll('.chase-overlay').forEach(el => el.remove());
            grid.querySelectorAll('.loc-box.covered').forEach(el => el.classList.remove('covered'));
            if (!usesOverlays(pitch.locations)) return;
            const gr = grid.getBoundingClientRect(), labelEl = wrapper.querySelector('.pitchers-view-label'), labelH = labelEl ? labelEl.offsetHeight + 4 : 0;
            const getCell = name => [...grid.querySelectorAll('.loc-box')].find(el => el.dataset.locName === name);
            function spanBounds(names) {
                let t = Infinity, l = Infinity, r = -Infinity, b = -Infinity;
                names.forEach(name => { const el = getCell(name); if (!el) return; const cr = el.getBoundingClientRect(); t=Math.min(t,cr.top-gr.top); l=Math.min(l,cr.left-gr.left); r=Math.max(r,cr.right-gr.left); b=Math.max(b,cr.bottom-gr.top); });
                return { t, l, r, b };
            }
            function makeOverlay(locName, label, hCells, vCells, covered) {
                if (!pitch.locations.find(z => z.name === locName)) return;
                const hb = spanBounds(hCells), vb = spanBounds(vCells);
                if (!isFinite(hb.l) || !isFinite(vb.t)) return;
                const locIndex = pitch.locations.findIndex(l => l.name === locName);
                const loc = pitch.locations[locIndex];
                const el = document.createElement('div');
                el.className = 'chase-overlay' + (loc && !loc.enabled ? ' disabled' : '');
                el.textContent = label; el.dataset.locName = locName;
                Object.assign(el.style, { top: (vb.t+labelH)+'px', left: hb.l+'px', width: (hb.r-hb.l)+'px', height: (vb.b-vb.t)+'px' });
                wrapper.appendChild(el);
                covered.forEach(name => { const cell = getCell(name); if (cell) cell.classList.add('covered'); });
            }

            const locNames = new Set(pitch.locations.map(l => l.name));
            const isInsideAway = locNames.has('inside-up') || locNames.has('inside-down');


            if (isZoneD(pitch.locations)) {
                if (isInsideAway) {
                    makeOverlay('up-out',     'up out',   ['corner-top-glove','away-up','inside-up','corner-top-arm'],     ['up-out'],   ['up-out']);
                    makeOverlay('down-out',   'down out', ['corner-bot-glove','away-down','inside-down','corner-bot-arm'], ['down-out'], ['down-out']);
                    makeOverlay('away-out',   'away out',   ['away-out'],  ['away-up','away-down'],     []);
                    makeOverlay('inside-out', 'inside out', ['inside-out'],['inside-up','inside-down'], []);
                } else {
                    makeOverlay('up-out',    'up out',   ['corner-top-glove','glove-up','arm-up','corner-top-arm'],     ['up-out'],   ['up-out']);
                    makeOverlay('down-out',  'down out', ['corner-bot-glove','glove-down','arm-down','corner-bot-arm'], ['down-out'], ['down-out']);
                    makeOverlay('glove-out', 'glove out', ['glove-out'], ['glove-up', 'glove-down'], []);
                    makeOverlay('arm-out',   'arm out',   ['arm-out'],   ['arm-up', 'arm-down'], []);
                }
            } else {
                if (isInsideAway) {
                    makeOverlay('up-out',        'up out',     ['inside-up','mid-up','away-up'],       ['up-out'],   []);
                    makeOverlay('down-out',      'down out',   ['inside-down','mid-down','away-down'],  ['down-out'], []);
                    makeOverlay('inside-out-mid','inside out', ['inside-out-mid'], ['inside-up','inside-mid','inside-down'], []);
                    makeOverlay('away-out-mid',  'away out',   ['away-out-mid'],   ['away-up','away-mid','away-down'],       []);
                } else {
                    const armOutName   = isRHP ? 'arm-out-mid'   : 'glove-out-mid';
                    const gloveOutName = isRHP ? 'glove-out-mid' : 'arm-out-mid';
                    const armCells     = isRHP ? ['arm-up','arm-mid','arm-down']     : ['glove-up','glove-mid','glove-down'];
                    const gloveCells   = isRHP ? ['glove-up','glove-mid','glove-down'] : ['arm-up','arm-mid','arm-down'];
                    makeOverlay('up-out',      'up out',   ['arm-up','mid-up','glove-up'],      ['up-out'],   []);
                    makeOverlay('down-out',    'down out', ['arm-down','mid-down','glove-down'], ['down-out'], []);
                    makeOverlay(armOutName,   isRHP ? 'arm out'   : 'glove out', [armOutName],   armCells,   []);
                    makeOverlay(gloveOutName, isRHP ? 'glove out' : 'arm out',  [gloveOutName], gloveCells, []);
                }
            }
        }

        function buildGrid(pitchIndex) {
            const pitch = pitchData[pitchIndex]; if (!pitch || !pitch.locations) return;
            const grid = document.getElementById(`grid-${pitchIndex}`); if (!grid) return;
            grid.innerHTML = '';
            const wrapper = document.getElementById(`wrapper-${pitchIndex}`);
            if (wrapper) wrapper.querySelectorAll('.chase-overlay, .strike-zone-outline').forEach(el => el.remove());
            const layout = getZoneLayouts(pitch.locations);
            const maxRow = Math.max(...Object.values(layout).map(p => (p.row||1)+(p.rowSpan||1)-1));
            const maxCol = Math.max(...Object.values(layout).map(p => (p.col||1)+(p.colSpan||1)-1));
            let boxSize = window.innerWidth >= 992 ? 108 : window.innerWidth >= 576 ? 88 : 70;
            let boxH = boxSize;
            if (maxRow === 1 && maxCol === 2) {
                boxH = Math.round(boxSize * 1.6);
            } else if (maxRow === 2 && maxCol === 1) {
                boxSize = Math.round(boxSize * 1.8);
                boxH    = Math.round(boxSize * 0.45);
            } else if (maxRow <= 2) {
                boxSize = Math.min(boxSize, 120);
                boxH = boxSize;
            }
            grid.style.gridTemplateRows    = `repeat(${maxRow}, ${boxH}px)`;
            grid.style.gridTemplateColumns = `repeat(${maxCol}, ${boxSize}px)`;
            pitch.locations.forEach(loc => {
                const pos = layout[loc.name]; if (!pos) return;
                const box = document.createElement('div');
                const cls = pos.anchor ? 'anchor' : getBoxClass(loc);
                box.className        = `loc-box ${cls}`;
                box.textContent      = pos.anchor ? '' :loc.name.replace(/-/g, ' ').replace(' side', '');
                box.dataset.isStrike = pos.strike ? 'true' : 'false';
                box.dataset.locName  = loc.name;
                box.style.gridRow    = pos.rowSpan ? `${pos.row} / span ${pos.rowSpan}` : String(pos.row);
                box.style.gridColumn = pos.colSpan ? `${pos.col} / span ${pos.colSpan}` : String(pos.col);
                grid.appendChild(box);
            });

            // Inject Zone D corner fillers BEFORE paint so spanBounds can measure them
            if (isZoneD(pitch.locations)) {
                const upOut   = pitch.locations.find(l => l.name === 'up-out');
                const downOut = pitch.locations.find(l => l.name === 'down-out');
                const upCls   = (upOut   && !upOut.enabled)   ? 'loc-box disabled' : 'loc-box chase';
                const downCls = (downOut && !downOut.enabled)  ? 'loc-box disabled' : 'loc-box chase';
                [
                { row: 1, col: isRHP ? 1 : 4, cls: upCls,   name: 'corner-top-arm'   },
                { row: 1, col: isRHP ? 4 : 1, cls: upCls,   name: 'corner-top-glove' },
                { row: 4, col: isRHP ? 1 : 4, cls: downCls, name: 'corner-bot-arm'   },
                { row: 4, col: isRHP ? 4 : 1, cls: downCls, name: 'corner-bot-glove' },
                ].forEach(pos => {
                    const filler = document.createElement('div');
                    filler.className        = pos.cls;
                    filler.dataset.locName  = pos.name;
                    filler.style.gridRow    = String(pos.row);
                    filler.style.gridColumn = String(pos.col);
                    filler.style.pointerEvents = 'none';
                    filler.style.cursor     = 'default';
                    grid.appendChild(filler);
                });
            }

            requestAnimationFrame(() => { drawOutline(pitchIndex); drawOverlays(pitchIndex, pitch); });
        }

        pitchData.forEach((pitch, i) => buildGrid(i));
        window.addEventListener('resize', () => pitchData.forEach((p, i) => buildGrid(i)));

        document.getElementById('visualMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'block');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'none');
            pitchData.forEach((p, i) => requestAnimationFrame(() => { drawOutline(i); drawOverlays(i, p); }));
        });
        document.getElementById('listMode').addEventListener('change', () => {
            document.querySelectorAll('.visual-view').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.list-view').forEach(el => el.style.display = 'block');
        });
    </script>
