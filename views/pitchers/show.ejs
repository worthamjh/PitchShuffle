<div class="zone-display-card">
    <%
    const zoneImageMap = { 'A': 'zone_a.png', 'B': 'zone_b.png', 'C': 'zone_c.png' };
    const zoneLetter = pitcher.zone.name.match(/Zone ([A-Z])/)?.[1];
    const zoneImg = zoneImageMap[zoneLetter] || null;
    %>
    <% if (zoneImg) { %>
        <img src="/images/<%= zoneImg %>" alt="<%= pitcher.zone.name %>" style="width:80px;height:auto;border-radius:6px;display:block;">
    <% } %>
    <div class="zone-card-label"><%= pitcher.zone.name %></div>
</div>