<%- layout('layouts/boilerplate') %>

<style>
    .speaking-dot {
        display: inline-block; width: 8px; height: 8px; border-radius: 50%;
        background: #2ecc71; margin-left: 4px; vertical-align: middle;
        animation: pulse 0.8s infinite alternate;
    }
    @keyframes pulse { from { opacity: 0.3; transform: scale(0.8); } to { opacity: 1; transform: scale(1.2); } }

    /* Lock the page — no scrolling, everything fits in viewport */
    html, body { height: 100%; overflow: hidden; }
    main { padding: 0 !important; overflow: hidden; }
    .container.mt-3 { display: none !important; }
    .navbar { position: relative; z-index: 1050; }
    .navbar-collapse { z-index: 1050; }

    .game-page {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 56px);
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        background: var(--ps-card-bg);
        overflow: hidden;
    }

    /* Pitch row — fixed height, no shrink */
    .pitch-row {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        overflow-x: auto;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        flex-shrink: 0;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .pitch-row::-webkit-scrollbar { display: none; }

    .pitch-btn {
        flex: 1;
        min-width: 0;
        padding: 0.35rem 0.5rem;
        border-radius: var(--btn-radius);
        font-size: 0.95rem;
        font-weight: 700;
        border: 2px solid #c0cfe0;
        background: #eef2f7;
        color: var(--ps-navy);
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
        white-space: nowrap;
    }
    .pitch-btn:hover  { background: #dce6f0; }
    .pitch-btn.active { background: var(--ps-navy); border-color: var(--ps-navy); color: var(--accent-text, #fff); }

    /* Zone area — fills remaining space */
    .zone-area {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0.25rem;
    }

    .zone-col {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .zone-grid-wrapper { display: inline-block; position: relative; }
    .zone-grid         { display: grid; gap: 0; border: 2px solid #adb5bd; }

    .pitchers-view-label {
        font-size: 0.6rem;
        font-weight: 600;
        color: #6c757d;
        text-align: center;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    /* Action row */
    .action-row {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        flex-shrink: 0;
    }

    .action-btn {
        flex: 1;
        padding: 0.4rem 0.3rem;
        border-radius: var(--btn-radius);
        font-size: 0.78rem;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        border: 2px solid transparent;
        user-select: none;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .btn-random { background: #e8f4fd; border-color: #4a9edd; color: #1a5f8a; }
    .btn-random:hover { background: #4a9edd; color: #fff; }
    .btn-clear  { background: #fde8e8; border-color: #dd4a4a; color: #8a1a1a; }
    .btn-clear:hover  { background: #dd4a4a; color: #fff; }
    .btn-repeat { background: #f0e8fd; border-color: #9a4add; color: #5a1a8a; }
    .btn-repeat:hover { background: #9a4add; color: #fff; }
    .btn-repeat.disabled-btn { opacity: 0.45; pointer-events: none; }

    /* Call bar */
    .call-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 1.25rem 0.75rem 1.5rem;
        background: var(--ps-navy);
        color: var(--accent-text, #fff);
        flex-shrink: 0;
        min-height: 100px;
    }
    .call-info { flex: 1; min-width: 0; }
    .call-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; opacity: 0.8; }
    .call-text  { font-size: 0.95rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .btn-call {
        background: #fff;
        color: var(--ps-navy);
        border: none;
        border-radius: var(--btn-radius);
        padding: 0.45rem 0.9rem;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        flex-shrink: 0;
        transition: background 0.15s, opacity 0.15s;
    }
    .btn-call:hover { background: #e0ecf8; }
    .btn-call.disabled-btn { opacity: 0.45; pointer-events: none; }


    .random-hint {
        text-align: center;
        font-size: 0.7rem;
        color: #6c757d;
        padding: 0.2rem 0.75rem 0.1rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        flex-shrink: 0;
    }
    .random-hint a { color: var(--ps-navy); font-weight: 700; text-decoration: none; }
    .random-hint a:hover { text-decoration: underline; }

    /* Zone cells — mirrors game.ejs */
    .zone-col .loc-box {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.55rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        border: 1px solid #dee2e6;
        user-select: none;
        transition: background 0.12s, border-color 0.12s;
        box-sizing: border-box;
        line-height: 1.1;
        padding: 2px;
    }
    @media (min-width: 400px) {
        .zone-col .loc-box,
        .zone-col .chase-overlay { font-size: 0.6rem; }
    }
    @media (min-width: 600px) {
        .zone-col .loc-box,
        .zone-col .chase-overlay { font-size: 0.7rem; }
    }

    .loc-box.strike         { background: var(--strike-bg); border-color: var(--strike-border); color: var(--strike-text); }
    .loc-box.chase          { background: var(--chase-bg);  border-color: var(--chase-border);  color: var(--chase-text); }
    .loc-box.covered        { visibility: hidden; pointer-events: none; }
    .loc-box.selected-loc   { outline: 3px solid var(--ps-navy); outline-offset: -2px; z-index: 2; }

    .chase-overlay {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.55rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        background: var(--chase-bg);
        border: 1px solid var(--chase-border);
        color: var(--chase-text);
        box-sizing: border-box;
        z-index: 3;
        user-select: none;
        transition: background 0.12s;
    }
    .chase-overlay.selected-loc { outline: 3px solid var(--ps-navy); outline-offset: -2px; }

    .strike-zone-outline {
        position: absolute;
        border: 3px solid var(--ps-navy);
        pointer-events: none;
        z-index: 4;
        box-sizing: border-box;
    }

    [data-theme='dark'] .pitch-row,
    [data-theme='dark'] .action-row { background: #1a2535; border-color: #2a3f5a; }
    [data-theme='dark'] .pitch-btn  { background: #243350; border-color: #2a3f5a; color: var(--ps-navy-muted); }
    [data-theme='dark'] .pitch-btn.active { background: var(--ps-navy); color: var(--accent-text, #fff); }

    .setup-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.4rem 1rem;
        background: #fff8e1;
        border-bottom: 1px solid #ffe082;
        font-size: 0.78rem;
        color: #5d4037;
        flex-shrink: 0;
    }
    [data-theme="dark"] .loc-box.strike {
            background: var(--strike-bg);
            border-color: var(--strike-border);
            color: var(--strike-text);
            filter: brightness(0.6) saturate(0.9);
        }
        [data-theme="dark"] .loc-box.strike:hover {
            filter: brightness(0.8) saturate(1);
        }
        [data-theme="dark"] .loc-box.chase {
            background: var(--chase-bg);
            border-color: var(--chase-border);
            color: var(--chase-text);
            filter: brightness(0.6) saturate(0.9);
        }
        [data-theme="dark"] .loc-box.chase:hover {
            filter: brightness(0.8) saturate(1);
        }
        [data-theme="dark"] .chase-overlay {
            background: var(--chase-bg);
            border-color: var(--chase-border);
            color: var(--chase-text);
            filter: brightness(0.6) saturate(0.9);
        }
        [data-theme="dark"] .chase-overlay:hover {
            filter: brightness(0.8) saturate(1);
        }
        [data-theme="dark"] .loc-box.disabled,
        [data-theme="dark"] .chase-overlay.disabled {
            filter: none;
        }
        /* ── Pickoff / Pitchout row ──────────────────────────────── */
    .special-row {
        display: flex;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        background: var(--ps-card-bg);
        border-top: 1px solid #dee2e6;
        flex-shrink: 0;
    }
    .btn-pickoff  { background: #e8f4fd; border: 2px solid #4a9edd; color: #1a5f8a; flex: 1; border-radius: var(--btn-radius); padding: 0.35rem 0.5rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
    .btn-pitchout { background: #fff3e0; border: 2px solid #e67e22; color: #7d4000; flex: 1; border-radius: var(--btn-radius); padding: 0.35rem 0.5rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
    .btn-pickoff:hover  { background: #4a9edd; color: #fff; }
    .btn-pitchout:hover { background: #e67e22; color: #fff; }

    /* ── Pickoff base selector overlay ──────────────────────── */
    .pickoff-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pickoff-diamond {
        background: var(--ps-card-bg);
        border-radius: 16px;
        padding: 2rem 1.5rem 1.5rem;
        width: 280px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto auto;
        gap: 0.75rem;
        text-align: center;
    }
    .pickoff-diamond .base-2nd {
        grid-column: 1 / span 2;
        justify-self: center;
        width: 50%;
    }
    .pickoff-diamond .base-btn {
        padding: 0.75rem 0.5rem;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        border: 2px solid #4a9edd;
        background: #e8f4fd;
        color: #1a5f8a;
    }
    .pickoff-diamond .base-btn:hover { background: #4a9edd; color: #fff; }
    .pickoff-diamond .btn-cancel-pickoff {
        padding: 0.75rem 0.5rem;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        border: 2px solid #adb5bd;
        background: #f8f9fa;
        color: #495057;
    }
    .pickoff-diamond .btn-cancel-pickoff:hover { background: #dee2e6; }
    [data-theme="dark"] .pickoff-diamond { background: #1a2535; }
    [data-theme="dark"] .special-row { background: #1a2535; border-color: #2a3f5a; }
</style>

