<%- layout('layouts/boilerplate') %>

<%
  const backHref = currentPitcherId
    ? `/teams/${team._id}/pitchers/game/${currentPitcherId}`
    : `/teams/${team._id}`;
  const backLabel = currentPitcherId ? 'Back to Game' : 'Back to Team';

  const addPitcherHref = currentPitcherId
    ? `/teams/${team._id}/pitchers/new?redirect=/teams/${team._id}/pitchers/game?from=${currentPitcherId}`
    : `/teams/${team._id}/pitchers/new`;

  const currentPitcher = currentPitcherId
    ? team.pitchers.find(p => p._id.toString() === currentPitcherId.toString())
    : null;
  const otherPitchers = currentPitcher
    ? team.pitchers.filter(p => p._id.toString() !== currentPitcherId.toString())
    : team.pitchers;
%>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-arrow-repeat"></i> Change Pitcher</h1>
    <a href="<%= backHref %>" class="btn btn-outline-light" id="backBtn">
        <i class="bi bi-arrow-left"></i> <%= backLabel %>
    </a>
</div>

<% if (team.pitchers.length === 0) { %>
    <div class="card">
        <div class="card-body text-center p-5">
            <i class="bi bi-person-fill display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No pitchers on this team</h4>
            <p class="text-muted">Add a pitcher before making a change.</p>
            <a href="<%= addPitcherHref %>" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Pitcher
            </a>
        </div>
    </div>
<% } else { %>

    <% if (currentPitcher) { %>
    <p class="text-muted mb-2">Adjust the current pitcher's shuffle settings below, or select a new pitcher coming in and tap <strong>Change Pitcher</strong>.</p>
    <% } else { %>
    <p class="text-muted mb-2">Select a pitcher and tap <strong>Change Pitcher</strong> to begin.</p>
    <% } %>

    <!-- Current pitcher card with shuffle settings -->
    <% if (currentPitcher) { %>
    <div class="mb-3" id="currentPitcherSection">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge" style="background: var(--ps-navy);">Currently Pitching</span>
        </div>
        <div class="current-pitcher-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="pitcher-number-badge">#<%= currentPitcher.number %></div>
                <div>
                    <div class="fw-bold fs-5">
                        <%= currentPitcher.firstName ? currentPitcher.firstName + ' ' + currentPitcher.lastName : (currentPitcher.lastName || currentPitcher.name) %>
                    </div>
                    <div class="text-muted small">
                        <%= currentPitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot;
                        <%= currentPitcher.pitchTypes.length %> pitch type<%= currentPitcher.pitchTypes.length !== 1 ? 's' : '' %>
                    </div>
                </div>
            </div>

            <!-- Shuffle settings -->
            <%
                const _css = currentPitcher.shuffleSettings || {};
                const _cspct = _css.strikeChancePct != null ? _css.strikeChancePct
                    : (currentUser && currentUser.preferences && currentUser.preferences.strikeChancePct != null
                        ? currentUser.preferences.strikeChancePct : 70);
                const _cpwRaw = _css.pitchWeights;
                const _cpw = (_cpwRaw instanceof Map)
                    ? Object.fromEntries(_cpwRaw)
                    : (_cpwRaw || {});
                const _ctotalW = currentPitcher.pitchTypes.reduce((sum, pt) => {
                    const w = _cpw[pt.name];
                    return sum + ((w != null && !isNaN(w)) ? parseInt(w) : 1);
                }, 0);
            %>
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small fw-bold text-success">Strike: <span id="strikeLabel"><%= _cspct %></span>%</span>
                    <span class="small fw-bold text-warning">Chase: <span id="chaseLabel"><%= 100 - _cspct %></span>%</span>
                </div>
                <input type="range" class="form-range" min="0" max="100" step="5"
                       id="strikeSlider" value="<%= _cspct %>">
            </div>

            <% if (currentPitcher.pitchTypes.length > 0) { %>
            <div class="mb-1 small fw-bold text-muted">Pitch Frequency</div>
            <% currentPitcher.pitchTypes.forEach(function(pt) { %>
                <%
                    const _cw2 = _cpw[pt.name];
                    const _cwVal = (_cw2 != null && !isNaN(_cw2)) ? parseInt(_cw2) : 1;
                    const _cpct = _ctotalW > 0 ? Math.round((_cwVal / _ctotalW) * 100) : 0;
                    const _sliderVal = _cpct; // slider shows percentage directly
                %>
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small"><%= pt.name %> <span class="text-muted">(<%= pt.abbreviation %>)</span></span>
                        <span class="small fw-bold pitch-pct-label" data-pitch="<%= pt.name %>"><%= _cpct %>%</span>
                    </div>
                    <input type="range" class="form-range pitch-weight-slider"
                           min="0" max="100" step="5"
                           data-pitch="<%= pt.name %>"
                           value="<%= _cpct %>">
                </div>
            <% }); %>
            <% } %>

            <div class="mt-2 text-muted small" id="shuffleSaveStatus"></div>
        </div>
    </div>
    <% } %>

    <!-- Other pitchers -->
    <div class="row row-cols-1 row-cols-md-2 g-3 mb-4" id="pitcherList">
        <% for (let pitcher of otherPitchers) { %>
            <div class="col pitcher-col"
                 data-lastname="<%= (pitcher.lastName || '').toLowerCase() %>"
                 data-firstname="<%= (pitcher.firstName || '').toLowerCase() %>"
                 data-number="<%= pitcher.number || 0 %>">
                <div class="pitcher-select-card" data-pitcher-id="<%= pitcher._id %>">
                    <div class="pitcher-number-badge">#<%= pitcher.number %></div>
                    <div class="pitcher-select-info">
                        <div class="fw-bold fs-5">
                            <%= pitcher.firstName ? pitcher.firstName + ' ' + pitcher.lastName : (pitcher.lastName || pitcher.name) %>
                        </div>
                        <div class="text-muted small">
                            <%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot;
                            <%= pitcher.pitchTypes.length %> pitch type<%= pitcher.pitchTypes.length !== 1 ? 's' : '' %>
                            &middot; <%= team.sport === 'softball' ? '🥎 Softball' : '⚾ Baseball' %>
                        </div>
                    </div>
                    <i class="bi bi-circle pitcher-select-check ms-auto"></i>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Add Pitcher link -->
    <div class="text-center mb-4">
        <a href="<%= addPitcherHref %>" class="btn btn-outline-secondary">
            <i class="bi bi-plus-circle"></i> Add New Pitcher
        </a>
    </div>

    <div class="sticky-bottom pb-3 pt-2" style="background: var(--ps-bg);">
        <a id="startGameBtn" href="#" class="btn btn-primary btn-lg w-100 disabled">
            <i class="bi bi-arrow-repeat"></i> Change Pitcher
        </a>
        <p class="text-center text-muted small mt-2 mb-0" id="selectHint">Select a pitcher above to continue</p>
    </div>

<% } %>

<style>
    .pitcher-select-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        user-select: none;
    }
    .pitcher-select-card:hover { border-color: #8fa8c8; }
    .pitcher-select-card.selected {
        border-color: #1a2e4a;
        background: #eef2f7;
        box-shadow: 0 0 0 3px rgba(26, 46, 74, 0.12);
    }
    .pitcher-select-card .pitcher-select-check {
        font-size: 1.2rem;
        color: #dee2e6;
        transition: color 0.15s;
    }
    .pitcher-select-card.selected .pitcher-select-check { color: #1a2e4a; }
    .pitcher-select-card.selected .pitcher-select-check::before { content: "\f270"; }
    .pitcher-number-badge {
        width: 48px; height: 48px;
        border-radius: 50%;
        background: #1a2e4a;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .pitcher-select-info { flex: 1; }
    .current-pitcher-card {
        border: 2px solid var(--ps-navy);
        border-radius: 12px;
        padding: 1rem;
        background: #eef2f7;
    }
    [data-theme="dark"] .current-pitcher-card {
        background: #1a2535;
        border-color: #4a7fa5;
    }
</style>

<script>
    const teamId = '<%= team._id %>';
    const list   = document.getElementById('pitcherList');

        // ── Selection ─────────────────────────────────────────────
         list.addEventListener('click', e => {
        const card = e.target.closest('.pitcher-select-card');
        if (!card) return;
        document.querySelectorAll('.pitcher-select-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        const btn = document.getElementById('startGameBtn');
        btn.href = `/teams/${teamId}/pitchers/game/${card.dataset.pitcherId}`;
        btn.classList.remove('disabled');
        document.getElementById('selectHint').style.display = 'none';
    });
    // ── Shuffle settings AJAX save ────────────────────────────
    const teamId2    = '<%= team._id %>';
    const cpId       = '<%= currentPitcherId %>';
    const strikeSlider = document.getElementById('strikeSlider');
    const pitchSliders = document.querySelectorAll('.pitch-weight-slider');
    const saveStatus   = document.getElementById('shuffleSaveStatus');
    let saveTimer;

    function getPitchWeights() {
        const weights = {};
        pitchSliders.forEach(s => { weights[s.dataset.pitch] = parseInt(s.value); });
        return weights;
    }

    function updatePitchPcts() {
        const weights = getPitchWeights();
        const total = Object.values(weights).reduce((a, b) => a + b, 0);
        pitchSliders.forEach(s => {
            const pct = total > 0 ? Math.round((parseInt(s.value) / total) * 100) : 0;
            const lbl = document.querySelector(`.pitch-pct-label[data-pitch="${s.dataset.pitch}"]`);
            if (lbl) lbl.textContent = pct + '%';
        });
    }

    function scheduleShuffleSave() {
        clearTimeout(saveTimer);
        if (saveStatus) saveStatus.textContent = 'Saving...';
        saveTimer = setTimeout(async () => {
            try {
                const resp = await fetch(`/teams/${teamId2}/pitchers/${cpId}/shuffle-settings`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        strikeChancePct: parseInt(strikeSlider.value),
                        pitchWeights: getPitchWeights()
                    })
                });
                const data = await resp.json();
                if (saveStatus) saveStatus.textContent = data.ok ? '✓ Saved' : 'Save failed';
                setTimeout(() => { if (saveStatus) saveStatus.textContent = ''; }, 2000);
            } catch (e) {
                if (saveStatus) saveStatus.textContent = 'Save failed';
            }
        }, 800);
    }
    const backBtn = document.getElementById('backBtn');
    if (backBtn && strikeSlider) {
        backBtn.addEventListener('click', async (e) => {
            if (!cpId) return;
            e.preventDefault();
            clearTimeout(saveTimer);
            try {
                await fetch(`/teams/${teamId2}/pitchers/${cpId}/shuffle-settings`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        strikeChancePct: parseInt(strikeSlider.value),
                        pitchWeights: getPitchWeights()
                    })
                });
            } catch(err) {}
            window.location.href = backBtn.href;
        });
    }
    if (strikeSlider) {
        strikeSlider.addEventListener('input', function() {
            document.getElementById('strikeLabel').textContent = this.value;
            document.getElementById('chaseLabel').textContent  = 100 - this.value;
            scheduleShuffleSave();
        });
    }
    pitchSliders.forEach(s => {
        s.addEventListener('input', () => {
            updatePitchPcts();
            scheduleShuffleSave();
        });
    });
</script>
