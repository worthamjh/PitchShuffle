<%- layout('layouts/boilerplate') %>

<%
  const backHref = currentPitcherId
    ? `/teams/${team._id}/pitchers/game/${currentPitcherId}`
    : `/teams/${team._id}`;
  const backLabel = currentPitcherId ? 'Back to Game' : 'Back to Team';

  const addPitcherHref = currentPitcherId
    ? `/teams/${team._id}/pitchers/new?redirect=/teams/${team._id}/pitchers/game?from=${currentPitcherId}`
    : `/teams/${team._id}/pitchers/new`;
%>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-arrow-repeat"></i> Change Pitcher</h1>
    <a href="<%= backHref %>" class="btn btn-outline-light">
        <i class="bi bi-arrow-left"></i> <%= backLabel %>
    </a>
</div>

<% if (team.pitchers.length === 0) { %>
    <div class="card">
        <div class="card-body text-center p-5">
            <i class="bi bi-person-fill display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No pitchers on this team</h4>
            <p class="text-muted">Add a pitcher before making a change.</p>
            <a href="<%= addPitcherHref %>" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Pitcher
            </a>
        </div>
    </div>
<% } else { %>

    <p class="text-muted mb-2">Select the new pitcher coming in, then tap Change Pitcher.</p>

    <!-- Sort bar -->
    <div class="sort-bar mb-3">
        <span>Sort:</span>
        <button class="sort-btn" data-sort="lastName">Last Name</button>
        <button class="sort-btn" data-sort="firstName">First Name</button>
        <button class="sort-btn" data-sort="number">Number</button>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-3 mb-4" id="pitcherList">
        <% for (let pitcher of team.pitchers) { %>
            <div class="col pitcher-col"
                 data-lastname="<%= (pitcher.lastName || '').toLowerCase() %>"
                 data-firstname="<%= (pitcher.firstName || '').toLowerCase() %>"
                 data-number="<%= pitcher.number || 0 %>">
                <div class="pitcher-select-card" data-pitcher-id="<%= pitcher._id %>">
                    <div class="pitcher-number-badge">#<%= pitcher.number %></div>
                    <div class="pitcher-select-info">
                        <div class="fw-bold fs-5">
                            <%= pitcher.firstName ? pitcher.firstName + ' ' + pitcher.lastName : (pitcher.lastName || pitcher.name) %>
                        </div>
                        <div class="text-muted small">
                            <%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot;
                            <%= pitcher.pitchTypes.length %> pitch type<%= pitcher.pitchTypes.length !== 1 ? 's' : '' %>
                            &middot; <%= team.sport === 'softball' ? '🥎 Softball' : '⚾ Baseball' %>
                        </div>
                    </div>
                    <i class="bi bi-circle pitcher-select-check ms-auto"></i>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Add Pitcher link -->
    <div class="text-center mb-4">
        <a href="<%= addPitcherHref %>" class="btn btn-outline-secondary">
            <i class="bi bi-plus-circle"></i> Add New Pitcher
        </a>
    </div>

    <div class="sticky-bottom pb-3 pt-2" style="background: var(--ps-bg);">
        <a id="startGameBtn" href="#" class="btn btn-primary btn-lg w-100 disabled">
            <i class="bi bi-arrow-repeat"></i> Change Pitcher
        </a>
        <p class="text-center text-muted small mt-2 mb-0" id="selectHint">Select a pitcher above to continue</p>
    </div>

<% } %>

<style>
    .pitcher-select-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        user-select: none;
    }
    .pitcher-select-card:hover { border-color: #8fa8c8; }
    .pitcher-select-card.selected {
        border-color: #1a2e4a;
        background: #eef2f7;
        box-shadow: 0 0 0 3px rgba(26, 46, 74, 0.12);
    }
    .pitcher-select-card .pitcher-select-check {
        font-size: 1.2rem;
        color: #dee2e6;
        transition: color 0.15s;
    }
    .pitcher-select-card.selected .pitcher-select-check { color: #1a2e4a; }
    .pitcher-select-card.selected .pitcher-select-check::before { content: "\f270"; }
    .pitcher-number-badge {
        width: 48px; height: 48px;
        border-radius: 50%;
        background: #1a2e4a;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .pitcher-select-info { flex: 1; }

    .sort-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .sort-bar span {
        font-size: 0.8rem;
        color: #6c757d;
        font-weight: 600;
    }
    .sort-btn {
        font-size: 0.78rem;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.15s;
        font-weight: 600;
    }
    .sort-btn:hover  { border-color: #8fa8c8; color: #1a2e4a; }
    .sort-btn.active { background: var(--ps-navy, #1a2e4a); border-color: var(--ps-navy, #1a2e4a); color: #fff; }
</style>

<script>
    const teamId   = '<%= team._id %>';
    const SORT_KEY = 'ps_pitcher_sort';
    const list     = document.getElementById('pitcherList');
    const btns     = document.querySelectorAll('.sort-btn');

    // ── Sort ─────────────────────────────────────────────────
    function applySort(mode) {
        localStorage.setItem(SORT_KEY, mode);
        btns.forEach(b => b.classList.toggle('active', b.dataset.sort === mode));
        const cols = [...list.querySelectorAll('.pitcher-col')];
        cols.sort((a, b) => {
            if (mode === 'number') return Number(a.dataset.number) - Number(b.dataset.number);
            const aVal = mode === 'lastName' ? a.dataset.lastname : a.dataset.firstname;
            const bVal = mode === 'lastName' ? b.dataset.lastname : b.dataset.firstname;
            return aVal.localeCompare(bVal);
        });
        cols.forEach(col => list.appendChild(col));
    }

    btns.forEach(btn => btn.addEventListener('click', () => applySort(btn.dataset.sort)));
    applySort(localStorage.getItem(SORT_KEY) || 'lastName');

    // ── Selection ─────────────────────────────────────────────
    list.addEventListener('click', e => {
        const card = e.target.closest('.pitcher-select-card');
        if (!card) return;
        document.querySelectorAll('.pitcher-select-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        const btn = document.getElementById('startGameBtn');
        btn.href = `/teams/${teamId}/pitchers/game/${card.dataset.pitcherId}`;
        btn.classList.remove('disabled');
        document.getElementById('selectHint').style.display = 'none';
    });
</script>
