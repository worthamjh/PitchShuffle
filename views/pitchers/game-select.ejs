<%- layout('layouts/boilerplate') %>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-bullseye"></i> Start Game — <%= team.name %></h1>
    <a href="/teams/<%= team._id %>" class="btn btn-outline-light">
        <i class="bi bi-arrow-left"></i> Back to Team
    </a>
</div>

<% if (team.pitchers.length === 0) { %>
    <div class="card">
        <div class="card-body text-center p-5">
            <i class="bi bi-person-fill display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No pitchers on this team</h4>
            <p class="text-muted">Add a pitcher before starting a game.</p>
            <a href="/teams/<%= team._id %>/pitchers/new" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Pitcher
            </a>
        </div>
    </div>
<% } else { %>
    <p class="text-muted mb-3">Select the pitcher currently on the mound.</p>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <% for (let pitcher of team.pitchers) { %>
            <div class="col">
                <a href="/teams/<%= team._id %>/pitchers/game/<%= pitcher._id %>"
                   class="card h-100 text-decoration-none pitcher-select-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="pitcher-number-badge">#<%= pitcher.number %></div>
                        <div>
                            <div class="fw-bold fs-5 text-dark"><%= pitcher.name %></div>
                            <div class="text-muted small">
                                <%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot;
                                <%= pitcher.pitchTypes.length %> pitch type<%= pitcher.pitchTypes.length !== 1 ? 's' : '' %>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<style>
    .pitcher-select-card {
        border: 2px solid #dee2e6;
        border-radius: 12px;
        transition: border-color 0.15s, box-shadow 0.15s;
        cursor: pointer;
    }
    .pitcher-select-card:hover {
        border-color: #1a2e4a;
        box-shadow: 0 0 0 3px rgba(26, 46, 74, 0.1);
    }
    .pitcher-number-badge {
        width: 48px; height: 48px;
        border-radius: 50%;
        background: #1a2e4a;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
</style>
