<%- layout('layouts/boilerplate') %>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-play-fill"></i> New Game</h1>
    <a href="/game" class="btn btn-outline-light">
        <i class="bi bi-arrow-left"></i> Teams
    </a>
</div>

<% if (team.pitchers.length === 0) { %>
    <div class="card">
        <div class="card-body text-center p-5">
            <i class="bi bi-person-fill display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No pitchers on <%= team.name %></h4>
            <p class="text-muted">Add a pitcher to this team before starting a game.</p>
            <a href="/teams/<%= team._id %>/pitchers/new" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Pitcher
            </a>
        </div>
    </div>
<% } else { %>
    <p class="text-muted mb-1"><strong>Step 2 of 2</strong> — Select a pitcher</p>
    <p class="text-muted small mb-2 d-flex align-items-center gap-2">
        <% if (team.logo) { %>
            <img src="<%= team.logo %>" alt="" style="width:22px;height:22px;border-radius:4px;object-fit:contain;">
        <% } else { %>
            <i class="bi bi-shield-fill"></i>
        <% } %>
        <%= team.name %>
    </p>

    <!-- Sort bar -->
    <div class="sort-bar mb-3">
        <span>Sort:</span>
        <button class="sort-btn" data-sort="lastName">Last Name</button>
        <button class="sort-btn" data-sort="firstName">First Name</button>
        <button class="sort-btn" data-sort="number">Number</button>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-3 mb-4" id="pitcherList">
        <% for (let pitcher of team.pitchers) { %>
            <div class="col pitcher-col"
                 data-lastname="<%= (pitcher.lastName || '').toLowerCase() %>"
                 data-firstname="<%= (pitcher.firstName || '').toLowerCase() %>"
                 data-number="<%= pitcher.number || 0 %>">
                <div class="select-card" data-pitcher-id="<%= pitcher._id %>">
                    <div class="pitcher-badge">#<%= pitcher.number %></div>
                    <div class="select-card-info">
                        <div class="fw-bold fs-5">
                            <%= pitcher.firstName ? pitcher.firstName + ' ' + pitcher.lastName : (pitcher.lastName || pitcher.name) %>
                        </div>
                        <div class="text-muted small">
                            <%= pitcher.throws === 'R' ? 'RHP' : 'LHP' %> &middot;
                            <%= pitcher.pitchTypes.length %> pitch type<%= pitcher.pitchTypes.length !== 1 ? 's' : '' %>
                        </div>
                    </div>
                    <i class="bi bi-circle select-check ms-auto"></i>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Add pitcher link -->
    <div class="text-center mb-4">
        <a href="/teams/<%= team._id %>/pitchers/new?redirect=/game/<%= team._id %>" class="btn btn-outline-secondary">
            <i class="bi bi-plus-circle"></i> Add New Pitcher
        </a>
    </div>

    <!-- Sticky start button -->
    <div class="start-bar">
        <a id="startBtn" href="#" class="btn btn-primary btn-lg w-100 disabled">
            <i class="bi bi-play-fill"></i> Start Game
        </a>
        <p class="text-center text-muted small mt-2 mb-0" id="selectHint">
            Select a pitcher above to continue
        </p>
    </div>
<% } %>

<style>
    .select-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        background: #fff;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        cursor: pointer;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        user-select: none;
    }
    .select-card:hover     { border-color: #8fa8c8; }
    .select-card.selected  {
        border-color: #1a2e4a;
        background: #eef2f7;
        box-shadow: 0 0 0 3px rgba(26,46,74,0.12);
    }
    .select-check { font-size: 1.2rem; color: #dee2e6; transition: color 0.15s; }
    .select-card.selected .select-check { color: #1a2e4a; }
    .select-card.selected .select-check::before { content: "\f270"; }

    .pitcher-badge {
        width: 48px; height: 48px;
        border-radius: 50%;
        background: #1a2e4a;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .select-card-info { flex: 1; }

    .start-bar {
        position: sticky;
        bottom: 0;
        padding: 0.75rem 0 0.5rem;
        background: var(--ps-bg, #f0f0eb);
    }

    .sort-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .sort-bar span {
        font-size: 0.8rem;
        color: #6c757d;
        font-weight: 600;
    }
    .sort-btn {
        font-size: 0.78rem;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.15s;
        font-weight: 600;
    }
    .sort-btn:hover  { border-color: #8fa8c8; color: #1a2e4a; }
    .sort-btn.active { background: var(--ps-navy, #1a2e4a); border-color: var(--ps-navy, #1a2e4a); color: #fff; }
</style>

<script>
    const teamId   = '<%= team._id %>';
    const SORT_KEY = 'ps_pitcher_sort';
    const list     = document.getElementById('pitcherList');
    const btns     = document.querySelectorAll('.sort-btn');

    // ── Sort ─────────────────────────────────────────────────
    function applySort(mode) {
        localStorage.setItem(SORT_KEY, mode);
        btns.forEach(b => b.classList.toggle('active', b.dataset.sort === mode));
        const cols = [...list.querySelectorAll('.pitcher-col')];
        cols.sort((a, b) => {
            if (mode === 'number') return Number(a.dataset.number) - Number(b.dataset.number);
            const aVal = mode === 'lastName' ? a.dataset.lastname : a.dataset.firstname;
            const bVal = mode === 'lastName' ? b.dataset.lastname : b.dataset.firstname;
            return aVal.localeCompare(bVal);
        });
        cols.forEach(col => list.appendChild(col));
    }

    btns.forEach(btn => btn.addEventListener('click', () => applySort(btn.dataset.sort)));
    applySort(localStorage.getItem(SORT_KEY) || 'lastName');

    // ── Selection ─────────────────────────────────────────────
    list.addEventListener('click', e => {
        const card = e.target.closest('.select-card');
        if (!card) return;
        document.querySelectorAll('.select-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        const btn = document.getElementById('startBtn');
        btn.href = `/teams/${teamId}/pitchers/game/${card.dataset.pitcherId}`;
        btn.classList.remove('disabled');
        document.getElementById('selectHint').style.display = 'none';
    });
</script>
<!-- deploy -->