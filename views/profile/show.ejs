<script>
(function () {
    var form         = document.getElementById('preferencesForm');
    var currentTerm  = '<%= (user.preferences && user.preferences.zoneTerminology) ? user.preferences.zoneTerminology : "arm-glove" %>';
    var pitcherCount       = <%- (locals.pitcherMismatchCount || 0) %>;
    var mismatchedPitchers = <%- JSON.stringify(locals.mismatchedPitchers || []) %>;
    var confirmBtn         = document.getElementById('termChangeConfirmBtn');
    var mainMsg      = document.getElementById('termChangeMainMsg');
    var warningDiv   = document.getElementById('termChangePitcherWarning');
    var _modal       = null;

    if (!form) return;

    form.addEventListener('submit', function (e) {
        var selected = document.querySelector('input[name="zoneTerminology"]:checked');
        if (!selected || selected.value === currentTerm) return;

        e.preventDefault();

        var fromLabel = currentTerm === 'arm-glove' ? 'Arm Side / Glove Side' : 'Inside / Away';
        var toLabel   = selected.value === 'arm-glove' ? 'Arm Side / Glove Side' : 'Inside / Away';

        mainMsg.textContent = 'Switch from ' + fromLabel + ' to ' + toLabel + ' terminology?';

        if (pitcherCount > 0) {
            var list = document.getElementById('termChangePitcherList');
            list.innerHTML = '';
            mismatchedPitchers.forEach(function(p) {
                var li = document.createElement('li');
                li.className = 'list-group-item py-1 px-2 small';
                li.innerHTML = '<i class="bi bi-person-fill me-1 text-muted"></i><strong>#' + p.number + ' ' + p.name + '</strong><span class="text-muted ms-1">(' + p.team + ')</span>';
                list.appendChild(li);
            });
            warningDiv.style.display = '';
        } else {
            warningDiv.style.display = 'none';
        }

        if (!_modal) _modal = new bootstrap.Modal(document.getElementById('termChangeModal'));
        _modal.show();
    });

    confirmBtn.addEventListener('click', function () {
        if (_modal) _modal.hide();
        form.submit();
    });
}());
</script>
