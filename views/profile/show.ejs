<%- layout('layouts/boilerplate') %>

<div class="page-header">
    <h1><i class="bi bi-person-circle"></i> My Profile</h1>
</div>

<!-- ── Avatar + Account Info ─────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-info-circle"></i> Account Info</div>
    <div class="card-body">
        <div class="row align-items-center">

            <!-- Avatar -->
            <div class="col-md-2 text-center mb-3 mb-md-0">
                <% if (user.avatar) { %>
                    <img src="<%= user.avatar %>" alt="Profile picture"
                         style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid var(--ps-navy);">
                <% } else { %>
                    <div style="width:80px;height:80px;border-radius:50%;background:var(--ps-navy);
                                color:#fff;font-size:2rem;display:flex;align-items:center;
                                justify-content:center;margin:0 auto;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                <% } %>
                <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="mt-2">
                    <label class="btn btn-outline-secondary btn-sm w-100" style="cursor:pointer;">
                        <i class="bi bi-camera"></i> Change
                        <input type="file" name="avatar" accept="image/*" style="display:none;"
                               onchange="this.form.submit()">
                    </label>
                </form>
            </div>

            <!-- Info -->
            <div class="col-md-10">
                <div class="row">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <p class="text-muted mb-1">Username</p>
                        <p class="fw-bold fs-5"><%= user.username %></p>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <p class="text-muted mb-1">Email</p>
                        <p class="fw-bold fs-5"><%= user.email %></p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1">Teams</p>
                        <p class="fw-bold fs-5"><%= teams.length %> team<%= teams.length !== 1 ? 's' : '' %></p>
                    </div>
                </div>
                <% if (teams.length > 0) { %>
                    <hr>
                    <div class="d-flex flex-wrap gap-2">
                        <% for (let team of teams) { %>
                            <a href="/teams/<%= team._id %>" class="btn btn-outline-primary btn-sm">
                                <% if (team.logo) { %>
                                    <img src="<%= team.logo %>" alt=""
                                         style="width:16px;height:16px;border-radius:50%;object-fit:cover;margin-right:4px;">
                                <% } else { %>
                                    <i class="bi bi-shield-fill"></i>
                                <% } %>
                                <%= team.name %>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>


<!-- ── Visual Preferences ─────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold d-flex align-items-center justify-content-between">
        <span><i class="bi bi-palette"></i> Visual Preferences</span>
        <button type="button" class="btn btn-sm btn-outline-accent" id="restoreDefaultsBtn">
            <i class="bi bi-arrow-counterclockwise"></i> Restore Defaults
        </button>
    </div>
    <div class="card-body">
        <form action="/profile/preferences" method="POST">

            <!-- Theme -->
            <div class="mb-4">
                <label class="form-label fw-bold">Theme</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="theme" id="themeLight"
                               value="light" <%= (!user.preferences || user.preferences.theme === 'light') ? 'checked' : '' %>>
                        <label class="form-check-label" for="themeLight">
                            <i class="bi bi-sun"></i> Light
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="theme" id="themeDark"
                               value="dark" <%= (user.preferences && user.preferences.theme === 'dark') ? 'checked' : '' %>>
                        <label class="form-check-label" for="themeDark">
                            <i class="bi bi-moon-stars"></i> Dark
                        </label>
                    </div>
                </div>
            </div>

            <!-- Game View Font Size -->
            <div class="mb-4">
                <label class="form-label fw-bold">Game View Font Size</label>
                <div class="d-flex gap-3">
                    <% ['sm', 'md', 'lg'].forEach(size => { %>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="gameFontSize"
                                   id="font-<%= size %>" value="<%= size %>"
                                   <%= (!user.preferences || user.preferences.gameFontSize === size || (!user.preferences.gameFontSize && size === 'md')) ? 'checked' : '' %>>
                            <label class="form-check-label" for="font-<%= size %>">
                                <%= size === 'sm' ? 'Small' : size === 'md' ? 'Medium' : 'Large' %>
                            </label>
                        </div>
                    <% }); %>
                </div>
                <small class="text-muted">Controls pitch type and location label sizes in the game view.</small>
            </div>

            <!-- Pitch Call Voice -->
            <div class="mb-4">
                <label for="voiceSelect" class="form-label fw-bold">Pitch Call Voice</label>
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select" id="voiceSelect" name="voiceURI" style="max-width: 320px;">
                        <option value="">Default voice</option>
                        <!-- Populated by JS below -->
                    </select>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="testVoiceBtn">
                        <i class="bi bi-play-fill"></i> Test
                    </button>
                </div>
                <small class="text-muted">Voices available on your device. Selection is saved per browser.</small>
            </div>

            <div class="mb-2">
                <small class="text-muted">
                    <i class="bi bi-info-circle"></i>
                    Strike zone and chase zone colors are set per team on the
                    <a href="/teams">team edit page</a>.
                </small>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Save Preferences
            </button>
        </form>
    </div>
</div>

<script>
// ── Restore defaults ──────────────────────────────────────────
document.getElementById('restoreDefaultsBtn').addEventListener('click', () => {
    document.getElementById('themeLight').checked = true;
    document.getElementById('themeDark').checked  = false;
    document.getElementById('font-sm').checked    = false;
    document.getElementById('font-md').checked    = true;
    document.getElementById('font-lg').checked    = false;
    document.getElementById('voiceSelect').value  = '';
});

// ── Voice selector ────────────────────────────────────────────
const savedVoiceURI = '<%= (user.preferences && user.preferences.voiceURI) ? user.preferences.voiceURI : "" %>';

function populateVoices() {
    const voices = window.speechSynthesis.getVoices();
    if (!voices.length) return;

    const select = document.getElementById('voiceSelect');
    // Clear existing options except the default
    while (select.options.length > 1) select.remove(1);

    voices.forEach(v => {
        const opt = document.createElement('option');
        opt.value       = v.voiceURI;
        opt.textContent = `${v.name} (${v.lang})`;
        if (v.voiceURI === savedVoiceURI) opt.selected = true;
        select.appendChild(opt);
    });
}

// Voices load asynchronously on some browsers
populateVoices();
if (window.speechSynthesis.onvoiceschanged !== undefined) {
    window.speechSynthesis.onvoiceschanged = populateVoices;
}

// ── Test voice button ─────────────────────────────────────────
document.getElementById('testVoiceBtn').addEventListener('click', () => {
    if (!('speechSynthesis' in window)) return;
    const voices    = window.speechSynthesis.getVoices();
    const selectedURI = document.getElementById('voiceSelect').value;
    const voice     = voices.find(v => v.voiceURI === selectedURI) || null;
    window.speechSynthesis.cancel();
    const utter     = new SpeechSynthesisUtterance('Fastball, glove side down');
    utter.voice     = voice;
    utter.rate      = 0.95;
    window.speechSynthesis.speak(utter);
});
</script>


<script>
document.getElementById('restoreDefaultsBtn').addEventListener('click', () => {
    document.getElementById('themeLight').checked = true;
    document.getElementById('themeDark').checked  = false;
    document.getElementById('font-sm').checked    = false;
    document.getElementById('font-md').checked    = true;
    document.getElementById('font-lg').checked    = false;
});
</script>


<script>
document.getElementById('restoreDefaultsBtn').addEventListener('click', () => {
    const teamColorInput = document.getElementById('teamColor');
    if (teamColorInput) teamColorInput.value = '#1a2e4a';

    const strikeColorInput = document.getElementById('strikeColor');
    if (strikeColorInput) strikeColorInput.value = '#c8ecd4';

    const chaseColorInput = document.getElementById('chaseColor');
    if (chaseColorInput) chaseColorInput.value = '#fef3cd';

    document.getElementById('themeLight').checked = true;

    const fontMd = document.getElementById('fontMd');
    if (fontMd) fontMd.checked = true;
});
</script>



<!-- ── Update Email ───────────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-envelope"></i> Update Email</div>
    <div class="card-body">
        <form action="/profile" method="POST">
            <div class="mb-3">
                <label for="email" class="form-label fw-bold">New Email Address</label>
                <input type="email" class="form-control" id="email" name="email"
                    value="<%= user.email %>" required>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Save Email
            </button>
        </form>
    </div>
</div>

<!-- ── Change Password ────────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-lock"></i> Change Password</div>
    <div class="card-body">
        <form action="/profile/password" method="POST">
            <div class="mb-3">
                <label for="currentPassword" class="form-label fw-bold">Current Password</label>
                <input type="password" class="form-control" id="currentPassword"
                    name="currentPassword" required>
            </div>
            <div class="mb-3">
                <label for="newPassword" class="form-label fw-bold">New Password</label>
                <input type="password" class="form-control" id="newPassword"
                    name="newPassword" required minlength="6">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-lock-fill"></i> Update Password
            </button>
        </form>
    </div>
</div>

<a href="/teams" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Back to My Teams
</a>

<script>
    document.getElementById('restoreDefaultsBtn').addEventListener('click', () => {
        // Colours
        document.getElementById('accentColor').value = '#1a2e4a';
        document.getElementById('strikeColor').value = '#c8ecd4';
        document.getElementById('chaseColor').value  = '#fef3cd';

        // Theme → Light
        document.getElementById('themeLight').checked = true;
        document.getElementById('themeDark').checked  = false;

        // Font size → Medium
        document.getElementById('font-sm').checked = false;
        document.getElementById('font-md').checked = true;
        document.getElementById('font-lg').checked = false;
    });
</script>
