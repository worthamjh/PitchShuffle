<%- layout('layouts/boilerplate') %>

<div class="page-header">
    <h1><i class="bi bi-person-circle"></i> My Profile</h1>
</div>

<!-- ── Avatar + Account Info ─────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-info-circle"></i> Account Info</div>
    <div class="card-body">
        <div class="row align-items-center">

            <!-- Avatar -->
            <div class="col-md-2 text-center mb-3 mb-md-0">
                <% if (user.avatar) { %>
                    <img src="<%= user.avatar %>" alt="Profile picture"
                         style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid var(--ps-navy);">
                <% } else { %>
                    <div style="width:80px;height:80px;border-radius:50%;background:var(--ps-navy);
                                color:#fff;font-size:2rem;display:flex;align-items:center;
                                justify-content:center;margin:0 auto;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                <% } %>
                <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="mt-2">
                    <label class="btn btn-outline-secondary btn-sm w-100" style="cursor:pointer;">
                        <i class="bi bi-camera"></i> Change
                        <input type="file" name="avatar" accept="image/*" style="display:none;"
                               onchange="this.form.submit()">
                    </label>
                </form>
                <% if (user.avatar) { %>
                    <form action="/profile/avatar?_method=DELETE" method="POST" class="mt-1">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-trash"></i> Remove
                        </button>
                    </form>
                <% } %>
            </div>

            <!-- Info -->
            <div class="col-md-10">
                <div class="row">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <p class="text-muted mb-1">Username</p>
                        <p class="fw-bold fs-5"><%= user.username %></p>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <p class="text-muted mb-1">Email</p>
                        <p class="fw-bold fs-5"><%= user.email %></p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1">Teams</p>
                        <p class="fw-bold fs-5"><%= teams.length %> team<%= teams.length !== 1 ? 's' : '' %></p>
                    </div>
                </div>
                <% if (teams.length > 0) { %>
                    <hr>
                    <div class="d-flex flex-wrap gap-2">
                        <% for (let team of teams) { %>
                            <a href="/teams/<%= team._id %>" class="btn btn-outline-primary btn-sm">
                                <% if (team.logo) { %>
                                    <img src="<%= team.logo %>" alt=""
                                        style="width:16px;height:16px;border-radius:50%;object-fit:cover;margin-right:4px;">
                                <% } else { %>
                                    <%= team.sport === 'softball' ? '🥎' : '⚾' %>
                                <% } %>
                                <%= team.name %>
                                <%= team.sport === 'softball' ? '🥎' : '⚾' %>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- ── Subscription ───────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-credit-card"></i> Subscription</div>
    <div class="card-body d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <div>
            <% if (user.isActive()) { %>
                <% if (user.subscription.status === 'trialing') { %>
                    <p class="fw-semibold mb-1">Free Trial Active</p>
                    <p class="text-muted small mb-0">
                        <%= Math.max(0, Math.ceil((new Date(user.subscription.trialEndsAt) - new Date()) / (1000*60*60*24))) %> days remaining
                    </p>
                <% } else if (user.subscription.seasonEndsAt && new Date(user.subscription.seasonEndsAt) > new Date()) { %>
                    <p class="fw-semibold mb-1">Season Pass Active</p>
                    <p class="text-muted small mb-0">
                        Expires <%= new Date(user.subscription.seasonEndsAt).toLocaleDateString() %>
                    </p>
                <% } else { %>
                    <p class="fw-semibold mb-1">Subscription Active</p>
                    <% if (user.subscription.currentPeriodEnds) { %>
                        <p class="text-muted small mb-0">Renews <%= new Date(user.subscription.currentPeriodEnds).toLocaleDateString() %></p>
                    <% } %>
                <% } %>
            <% } else if (user.subscription.status === 'past_due') { %>
                <p class="fw-semibold mb-1 text-danger">Payment Failed</p>
                <p class="text-muted small mb-0">Update your payment method to restore access.</p>
            <% } else if (user.subscription.status === 'cancelled') { %>
                <p class="fw-semibold mb-1">Subscription Cancelled</p>
                <p class="text-muted small mb-0">Resubscribe to restore access.</p>
            <% } else { %>
                <p class="fw-semibold mb-1">No Active Subscription</p>
                <p class="text-muted small mb-0">Start your 30-day free trial today.</p>
            <% } %>
        </div>
        <a href="/subscription" class="btn btn-primary fw-bold flex-shrink-0">
            <i class="bi bi-credit-card me-1"></i>
            <%= user.isActive() ? 'Manage' : 'Subscribe' %>
        </a>
    </div>
</div>
<!-- ── Visual Preferences ─────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold d-flex align-items-center justify-content-between">
        <span><i class="bi bi-palette"></i> Visual Preferences</span>
        <button type="button" class="btn btn-sm btn-outline-accent" id="restoreDefaultsBtn">
            <i class="bi bi-arrow-counterclockwise"></i> Restore Defaults
        </button>
    </div>
    <div class="card-body">
        <form action="/profile/preferences" method="POST" id="preferencesForm">

            <!-- Theme -->
            <div class="mb-4">
                <label class="form-label fw-bold">Theme</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="theme" id="themeLight"
                               value="light" <%= (!user.preferences || user.preferences.theme === 'light') ? 'checked' : '' %>>
                        <label class="form-check-label" for="themeLight">
                            <i class="bi bi-sun"></i> Light
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="theme" id="themeDark"
                               value="dark" <%= (user.preferences && user.preferences.theme === 'dark') ? 'checked' : '' %>>
                        <label class="form-check-label" for="themeDark">
                            <i class="bi bi-moon-stars"></i> Dark
                        </label>
                    </div>
                </div>
            </div>
            <!-- Game View Font Size -->
            <div class="mb-4">
                <label class="form-label fw-bold">Game View Font Size</label>
                <div class="d-flex gap-3">
                    <% ['sm', 'md', 'lg'].forEach(size => { %>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="gameFontSize"
                                   id="font-<%= size %>" value="<%= size %>"
                                   <%= (!user.preferences || user.preferences.gameFontSize === size || (!user.preferences.gameFontSize && size === 'md')) ? 'checked' : '' %>>
                            <label class="form-check-label" for="font-<%= size %>">
                                <%= size === 'sm' ? 'Small' : size === 'md' ? 'Medium' : 'Large' %>
                            </label>
                        </div>
                    <% }); %>
                </div>
                <small class="text-muted">Controls pitch type and location label sizes in the game view.</small>
            </div>

            <!-- Pitch Call Voice -->
            <div class="mb-4">
                <label for="voiceSelect" class="form-label fw-bold">Pitch Call Voice</label>
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select" id="voiceSelect" name="voiceURI" style="max-width: 320px;">
                        <option value="">Default voice</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="testVoiceBtn">
                        <i class="bi bi-play-fill"></i> Test
                    </button>
                </div>
                <small class="text-muted">Voices available on your device. Selection is saved per browser.</small>
            </div>

            <div class="mb-2">
                <small class="text-muted">
                    <i class="bi bi-info-circle"></i>
                    Strike zone and chase zone colors are set per team on the
                    <a href="/teams">team edit page</a>.
                </small>
            </div>

            <!-- Zone Terminology -->
            <div class="mb-4">
                <label class="form-label fw-bold">Strike Zone Terminology</label>
                <p class="text-muted small mb-3">
                    Controls how pitch locations are labeled throughout the app.
                    Existing pitchers won't be changed — only new pitchers will
                    use the updated terminology.
                </p>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <input type="radio" class="btn-check" name="zoneTerminology"
                               id="termArmGlove" value="arm-glove"
                               <%= (!user.preferences || !user.preferences.zoneTerminology || user.preferences.zoneTerminology === 'arm-glove') ? 'checked' : '' %>>
                        <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3"
                            for="termArmGlove">
                            <img src="/images/pitcher-image.svg" alt="Arm Side / Glove Side" style="width:90px;height:90px;object-fit:contain;margin-bottom:0.25rem;">
                            <span class="fw-bold">Arm Side / Glove Side</span>
                            <small class="text-muted mt-1 text-center">
                                Relative to the pitcher's throwing hand. Zone mirrors for lefties vs righties.
                            </small>
                        </label>
                    </div>
                    <div class="col-sm-6">
                        <input type="radio" class="btn-check" name="zoneTerminology"
                               id="termInsideAway" value="inside-away"
                               <%= (user.preferences && user.preferences.zoneTerminology === 'inside-away') ? 'checked' : '' %>>
                        <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content: center p-3"
                            for="termInsideAway">
                            <img src="/images/batter-image.svg" alt="Inside/Away" style="width:90px;height:90px;object-fit:contain;margin-bottom:0.25rem;">
                            <span class="fw-bold">Inside / Away</span>
                            <small class="text-muted mt-1 text-center">
                                Relative to the batter. Fixed layout regardless of pitcher handedness.
                            </small>
                        </label>
                    </div>
                </div>
            </div>
<!-- Default Shuffle Strike % -->
            <div class="mb-4">
                <label class="form-label fw-bold">Default Shuffle Strike %
                    <span class="text-muted fw-normal">(used when no per-pitcher override is set)</span>
                </label>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-success fw-bold" style="min-width:80px;">Strike: <span id="globalStrikeLbl"><%= user.preferences && user.preferences.strikeChancePct != null ? user.preferences.strikeChancePct : 70 %></span>%</span>
                    <input type="range" class="form-range flex-grow-1" min="0" max="100" step="5"
                           id="globalStrikeSlider" name="strikeChancePct"
                           value="<%= user.preferences && user.preferences.strikeChancePct != null ? user.preferences.strikeChancePct : 70 %>">
                    <span class="text-warning fw-bold" style="min-width:80px;">Chase: <span id="globalChaseLbl"><%= 100 - (user.preferences && user.preferences.strikeChancePct != null ? user.preferences.strikeChancePct : 70) %></span>%</span>
                </div>
                <small class="text-muted">Pitchers with a custom override ignore this setting.</small>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Save Preferences
            </button>
        </form>
    </div>
</div>

<script>
// ── Restore defaults ──────────────────────────────────────────
document.getElementById('restoreDefaultsBtn').addEventListener('click', () => {
    document.getElementById('termArmGlove').checked  = true;
    document.getElementById('termInsideAway').checked = false;
    document.getElementById('themeLight').checked = true;
    document.getElementById('themeDark').checked  = false;
    document.getElementById('font-sm').checked    = false;
    document.getElementById('font-md').checked    = true;
    document.getElementById('font-lg').checked    = false;
    document.getElementById('voiceSelect').value  = '';
    document.getElementById('globalStrikeSlider').value = 70;
    document.getElementById('globalStrikeLbl').textContent = 70;
    document.getElementById('globalChaseLbl').textContent  = 30;
});

// ── Voice selector ────────────────────────────────────────────
const savedVoiceURI = '<%= (user.preferences && user.preferences.voiceURI) ? user.preferences.voiceURI : "" %>';

function populateVoices() {
    const voices = window.speechSynthesis.getVoices();
    if (!voices.length) return;
    const select = document.getElementById('voiceSelect');
    while (select.options.length > 1) select.remove(1);
    voices.forEach(v => {
        const opt = document.createElement('option');
        opt.value       = v.voiceURI;
        opt.textContent = `${v.name} (${v.lang})`;
        if (v.voiceURI === savedVoiceURI) opt.selected = true;
        select.appendChild(opt);
    });
}
populateVoices();
if (window.speechSynthesis.onvoiceschanged !== undefined) {
    window.speechSynthesis.onvoiceschanged = populateVoices;
}

document.getElementById('globalStrikeSlider').addEventListener('input', function () {
    document.getElementById('globalStrikeLbl').textContent = this.value;
    document.getElementById('globalChaseLbl').textContent  = 100 - this.value;
});
// ── Test voice button ─────────────────────────────────────────
document.getElementById('testVoiceBtn').addEventListener('click', () => {
    if (!('speechSynthesis' in window)) return;
    const voices      = window.speechSynthesis.getVoices();
    const selectedURI = document.getElementById('voiceSelect').value;
    const voice       = voices.find(v => v.voiceURI === selectedURI) || null;
    window.speechSynthesis.cancel();
    const utter   = new SpeechSynthesisUtterance('Fastball, glove side down');
    utter.voice   = voice;
    utter.rate    = 0.95;
    window.speechSynthesis.speak(utter);
});
</script>

<!-- ── Update Email ───────────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-envelope"></i> Update Email</div>
    <div class="card-body">
        <form action="/profile" method="POST">
            <div class="mb-3">
                <label for="email" class="form-label fw-bold">New Email Address</label>
                <input type="email" class="form-control" id="email" name="email"
                    value="<%= user.email %>" required>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Save Email
            </button>
        </form>
    </div>
</div>

<!-- ── Change Password ────────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header fw-bold"><i class="bi bi-lock"></i> Change Password</div>
    <div class="card-body">
        <form action="/profile/password" method="POST">
            <div class="mb-3">
                <label for="currentPassword" class="form-label fw-bold">Current Password</label>
                <input type="password" class="form-control" id="currentPassword"
                    name="currentPassword" required>
            </div>
            <div class="mb-3">
                <label for="newPassword" class="form-label fw-bold">New Password</label>
                <input type="password" class="form-control" id="newPassword"
                    name="newPassword" required minlength="6">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-lock-fill"></i> Update Password
            </button>
        </form>
    </div>
</div>

<!-- ── Danger Zone ────────────────────────────────────────────── -->
<div class="card mb-4 border-danger">
    <div class="card-header fw-bold text-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> Danger Zone
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Deleting your account is permanent and cannot be undone. All your teams, pitchers,
            and settings will be permanently removed.
        </p>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
            <i class="bi bi-person-x-fill"></i> Delete My Account
        </button>
    </div>
</div>

<!-- Terminology change confirmation modal -->
<div class="modal fade" id="termChangeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:rgba(255,193,7,0.15);">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    </div>
                    <h5 class="modal-title fw-bold mb-0">Change Zone Terminology?</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="mb-2" id="termChangeMainMsg"></p>
                <div id="termChangePitcherWarning" style="display:none;">
                    <p class="mb-2 text-muted small">The following pitchers will need their strike zone re-selected on their edit page:</p>
                    <ul class="list-group list-group-flush mb-2" id="termChangePitcherList"></ul>
                    <div class="alert alert-warning py-2 px-3 mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Their pitch locations won't change automatically &mdash; you'll need to re-select a strike zone on each pitcher's edit page.
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="termChangeConfirmBtn">
                    <i class="bi bi-check-circle me-1"></i> Yes, Switch Terminology
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Account confirmation modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:rgba(220,53,69,0.12);">
                        <i class="bi bi-person-x-fill text-danger fs-5"></i>
                    </div>
                    <h5 class="modal-title fw-bold mb-0">Delete Your Account?</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="mb-2">This will permanently delete:</p>
                <ul class="text-muted small mb-3">
                    <li>Your account and login credentials</li>
                    <li>All <%= teams.length %> team<%= teams.length !== 1 ? 's' : '' %> and all pitchers on them</li>
                    <li>Your profile picture and all uploaded images</li>
                    <li>All preferences and settings</li>
                </ul>
                <p class="fw-bold text-danger small mb-0">This cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <form action="/profile/account?_method=DELETE" method="POST" style="margin:0;">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-x-fill me-1"></i> Yes, Delete My Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ── Help & Guide ───────────────────────────────────────────── -->
<div class="card mb-4" id="help">
    <div class="card-header fw-bold"><i class="bi bi-question-circle"></i> Help & Guide</div>
    <div class="card-body p-0">
        <div class="accordion accordion-flush" id="helpAccordion">

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help1">
                        <i class="bi bi-info-circle me-2 text-primary"></i> What is PitchShuffle?
                    </button>
                </h2>
                <div id="help1" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        PitchShuffle is a pitch-calling tool for coaches and catchers. During a game, connect your device to a Bluetooth earpiece worn by your catcher — then simply select a pitch type and location in the strike zone, and the call is announced directly to their earpiece, keeping your pitch selection completely hidden from the opposing team.
                        <br><br>
                        You can also let the app call pitches for you using the <strong>Shuffle</strong> button, which picks a pitch type and location automatically.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help2">
                        <i class="bi bi-bluetooth me-2 text-primary"></i> Bluetooth & Earpiece Setup
                    </button>
                </h2>
                <div id="help2" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        PitchShuffle announces pitch calls using your device's built-in text-to-speech. To send calls wirelessly to your catcher:
                        <br><br>
                        <ol class="ps-3 mb-0">
                            <li class="mb-2">Pair a Bluetooth earpiece to your device before the game.</li>
                            <li class="mb-2">Once connected, your device's audio output routes to the earpiece automatically — no extra setup needed in PitchShuffle.</li>
                            <li class="mb-2">Have your catcher wear the earpiece. Open PitchShuffle and start a game.</li>
                            <li class="mb-2">Tap <strong>Call Pitch</strong> — the call will be announced through the earpiece.</li>
                        </ol>
                        <br>
                        Any Bluetooth earpiece works. A single earbud is recommended so your catcher can still hear the field.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help3">
                        <i class="bi bi-people-fill me-2 text-primary"></i> Setting Up a Team
                    </button>
                </h2>
                <div id="help3" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        <ol class="ps-3 mb-0">
                            <li class="mb-2">Go to <strong>My Teams</strong> and tap <strong>New Team</strong>.</li>
                            <li class="mb-2">Enter your team name, choose Baseball or Softball, and set your team colors.</li>
                            <li class="mb-2">Once the team is created, open it and tap <strong>Add Pitcher</strong> to start adding your roster.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help4">
                        <i class="bi bi-person-fill me-2 text-primary"></i> Adding a Pitcher
                    </button>
                </h2>
                <div id="help4" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        <ol class="ps-3 mb-0">
                            <li class="mb-2">From your team page, tap <strong>Add Pitcher</strong>.</li>
                            <li class="mb-2">Enter the pitcher's name, number, and throwing hand (RHP or LHP).</li>
                            <li class="mb-2">Select a <strong>strike zone</strong> — this sets which locations will be available when calling pitches.</li>
                            <li class="mb-2">Add their <strong>pitch types</strong> — for example: Fastball (FB), Curveball (CB), Changeup (CH).</li>
                            <li class="mb-2">After saving, open the pitcher to customize which locations are active for each pitch type.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help5">
                        <i class="bi bi-grid-3x3 me-2 text-primary"></i> Configuring Pitch Locations
                    </button>
                </h2>
                <div id="help5" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        On a pitcher's edit page, each pitch type has a strike zone grid. Tap any location to toggle it on or off.
                        <br><br>
                        <strong>Colored locations</strong> are active — they'll show up in the game and in the random pool.<br>
                        <strong>Grayed-out locations</strong> are disabled from randomization — you can still call them manually during a game, but they won't be included when using the Shuffle button.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help6">
                        <i class="bi bi-play-fill me-2 text-primary"></i> Using the Game Screen
                    </button>
                </h2>
                <div id="help6" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        Once you select a team and pitcher, the game screen shows:
                        <br><br>
                        <strong>Pitch type buttons</strong> — tap to select what pitch to throw.<br>
                        <strong>Strike zone grid</strong> — tap a location to select where the pitch goes.<br>
                        <strong>Call bar</strong> — once both are selected, tap <strong>Call Pitch</strong> to announce the call.<br>
                        <strong>Repeat</strong> — re-announces the last call.<br>
                        <strong>Clear</strong> — resets your selection.<br>
                        <strong>Pickoff / Pitchout</strong> — special calls that announce immediately.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help7">
                        <i class="bi bi-shuffle me-2 text-primary"></i> Why Use Shuffle?
                    </button>
                </h2>
                <div id="help7" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        The <strong>Shuffle</strong> button is one of PitchShuffle's most powerful features.
                        <br><br>
                        When you call pitches manually, patterns can emerge over time. Opposing coaches and baserunners may pick up on tendencies in your pitch selection.
                        <br><br>
                        <strong>Randomization eliminates that entirely.</strong> When pitches are called randomly, there is no pattern to find. The call is genuinely unpredictable, every single pitch.
                        <br><br>
                        Shuffle picks from the pitch types and locations you've enabled for that pitcher.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help8">
                        <i class="bi bi-shuffle me-2 text-primary"></i> Shuffle Settings
                    </button>
                </h2>
                <div id="help8" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        Shuffle Settings let you control how the <strong>Shuffle</strong> button picks pitches for each pitcher.
                        <br><br>
                        <strong>Strike %</strong> — controls how often Shuffle picks a strike zone location vs a chase location. 70% means 7 out of 10 shuffled pitches will be in the strike zone.
                        <br><br>
                        <strong>Pitch Frequency</strong> — controls how often each pitch type gets selected. A fastball set to 60% and a curveball at 40% means the fastball will be chosen roughly 60% of the time.
                        <br><br>
                        These settings are per-pitcher and can be adjusted mid-game from the <strong>Change Pitcher</strong> screen without interrupting play. A global default Strike % can be set on this Profile page and applies to any pitcher without a custom override.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help9">
                        <i class="bi bi-volume-up-fill me-2 text-primary"></i> Improving Voice Quality
                    </button>
                </h2>
                <div id="help9" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        PitchShuffle uses your device's built-in voices. The default voice may sound robotic — here's how to get a much more natural-sounding voice for free:
                        <br><br>
                        <strong>On iPhone or iPad:</strong>
                        <ol class="ps-3 mb-2">
                            <li class="mb-2">Go to <strong>Settings → Accessibility → Read & Speak → Voices</strong>.</li>
                            <li class="mb-2">Select <strong>English</strong> and choose any voice marked <strong>Enhanced</strong> or <strong>Premium</strong>.</li>
                            <li class="mb-2">Tap the download icon next to it. These are Siri-quality voices and sound significantly better.</li>
                            <li class="mb-2">Once downloaded, tap the voice name to select it as your active voice — a checkmark will appear. Then come back to PitchShuffle's <strong>Profile → Pitch Call Voice</strong> and select it from the dropdown.</li>
                        </ol>
                        <strong>On Android:</strong>
                        <ol class="ps-3 mb-0">
                            <li class="mb-2">Go to <strong>Settings → General Management → Text-to-Speech</strong>.</li>
                            <li class="mb-2">Tap the gear icon next to your TTS engine and select a higher quality voice.</li>
                            <li class="mb-2">Return to PitchShuffle and select it in <strong>Profile → Pitch Call Voice</strong>.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button"
                            data-bs-toggle="collapse" data-bs-target="#help10">
                        <i class="bi bi-lightning-fill me-2 text-primary"></i> Quick Game Mode
                    </button>
                </h2>
                <div id="help10" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                    <div class="accordion-body text-muted">
                        Quick Game lets you jump straight into calling pitches without setting up a team or pitcher first. It uses a standard set of pitch types and a full Zone C strike zone.
                        <br><br>
                        Quick Game is available from your Profile page when you don't have any pitchers set up yet.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
