<%- layout('layouts/boilerplate') %>

    <div class="page-header">
        <h1><i class="bi bi-box-arrow-in-right"></i> Login</h1>
    </div>

    <script>
    // Fallback error display for the native Google/Apple sign-in return
    // path — see the appUrlOpen listener in boilerplate.ejs. Independent
    // of server-side session flash, since this only needs the query param
    // that's already right here in the URL.
    (function () {
        var params = new URLSearchParams(window.location.search);
        var msg = params.get('oauthError');
        if (!msg) return;
        var container = document.querySelector('.container.mt-3');
        if (container) {
            var div = document.createElement('div');
            div.className = 'alert alert-danger alert-dismissible fade show';
            div.setAttribute('role', 'alert');
            div.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' +
                msg.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
            container.appendChild(div);
        }
        params.delete('oauthError');
        var newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
        window.history.replaceState({}, '', newUrl);
    })();
    </script>

    <div class="card">
        <div class="card-body p-4">
            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="username" class="form-label fw-600">Username</label>
                    <input type="text" class="form-control form-control-lg" id="username" name="username" required>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label fw-600">Password</label>
                    <input type="password" class="form-control form-control-lg" id="password" name="password" required>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </button>
                </div>
            </form>

            <!-- Google/Apple sign-in stay visible on native: they now only
                 log in existing accounts (new-account creation is blocked
                 server-side), which satisfies Apple Guideline 3.1.3(a)
                 while keeping login working for users who signed up on the
                 web with Google or Apple. -->
            <div id="ps-oauth-section">
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1">
                    <span class="px-3 text-muted small">or</span>
                    <hr class="flex-grow-1">
                </div>
                <div class="d-grid">
                    <a href="/auth/google" id="ps-google-signin" class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            <path fill="none" d="M0 0h48v48H0z"/>
                        </svg>
                        Sign in with Google
                    </a>
                </div>
                <div class="d-grid mt-2">
                    <a href="/auth/apple" id="ps-apple-signin" class="btn btn-dark btn-lg d-flex align-items-center justify-content-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 814 1000">
                            <path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-38.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.8 135.4-317.7 268.4-317.7 99.6 0 182.2 65.7 244.5 65.7 59.4 0 152.2-69.7 266.3-69.7 43.1 0 156.8 3.9 232.6 138.6zM549.8 119.7c25.8-30.7 44.5-73.6 44.5-116.5 0-5.8-.6-11.6-1.9-16.7-42.2 1.9-91.8 28.3-121.8 63.5-23.2 26.5-44.5 69.3-44.5 112.9 0 6.4.6 12.9 1.9 17.9 3.9.6 8.4 1.3 12.9 1.3 37.9 0 86.1-25.2 108.9-62.4z"/>
                        </svg>
                        Sign in with Apple
                    </a>
                </div>
                <p class="text-center text-muted small mt-2 mb-0 d-none" id="ps-oauth-native-note">
                    New here? Google and Apple sign-in above only work for accounts that already exist —
                    <a href="https://www.pitchshuffle.com/register" target="_blank" rel="noopener">create your account at pitchshuffle.com</a>
                    first (Google and Apple sign-in work there too), then come back and use the buttons above.
                </p>
            </div>

            <hr>
            <p class="text-center text-muted mb-0" id="ps-login-register-link">
                Don't have an account? <a href="/register">Register here</a>
            </p>
            <script>
            (function () {
                var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
                if (isNative) {
                    var el = document.getElementById('ps-login-register-link');
                    if (el) el.style.display = 'none';

                    var noteEl = document.getElementById('ps-oauth-native-note');
                    if (noteEl) noteEl.classList.remove('d-none');

                    // Google/Apple's OAuth screens refuse to load inside our
                    // embedded webview and, left to a plain link, get handed
                    // off to the system default browser as a full app
                    // switch with no way back. Open them in Capacitor's
                    // in-app browser (an SFSafariViewController sheet)
                    // instead, which stays visually inside the app and
                    // shares cookies with our WebView, so a successful
                    // login is actually visible here afterward. The server
                    // redirects back to the pitchshuffle:// URL scheme when
                    // it's done (see the appUrlOpen listener below), which
                    // closes the sheet and returns control to the app.
                    ['ps-google-signin', 'ps-apple-signin'].forEach(function (id) {
                        var link = document.getElementById(id);
                        if (!link) return;
                        link.addEventListener('click', function (e) {
                            e.preventDefault();
                            var url = link.href + (link.href.indexOf('?') === -1 ? '?' : '&') + 'native=1';
                            // Look up the plugin fresh on every click rather than
                            // capturing it once at page-load time — capturing it
                            // early risks a race where Capacitor's plugin bridge
                            // isn't fully ready yet, which silently and
                            // permanently breaks the in-app sheet for that page
                            // load (falls back to a full external browser switch
                            // with no way back).
                            var Browser = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Browser;
                            if (Browser) {
                                Browser.open({ url: url });
                            } else {
                                // Last-resort fallback: still tag the request as
                                // native so the server correctly blocks new-account
                                // creation and redirects via pitchshuffle:// rather
                                // than a plain https URL, even though this path
                                // hands off to the full system browser instead of
                                // an in-app sheet.
                                window.location.href = url;
                            }
                        });
                    });
                }
            })();
            </script>
        </div>
    </div>
