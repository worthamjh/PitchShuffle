<%- layout('layouts/boilerplate') %>

    <div class="page-header">
        <h1><i class="bi bi-person-plus"></i> Create Account</h1>
    </div>

    <!-- iOS: registration not available in native app — sign up on the web -->
    <div id="ps-ios-register-message" style="display:none;">
        <div class="card">
            <div class="card-body p-4 text-center">
                <i class="bi bi-globe2" style="font-size:2.5rem;opacity:0.4;"></i>
                <h5 class="mt-3 fw-bold">Sign up on the web</h5>
                <p class="text-muted mb-4">
                    New accounts are created at
                    <strong>pitchshuffle.com</strong> from any browser.
                    Once you have an account, log in here.
                </p>
                <a href="/login" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                </a>
            </div>
        </div>
    </div>

    <div id="ps-register-card">
        <div class="card">
            <div class="card-body p-4">

                <div id="ps-oauth-section">
                    <div class="d-grid mb-3">
                        <a href="/auth/google" class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                <path fill="none" d="M0 0h48v48H0z"/>
                            </svg>
                            Sign up with Google
                        </a>
                    </div>

                    <p class="text-center text-muted small mb-3">
                        By signing up you agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.
                    </p>

                    <div class="d-flex align-items-center mb-3">
                        <hr class="flex-grow-1">
                        <span class="px-3 text-muted small">or sign up with email</span>
                        <hr class="flex-grow-1">
                    </div>
                </div>

                <script>
                (function () {
                    var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
                    if (isNative) {
                        var el = document.getElementById('ps-oauth-section');
                        if (el) el.style.display = 'none';
                    }
                })();
                </script>

                <form action="/register" method="POST">
                    <div class="mb-3">
                        <label for="username" class="form-label fw-600">Username</label>
                        <input type="text" class="form-control form-control-lg" id="username" name="username" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label fw-600">Email</label>
                        <input type="email" class="form-control form-control-lg" id="email" name="email" required>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label fw-600">Password</label>
                        <input type="password" class="form-control form-control-lg" id="password" name="password" required>
                    </div>

                    <!-- Zone Terminology Preference -->
                    <div class="mb-4">
                        <label class="form-label fw-600">Strike Zone Terminology</label>
                        <p class="text-muted small mb-3">
                            Choose how pitch locations are labeled in the strike zone. You can change this later in your profile settings.
                        </p>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <input type="radio" class="btn-check" name="zoneTerminology" id="termArmGlove"
                                       value="arm-glove" checked>
                                <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3"
                                       for="termArmGlove">
                                    <img src="/images/pitcher-image.svg" alt="Arm Side / Glove Side" style="width:90px;height:90px;object-fit:contain;margin-bottom:0.25rem;">
                                    <span class="fw-bold">Arm Side / Glove Side</span>
                                    <small class="text-muted mt-1 text-center">
                                        Relative to the pitcher's throwing hand. Zone mirrors for left- vs right-handed pitchers.
                                    </small>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <input type="radio" class="btn-check" name="zoneTerminology" id="termInsideAway"
                                       value="inside-away">
                                <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3"
                                       for="termInsideAway">
                                    <img src="/images/batter-image.svg" alt="Inside / Away" style="width:90px;height:90px;object-fit:contain;margin-bottom:0.25rem;">
                                    <span class="fw-bold">Inside / Away</span>
                                    <small class="text-muted mt-1 text-center">
                                        Relative to the batter. Fixed layout regardless of pitcher handedness.
                                    </small>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" name="agreeTerms" required>
                            <label class="form-check-label small text-muted" for="agreeTerms">
                                I agree to the <a href="/terms" target="_blank">Terms of Service</a> and <a href="/privacy" target="_blank">Privacy Policy</a>
                            </label>
                        </div>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-person-check"></i> Create Account
                        </button>
                    </div>
                </form>
                <hr>
                <p class="text-center text-muted mb-0">
                    Already have an account? <a href="/login">Login here</a>
                </p>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
        if (isNative) {
            document.getElementById('ps-register-card').style.display = 'none';
            document.getElementById('ps-ios-register-message').style.display = '';
        }
    })();
    </script>
