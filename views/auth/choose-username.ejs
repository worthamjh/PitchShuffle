<%- layout('layouts/boilerplate') %>

<div class="page-header">
    <h1><i class="bi bi-person-check"></i> Choose a Username</h1>
</div>

<div class="card">
    <div class="card-body p-4">
        <p class="text-muted mb-4">Pick a username for your PitchShuffle account. You can change this later in your profile settings.</p>
        <!-- data-turbo="false": on native this POST redirects to the pitchshuffle:// scheme to hand control back to the app. Turbo submits forms via fetch, which cannot follow a custom-scheme redirect, so force a full-page submission here. -->
        <form action="/auth/choose-username" method="POST" id="chooseUsernameForm" data-turbo="false">
            <div class="mb-4">
                <label for="username" class="form-label fw-bold">Username</label>
                <input type="text" class="form-control form-control-lg" id="username" name="username"
                    value="<%= suggested %>" required minlength="3" maxlength="30"
                    placeholder="e.g. coach_jay" autocomplete="off" autocapitalize="off">
                <div class="form-text">3–30 characters. Letters, numbers, and underscores.</div>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check-circle"></i> Continue
                </button>
            </div>
        </form>
    </div>
</div>