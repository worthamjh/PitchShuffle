{
  "appId": "com.pitchshuffle.app",
  "appName": "PitchShuffle",
  "webDir": "www",
  "backgroundColor": "#1a2e4a",
  "server": {
    "url": "https://www.pitchshuffle.com",
    "cleartext": false
  },
  "ios": {
    "appendUserAgent": "PitchShuffleNativeApp"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#1a2e4a",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}